context SupplyOrder as flow is {

  inlet Failures is record Riddl.GeneratorError with {
    option error-sink
    briefly as "Where hard errors go"
    described as {
      |RIDDL 2.0 wants every domain to name a destination for failures no
      |handler can recover from. An error-sink inlet is infrastructure
      |rather than dataflow, so it does not count toward this processor's
      |arity.
    }
  }

  inlet SupplyIn is command BackOffice.SupplyOrder.Supply.OrderSupply with {
    briefly as "Where supply commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet SupplyDispatch is command BackOffice.SupplyOrder.Supply.OrderSupply with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler SupplyOrderBoundary is {
    on request: command BackOffice.SupplyOrder.Supply.OrderSupply {
      send request to outlet BackOffice.SupplyOrder.SupplyDispatch
    }
    on other {
      error "unexpected message at the SupplyOrder boundary"
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type SupplyId is Id(BackOffice.SupplyOrder.Supply) with {
    briefly as "Unique identifier for one supply"
    described as {
      |Defined inside SupplyOrder because supply identity is this context's concern.
    }
  }

  entity Supply as flow is {

    inlet SupplyCommands is command BackOffice.SupplyOrder.Supply.OrderSupply with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet SupplyEvents is event BackOffice.SupplyOrder.Supply.SupplyOrdered with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command OrderSupply is {
      supplyId is Id(Supply),
      item is String,
      quantity is Integer,
      plannedAs is BackOffice.MenuPlant.PlantSchedule
    } with {
      briefly as "Ask for a supply to be recorded"
      described as {
        |Sent when a restaurant ordered stock from a warehouse.
      }
    }

    query WhichSupply replies result TheSupply is {
      supplyId is BackOffice.SupplyOrder.SupplyId
    } with {
      briefly as "Ask for the current state of one supply"
      described as {
        |Sent when a reader wants a supply they already know of.
      }
    }

    result TheSupply is {
      supplyId is BackOffice.SupplyOrder.SupplyId,
      summary is String
    } with {
      briefly as "The answer to a WhichSupply query"
      described as {
        |Carries the identity and a short summary of the supply.
      }
    }

    event SupplyOrdered is {
      supplyId is BackOffice.SupplyOrder.SupplyId
    } with {
      briefly as "Records that a restaurant ordered stock from a warehouse"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record SupplyFields is {
      supplyId is BackOffice.SupplyOrder.SupplyId,
      item is String,
      quantity is Integer
    } with {
      briefly as "Everything Reactive BBQ keeps about one supply"
      described as {
        |The stored shape of a supply.
      }
    }

    initial state SupplyState of record BackOffice.SupplyOrder.Supply.SupplyFields with {
      briefly as "The state of one supply"
      described as {
        |A supply has a single state; its fields change but its kind does not.
      }
    }

    handler SupplyHandler is {
      on init {
        set field BackOffice.SupplyOrder.Supply.SupplyFields.supplyId to "a freshly minted identifier"
      }
      on command OrderSupply {
        morph entity Supply to state SupplyState with record BackOffice.SupplyOrder.Supply.SupplyFields(
          supplyId = prompt("the supplyId of the resulting Supply state"),
          item = prompt("the item of the resulting Supply state"),
          quantity = prompt("the quantity of the resulting Supply state")
        )
        send event SupplyOrdered(
          supplyId = prompt("the supplyId carried by SupplyOrdered")
        ) to outlet BackOffice.SupplyOrder.Supply.SupplyEvents
      }
      on query WhichSupply {
        reply result TheSupply(
          supplyId = prompt("the supplyId carried by TheSupply"),
          summary = prompt("the summary carried by TheSupply")
        )
      }
    } with {
      briefly as "Handles messages addressed to a supply"
      described as {
        |Records supplys and answers questions about them.
      }
    }

  } with {
    briefly as "A single supply at Reactive BBQ"
    described as {
      |The entity that remembers that a restaurant ordered stock from a warehouse.
    }
  }



  repository SupplyStore as sink is {
    command PersistSupplyOrdered is {
      supplyId is BackOffice.SupplyOrder.SupplyId
    } with {
      briefly as "Apply SupplyOrdered to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no
        |`yields` because storing a row records no new entity state. A
        |repository is changed by commands and read by queries, never by
        |events.
      }
    }

    inlet Recorded is command BackOffice.SupplyOrder.SupplyStore.PersistSupplyOrdered with {
      briefly as "Where supply persistence commands arrive"
      described as {
        |A projector turns each supply event into one of these.
      }
    }
    schema SupplySchema is flat
      of Held as record BackOffice.SupplyOrder.SupplyProjection.Projected
    with {
      briefly as "How supplys are laid out in storage"
      described as {
        |A flat schema: one stored row per supply.
      }
    }
    handler SupplyStoreHandler is {
      on command BackOffice.SupplyOrder.SupplyStore.PersistSupplyOrdered {
        do "apply what the command carries to the stored row"
      }
    } with {
      briefly as "Keeps supply storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the supplys of this context"
    described as {
      |Entities are stateful, so SupplyOrder keeps a repository.
    }
  }

  connector ErrorReportingBackOffice is {
    from outlet Riddl.ForeverEmpty.void to inlet BackOffice.SupplyOrder.Failures
  } with {
    briefly as "Terminates the error-sink inlet"
    described as {
      |Nothing in this model produces a GeneratorError — those come from
      |generators at runtime, not from anything the model declares. The
      |predefined ForeverEmpty source exists for exactly this: a port that
      |must be connected but has no modelled producer.
    }
  }

  connector AddressingSupply is {
    from outlet BackOffice.SupplyOrder.SupplyDispatch to inlet BackOffice.SupplyOrder.Supply.SupplyCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

projector SupplyProjection as flow is {
  inlet Observed is event BackOffice.SupplyOrder.Supply.SupplyOrdered with {
    briefly as "Where supply events are observed"
    described as {
      |The projector sees what the entity announced.
    }
  }

  outlet Persisting is command BackOffice.SupplyOrder.SupplyStore.PersistSupplyOrdered with {
    briefly as "Where persistence commands leave for the store"
    described as {
      |Turning the event into a command is the projector's whole job.
    }
  }

  updates repository BackOffice.SupplyOrder.SupplyStore

  record Projected is {
    supplyId is BackOffice.SupplyOrder.SupplyId
  } with {
    briefly as "The shape this projection maintains"
    described as {
      |One projected row per supply, keyed by its identifier. The store holds
      |exactly this.
    }
  }

  handler SupplyProjectionHandler is {
    on supplyOrdered: event BackOffice.SupplyOrder.Supply.SupplyOrdered {
      tell command BackOffice.SupplyOrder.SupplyStore.PersistSupplyOrdered(
        supplyId = supplyOrdered.supplyId
      ) to repository BackOffice.SupplyOrder.SupplyStore
    }
  } with {
    briefly as "Turns supply events into persistence commands"
    described as {
      |A repository is changed by commands, so something must translate.
    }
  }
} with {
  briefly as "Projects supply events into the store"
  described as {
    |Stands between what the entity announced and what the store is told.
  }
}

  connector ObservingSupply is {
    from outlet BackOffice.SupplyOrder.Supply.SupplyEvents to inlet BackOffice.SupplyOrder.SupplyProjection.Observed
  } with {
    briefly as "Carries supply events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector RecordingSupply is {
    from outlet BackOffice.SupplyOrder.SupplyProjection.Persisting to inlet SupplyStore.Recorded
  } with {
    briefly as "Carries supply events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns what restaurants order from the warehouses"
  described as {
    |This context represents the orders that restaurants make to the back
    |office warehouses for their food supplies.
  }
}
