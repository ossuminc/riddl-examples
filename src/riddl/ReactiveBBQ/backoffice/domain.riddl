domain BackOffice is {

  include "SupplyOrder"
  include "MenuPlant"

  context BackOfficeFrontEnd as flow is {

    inlet SupplyStaged is command BackOffice.SupplyOrder.Supply.OrderSupply with {
      briefly as "Where the front end's supply requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet SupplySubmissions is command BackOffice.SupplyOrder.Supply.OrderSupply with {
      briefly as "Where supply requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    connector StagingSupply is {
      from outlet BackOffice.BackOfficeFrontEnd.SupplyRequests.Staged to inlet BackOffice.BackOfficeFrontEnd.SupplyStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    handler BackOfficeFrontEndBoundary is {
      on orderSupply: command BackOffice.SupplyOrder.Supply.OrderSupply {
        send orderSupply to outlet BackOffice.BackOfficeFrontEnd.SupplySubmissions
      }
    } with {
      briefly as "Republishes staged requests on the context's own outlets"
      described as {
        |The front end's internals stay private; peers see only these outlets.
      }
    }

    processor SupplyRequests as source is {
      outlet Staged is command BackOffice.SupplyOrder.Supply.OrderSupply with {
        briefly as "Where supply requests leave the front end"
        described as {
          |Requests reach the SupplyOrder context over a domain-scoped connector.
        }
      }
      handler SupplyRequestsHandler is {
        on command BackOffice.SupplyOrder.Supply.OrderSupply {
          send command BackOffice.SupplyOrder.Supply.OrderSupply(
            supplyId = prompt("the supplyId carried by OrderSupply"),
            item = prompt("the item carried by OrderSupply"),
            quantity = prompt("the quantity carried by OrderSupply"),
            plannedAs = prompt("the plant schedule line this order fulfils")
          ) to outlet BackOffice.BackOfficeFrontEnd.SupplyRequests.Staged
        }
        on other {
          do "ignore requests that are not about supplys"
        }
      } with {
        briefly as "Forwards supply requests into the domain"
        described as {
          |Runs when a caller asks for a supply change.
        }
      }
    } with {
      briefly as "The front end's outbound path to SupplyOrder"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

  } with {
    briefly as "Where restaurants reach the back office"
    described as {
      |Restaurants place supply orders through systems outside this model.
      |This context stands in for that boundary.
    }
  }

  persistent connector SupplyRequests is {
    from outlet BackOffice.BackOfficeFrontEnd.SupplySubmissions
    to inlet BackOffice.SupplyOrder.SupplyIn
  } with {
    briefly as "Carries supply requests from the front end to SupplyOrder"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

} with {
  briefly as "The warehouses and plants behind the restaurants"
  described as {
    |The back office keeps the restaurants supplied: it takes their orders
    |for stock and runs the plant that prepares menu items centrally.
  }
}
