context Marketing as flow is {

  inlet Failures is record Riddl.GeneratorError with {
    option error-sink
    briefly as "Where hard errors go"
    described as {
      |RIDDL 2.0 wants every domain to name a destination for failures no
      |handler can recover from. An error-sink inlet is infrastructure
      |rather than dataflow, so it does not count toward this processor's
      |arity.
    }
  }

  inlet CampaignIn is command Corporate.Marketing.Campaign.LaunchCampaign with {
    briefly as "Where campaign commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet CampaignDispatch is command Corporate.Marketing.Campaign.LaunchCampaign with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler MarketingBoundary is {
    on request: command Corporate.Marketing.Campaign.LaunchCampaign {
      send request to outlet Corporate.Marketing.CampaignDispatch
    }
    on other {
      error "unexpected message at the Marketing boundary"
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type CampaignId is Id(Corporate.Marketing.Campaign) with {
    briefly as "Unique identifier for one campaign"
    described as {
      |Defined inside Marketing because campaign identity is this context's concern.
    }
  }

  entity Campaign as flow is {

    inlet CampaignCommands is command Corporate.Marketing.Campaign.LaunchCampaign with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet CampaignEvents is event Corporate.Marketing.Campaign.CampaignLaunched with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command LaunchCampaign is {
      campaignId is Id(Campaign),
      title is String,
      budget is Number
    } with {
      briefly as "Ask for a campaign to be recorded"
      described as {
        |Sent when a marketing campaign was launched.
      }
    }

    query WhichCampaign replies result TheCampaign is {
      campaignId is Corporate.Marketing.CampaignId
    } with {
      briefly as "Ask for the current state of one campaign"
      described as {
        |Sent when a reader wants a campaign they already know of.
      }
    }

    result TheCampaign is {
      campaignId is Corporate.Marketing.CampaignId,
      summary is String
    } with {
      briefly as "The answer to a WhichCampaign query"
      described as {
        |Carries the identity and a short summary of the campaign.
      }
    }

    event CampaignLaunched is {
      campaignId is Corporate.Marketing.CampaignId
    } with {
      briefly as "Records that a marketing campaign was launched"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record CampaignFields is {
      campaignId is Corporate.Marketing.CampaignId,
      title is String,
      budget is Number
    } with {
      briefly as "Everything Reactive BBQ keeps about one campaign"
      described as {
        |The stored shape of a campaign.
      }
    }

    initial state CampaignState of record Corporate.Marketing.Campaign.CampaignFields with {
      briefly as "The state of one campaign"
      described as {
        |A campaign has a single state; its fields change but its kind does not.
      }
    }

    handler CampaignHandler is {
      on init {
        set field Corporate.Marketing.Campaign.CampaignFields.campaignId to "a freshly minted identifier"
      }
      on command LaunchCampaign {
        morph entity Campaign to state CampaignState with record Corporate.Marketing.Campaign.CampaignFields(
          campaignId = prompt("the campaignId of the resulting Campaign state"),
          title = prompt("the title of the resulting Campaign state"),
          budget = prompt("the budget of the resulting Campaign state")
        )
        send event CampaignLaunched(
          campaignId = prompt("the campaignId carried by CampaignLaunched")
        ) to outlet Corporate.Marketing.Campaign.CampaignEvents
      }
      on query WhichCampaign {
        reply result TheCampaign(
          campaignId = prompt("the campaignId carried by TheCampaign"),
          summary = prompt("the summary carried by TheCampaign")
        )
      }
    } with {
      briefly as "Handles messages addressed to a campaign"
      described as {
        |Records campaigns and answers questions about them.
      }
    }

  } with {
    briefly as "A single campaign at Reactive BBQ"
    described as {
      |The entity that remembers that a marketing campaign was launched.
    }
  }



  repository CampaignStore as sink is {
    command PersistCampaignLaunched is {
      campaignId is Corporate.Marketing.CampaignId
    } with {
      briefly as "Apply CampaignLaunched to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no
        |`yields` because storing a row records no new entity state. A
        |repository is changed by commands and read by queries, never by
        |events.
      }
    }

    inlet Recorded is command Corporate.Marketing.CampaignStore.PersistCampaignLaunched with {
      briefly as "Where campaign persistence commands arrive"
      described as {
        |A projector turns each campaign event into one of these.
      }
    }
    schema CampaignSchema is flat
      of Held as record Corporate.Marketing.CampaignProjection.Projected
    with {
      briefly as "How campaigns are laid out in storage"
      described as {
        |A flat schema: one stored row per campaign.
      }
    }
    handler CampaignStoreHandler is {
      on command Corporate.Marketing.CampaignStore.PersistCampaignLaunched {
        do "apply what the command carries to the stored row"
      }
    } with {
      briefly as "Keeps campaign storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the campaigns of this context"
    described as {
      |Entities are stateful, so Marketing keeps a repository.
    }
  }

  connector ErrorReportingCorporate is {
    from outlet Riddl.ForeverEmpty.void to inlet Corporate.Marketing.Failures
  } with {
    briefly as "Terminates the error-sink inlet"
    described as {
      |Nothing in this model produces a GeneratorError — those come from
      |generators at runtime, not from anything the model declares. The
      |predefined ForeverEmpty source exists for exactly this: a port that
      |must be connected but has no modelled producer.
    }
  }

  connector AddressingCampaign is {
    from outlet Corporate.Marketing.CampaignDispatch to inlet Corporate.Marketing.Campaign.CampaignCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

projector CampaignProjection as flow is {
  inlet Observed is event Corporate.Marketing.Campaign.CampaignLaunched with {
    briefly as "Where campaign events are observed"
    described as {
      |The projector sees what the entity announced.
    }
  }

  outlet Persisting is command Corporate.Marketing.CampaignStore.PersistCampaignLaunched with {
    briefly as "Where persistence commands leave for the store"
    described as {
      |Turning the event into a command is the projector's whole job.
    }
  }

  updates repository Corporate.Marketing.CampaignStore

  record Projected is {
    campaignId is Corporate.Marketing.CampaignId
  } with {
    briefly as "The shape this projection maintains"
    described as {
      |One projected row per campaign, keyed by its identifier. The store holds
      |exactly this.
    }
  }

  handler CampaignProjectionHandler is {
    on campaignLaunched: event Corporate.Marketing.Campaign.CampaignLaunched {
      tell command Corporate.Marketing.CampaignStore.PersistCampaignLaunched(
        campaignId = campaignLaunched.campaignId
      ) to repository Corporate.Marketing.CampaignStore
    }
  } with {
    briefly as "Turns campaign events into persistence commands"
    described as {
      |A repository is changed by commands, so something must translate.
    }
  }
} with {
  briefly as "Projects campaign events into the store"
  described as {
    |Stands between what the entity announced and what the store is told.
  }
}

  connector ObservingCampaign is {
    from outlet Corporate.Marketing.Campaign.CampaignEvents to inlet Corporate.Marketing.CampaignProjection.Observed
  } with {
    briefly as "Carries campaign events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector RecordingCampaign is {
    from outlet Corporate.Marketing.CampaignProjection.Persisting to inlet CampaignStore.Recorded
  } with {
    briefly as "Carries campaign events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns campaigns run on behalf of the chain"
  described as {
    |The Marketing context holds the campaigns corporate runs to bring
    |diners into the restaurants.
  }
}
