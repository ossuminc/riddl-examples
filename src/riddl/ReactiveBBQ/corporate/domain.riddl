domain Corporate is {

  include "Marketing"

  context CorporateFrontEnd as flow is {

    inlet CampaignStaged is command Corporate.Marketing.Campaign.LaunchCampaign with {
      briefly as "Where the front end's campaign requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet CampaignSubmissions is command Corporate.Marketing.Campaign.LaunchCampaign with {
      briefly as "Where campaign requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    connector StagingCampaign is {
      from outlet Corporate.CorporateFrontEnd.CampaignRequests.Staged to inlet Corporate.CorporateFrontEnd.CampaignStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    handler CorporateFrontEndBoundary is {
      on launchCampaign: command Corporate.Marketing.Campaign.LaunchCampaign {
        send launchCampaign to outlet Corporate.CorporateFrontEnd.CampaignSubmissions
      }
    } with {
      briefly as "Republishes staged requests on the context's own outlets"
      described as {
        |The front end's internals stay private; peers see only these outlets.
      }
    }

    processor CampaignRequests as source is {
      outlet Staged is command Corporate.Marketing.Campaign.LaunchCampaign with {
        briefly as "Where campaign requests leave the front end"
        described as {
          |Requests reach the Marketing context over a domain-scoped connector.
        }
      }
      handler CampaignRequestsHandler is {
        on command Corporate.Marketing.Campaign.LaunchCampaign {
          send command Corporate.Marketing.Campaign.LaunchCampaign(
            campaignId = prompt("the campaignId carried by LaunchCampaign"),
            title = prompt("the title carried by LaunchCampaign"),
            budget = prompt("the budget carried by LaunchCampaign")
          ) to outlet Corporate.CorporateFrontEnd.CampaignRequests.Staged
        }
        on other {
          do "ignore requests that are not about campaigns"
        }
      } with {
        briefly as "Forwards campaign requests into the domain"
        described as {
          |Runs when a caller asks for a campaign change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Marketing"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

  } with {
    briefly as "Where corporate staff reach the marketing systems"
    described as {
      |Campaign tooling sits outside this model. This context stands in for
      |that boundary.
    }
  }

  persistent connector CampaignRequests is {
    from outlet Corporate.CorporateFrontEnd.CampaignSubmissions
    to inlet Corporate.Marketing.CampaignIn
  } with {
    briefly as "Carries campaign requests from the front end to Marketing"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

} with {
  briefly as "The chain's head office"
  described as {
    |Corporate handles the web site, marketing, accounting and HR for the
    |chain as a whole rather than for any one restaurant.
  }
}
