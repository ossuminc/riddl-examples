context Kitchen as flow is {

  inlet OrderViewerIn is command Restaurant.Kitchen.OrderViewer.ShowOrders with {
    briefly as "Where orderviewer commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet OrderViewerDispatch is command Restaurant.Kitchen.OrderViewer.ShowOrders with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler KitchenBoundary is {
    on request: command Restaurant.Kitchen.OrderViewer.ShowOrders {
      send request to outlet Restaurant.Kitchen.OrderViewerDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type OrderViewerId is Id(Restaurant.Kitchen.OrderViewer) with {
    briefly as "Unique identifier for one orderviewer"
    described as {
      |Defined inside Kitchen because orderviewer identity is this context's concern.
    }
  }

  entity OrderViewer as flow is {

    inlet OrderViewerCommands is command Restaurant.Kitchen.OrderViewer.ShowOrders with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet OrderViewerEvents is event Restaurant.Kitchen.OrderViewer.OrdersShown with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command ShowOrders is {
      orderViewerId is Id(OrderViewer),
      viewType is String,
      station is String
    } with {
      briefly as "Ask for a orderviewer to be recorded"
      described as {
        |Sent when the kitchen display was refreshed.
      }
    }

    query WhichOrderViewer replies result TheOrderViewer is {
      orderViewerId is Restaurant.Kitchen.OrderViewerId
    } with {
      briefly as "Ask for the current state of one orderviewer"
      described as {
        |Sent when a reader wants a orderviewer they already know of.
      }
    }

    result TheOrderViewer is {
      orderViewerId is Restaurant.Kitchen.OrderViewerId,
      summary is String
    } with {
      briefly as "The answer to a WhichOrderViewer query"
      described as {
        |Carries the identity and a short summary of the orderviewer.
      }
    }

    event OrdersShown is {
      orderViewerId is Restaurant.Kitchen.OrderViewerId
    } with {
      briefly as "Records that the kitchen display was refreshed"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record OrderViewerFields is {
      orderViewerId is Restaurant.Kitchen.OrderViewerId,
      viewType is String,
      station is String
    } with {
      briefly as "Everything Reactive BBQ keeps about one orderviewer"
      described as {
        |The stored shape of a orderviewer.
      }
    }

    initial state OrderViewerState of record Restaurant.Kitchen.OrderViewer.OrderViewerFields with {
      briefly as "The state of one orderviewer"
      described as {
        |A orderviewer has a single state; its fields change but its kind does not.
      }
    }

    handler OrderViewerHandler is {
      on init {
        set field Restaurant.Kitchen.OrderViewer.OrderViewerFields.orderViewerId to "a freshly minted identifier"
      }
      on command ShowOrders {
        morph entity OrderViewer to state OrderViewerState with record Restaurant.Kitchen.OrderViewer.OrderViewerFields(
          orderViewerId = prompt("the orderViewerId of the resulting OrderViewer state"),
          viewType = prompt("the viewType of the resulting OrderViewer state"),
          station = prompt("the station of the resulting OrderViewer state")
        )
        send event OrdersShown(
          orderViewerId = prompt("the orderViewerId carried by OrdersShown")
        ) to outlet Restaurant.Kitchen.OrderViewer.OrderViewerEvents
      }
      on query WhichOrderViewer {
        reply result TheOrderViewer(
          orderViewerId = prompt("the orderViewerId carried by TheOrderViewer"),
          summary = prompt("the summary carried by TheOrderViewer")
        )
      }
    } with {
      briefly as "Handles messages addressed to a orderviewer"
      described as {
        |Records orderviewers and answers questions about them.
      }
    }

  } with {
    briefly as "A single orderviewer at Reactive BBQ"
    described as {
      |The entity that remembers that the kitchen display was refreshed.
    }
  }



  repository OrderViewerStore as sink is {
    command PersistOrdersShown is {
      orderViewerId is Restaurant.Kitchen.OrderViewerId
    } with {
      briefly as "Apply OrdersShown to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no
        |`yields` because storing a row records no new entity state. A
        |repository is changed by commands and read by queries, never by
        |events.
      }
    }

    inlet Recorded is command Restaurant.Kitchen.OrderViewerStore.PersistOrdersShown with {
      briefly as "Where order viewer persistence commands arrive"
      described as {
        |A projector turns each order viewer event into one of these.
      }
    }
    schema OrderViewerSchema is flat
      of Held as record Restaurant.Kitchen.OrderViewerProjection.Projected
    with {
      briefly as "How orderviewers are laid out in storage"
      described as {
        |A flat schema: one stored row per orderviewer.
      }
    }
    handler OrderViewerStoreHandler is {
      on command Restaurant.Kitchen.OrderViewerStore.PersistOrdersShown {
        do "apply what the command carries to the stored row"
      }
    } with {
      briefly as "Keeps orderviewer storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the orderviewers of this context"
    described as {
      |Entities are stateful, so Kitchen keeps a repository.
    }
  }

  connector AddressingOrderViewer is {
    from outlet Restaurant.Kitchen.OrderViewerDispatch to inlet Restaurant.Kitchen.OrderViewer.OrderViewerCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

projector OrderViewerProjection as flow is {
  inlet Observed is event Restaurant.Kitchen.OrderViewer.OrdersShown with {
    briefly as "Where order viewer events are observed"
    described as {
      |The projector sees what the entity announced.
    }
  }

  outlet Persisting is command Restaurant.Kitchen.OrderViewerStore.PersistOrdersShown with {
    briefly as "Where persistence commands leave for the store"
    described as {
      |Turning the event into a command is the projector's whole job.
    }
  }

  updates repository Restaurant.Kitchen.OrderViewerStore

  record Projected is {
    orderViewerId is Restaurant.Kitchen.OrderViewerId
  } with {
    briefly as "The shape this projection maintains"
    described as {
      |One projected row per order viewer, keyed by its identifier. The store holds
      |exactly this.
    }
  }

  handler OrderViewerProjectionHandler is {
    on ordersShown: event Restaurant.Kitchen.OrderViewer.OrdersShown {
      tell command Restaurant.Kitchen.OrderViewerStore.PersistOrdersShown(
        orderViewerId = ordersShown.orderViewerId
      ) to repository Restaurant.Kitchen.OrderViewerStore
    }
  } with {
    briefly as "Turns order viewer events into persistence commands"
    described as {
      |A repository is changed by commands, so something must translate.
    }
  }
} with {
  briefly as "Projects order viewer events into the store"
  described as {
    |Stands between what the entity announced and what the store is told.
  }
}

  connector ObservingOrderViewer is {
    from outlet Restaurant.Kitchen.OrderViewer.OrderViewerEvents to inlet Restaurant.Kitchen.OrderViewerProjection.Observed
  } with {
    briefly as "Carries order viewer events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector RecordingOrderViewer is {
    from outlet Restaurant.Kitchen.OrderViewerProjection.Persisting to inlet OrderViewerStore.Recorded
  } with {
    briefly as "Carries orderviewer events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns the cooks' view of outstanding orders"
  described as {
    |The kitchen is a client of the Orders context and interacts with that
    |context alone for the outstanding orders to be prepared. Everything
    |else that happens in the kitchen is out of scope for the restaurant
    |automation software, so this context is deliberately minimal.
  }
}
