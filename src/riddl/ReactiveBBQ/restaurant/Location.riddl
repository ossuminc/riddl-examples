context Locations as flow is {

  inlet LocationIn is command Restaurant.Locations.Location.OpenLocation with {
    briefly as "Where location commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet LocationDispatch is command Restaurant.Locations.Location.OpenLocation with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler LocationsBoundary is {
    on request: command Restaurant.Locations.Location.OpenLocation {
      send request to outlet Restaurant.Locations.LocationDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type LocationId is Id(Restaurant.Locations.Location) with {
    briefly as "Unique identifier for one location"
    described as {
      |Defined inside Locations because location identity is this context's concern.
    }
  }

  entity Location as flow is {

    inlet LocationCommands is command Restaurant.Locations.Location.OpenLocation with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet LocationEvents is event Restaurant.Locations.Location.LocationOpened with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command OpenLocation is {
      locationId is Id(Location),
      name is String,
      city is String
    } with {
      briefly as "Ask for a location to be recorded"
      described as {
        |Sent when a restaurant location opened.
      }
    }

    query WhichLocation replies result TheLocation is {
      locationId is Restaurant.Locations.LocationId
    } with {
      briefly as "Ask for the current state of one location"
      described as {
        |Sent when a reader wants a location they already know of.
      }
    }

    result TheLocation is {
      locationId is Restaurant.Locations.LocationId,
      summary is String
    } with {
      briefly as "The answer to a WhichLocation query"
      described as {
        |Carries the identity and a short summary of the location.
      }
    }

    event LocationOpened is {
      locationId is Restaurant.Locations.LocationId
    } with {
      briefly as "Records that a restaurant location opened"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record LocationFields is {
      locationId is Restaurant.Locations.LocationId,
      name is String,
      city is String
    } with {
      briefly as "Everything Reactive BBQ keeps about one location"
      described as {
        |The stored shape of a location.
      }
    }

    initial state LocationState of record Restaurant.Locations.Location.LocationFields with {
      briefly as "The state of one location"
      described as {
        |A location has a single state; its fields change but its kind does not.
      }
    }

    handler LocationHandler is {
      on init {
        set field Restaurant.Locations.Location.LocationFields.locationId to "a freshly minted identifier"
      }
      on command OpenLocation {
        morph entity Location to state LocationState with record Restaurant.Locations.Location.LocationFields(
          locationId = prompt("the locationId of the resulting Location state"),
          name = prompt("the name of the resulting Location state"),
          city = prompt("the city of the resulting Location state")
        )
        send event LocationOpened(
          locationId = prompt("the locationId carried by LocationOpened")
        ) to outlet Restaurant.Locations.Location.LocationEvents
      }
      on query WhichLocation {
        reply result TheLocation(
          locationId = prompt("the locationId carried by TheLocation"),
          summary = prompt("the summary carried by TheLocation")
        )
      }
    } with {
      briefly as "Handles messages addressed to a location"
      described as {
        |Records locations and answers questions about them.
      }
    }

  } with {
    briefly as "A single location at Reactive BBQ"
    described as {
      |The entity that remembers that a restaurant location opened.
    }
  }



  repository LocationStore as sink is {
    command PersistLocationOpened is {
      locationId is Restaurant.Locations.LocationId
    } with {
      briefly as "Apply LocationOpened to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no
        |`yields` because storing a row records no new entity state. A
        |repository is changed by commands and read by queries, never by
        |events.
      }
    }

    inlet Recorded is command Restaurant.Locations.LocationStore.PersistLocationOpened with {
      briefly as "Where location persistence commands arrive"
      described as {
        |A projector turns each location event into one of these.
      }
    }
    schema LocationSchema is flat
      of Held as record Restaurant.Locations.LocationProjection.Projected
    with {
      briefly as "How locations are laid out in storage"
      described as {
        |A flat schema: one stored row per location.
      }
    }
    handler LocationStoreHandler is {
      on command Restaurant.Locations.LocationStore.PersistLocationOpened {
        do "apply what the command carries to the stored row"
      }
    } with {
      briefly as "Keeps location storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the locations of this context"
    described as {
      |Entities are stateful, so Locations keeps a repository.
    }
  }

  connector AddressingLocation is {
    from outlet Restaurant.Locations.LocationDispatch to inlet Restaurant.Locations.Location.LocationCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

projector LocationProjection as flow is {
  inlet Observed is event Restaurant.Locations.Location.LocationOpened with {
    briefly as "Where location events are observed"
    described as {
      |The projector sees what the entity announced.
    }
  }

  outlet Persisting is command Restaurant.Locations.LocationStore.PersistLocationOpened with {
    briefly as "Where persistence commands leave for the store"
    described as {
      |Turning the event into a command is the projector's whole job.
    }
  }

  updates repository Restaurant.Locations.LocationStore

  record Projected is {
    locationId is Restaurant.Locations.LocationId
  } with {
    briefly as "The shape this projection maintains"
    described as {
      |One projected row per location, keyed by its identifier. The store holds
      |exactly this.
    }
  }

  handler LocationProjectionHandler is {
    on locationOpened: event Restaurant.Locations.Location.LocationOpened {
      tell command Restaurant.Locations.LocationStore.PersistLocationOpened(
        locationId = locationOpened.locationId
      ) to repository Restaurant.Locations.LocationStore
    }
  } with {
    briefly as "Turns location events into persistence commands"
    described as {
      |A repository is changed by commands, so something must translate.
    }
  }
} with {
  briefly as "Projects location events into the store"
  described as {
    |Stands between what the entity announced and what the store is told.
  }
}

  connector ObservingLocation is {
    from outlet Restaurant.Locations.Location.LocationEvents to inlet Restaurant.Locations.LocationProjection.Observed
  } with {
    briefly as "Carries location events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector RecordingLocation is {
    from outlet Restaurant.Locations.LocationProjection.Persisting to inlet LocationStore.Recorded
  } with {
    briefly as "Carries location events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns the restaurant locations"
  described as {
    |Reactive BBQ is a chain. The Locations context knows about each retail
    |store: where it is and what it is called.
  }
}
