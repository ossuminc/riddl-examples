context Loyalty as flow is {

  inlet LoyaltyAccountIn is command Restaurant.Loyalty.LoyaltyAccount.AccruePoints with {
    briefly as "Where loyaltyaccount commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet LoyaltyAccountDispatch is command Restaurant.Loyalty.LoyaltyAccount.AccruePoints with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler LoyaltyBoundary is {
    on request: command Restaurant.Loyalty.LoyaltyAccount.AccruePoints {
      send request to outlet Restaurant.Loyalty.LoyaltyAccountDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type LoyaltyId is Id(Restaurant.Loyalty.LoyaltyAccount) with {
    briefly as "Unique identifier for one loyaltyaccount"
    described as {
      |Defined inside Loyalty because loyaltyaccount identity is this context's concern.
    }
  }

  entity LoyaltyAccount as flow is {

    inlet LoyaltyAccountCommands is command Restaurant.Loyalty.LoyaltyAccount.AccruePoints with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet LoyaltyAccountEvents is event Restaurant.Loyalty.LoyaltyAccount.PointsAccrued with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command AccruePoints is {
      loyaltyAccountId is Id(LoyaltyAccount),
      points is Number,
      accrualRate is Real,
      redemptionRate is Real
    } with {
      briefly as "Ask for a loyaltyaccount to be recorded"
      described as {
        |Sent when a customer earned loyalty points.
      }
    }

    query WhichLoyaltyAccount replies result TheLoyaltyAccount is {
      loyaltyId is Restaurant.Loyalty.LoyaltyId
    } with {
      briefly as "Ask for the current state of one loyaltyaccount"
      described as {
        |Sent when a reader wants a loyaltyaccount they already know of.
      }
    }

    result TheLoyaltyAccount is {
      loyaltyId is Restaurant.Loyalty.LoyaltyId,
      summary is String
    } with {
      briefly as "The answer to a WhichLoyaltyAccount query"
      described as {
        |Carries the identity and a short summary of the loyaltyaccount.
      }
    }

    event PointsAccrued is {
      loyaltyId is Restaurant.Loyalty.LoyaltyId
    } with {
      briefly as "Records that a customer earned loyalty points"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record LoyaltyAccountFields is {
      loyaltyId is Restaurant.Loyalty.LoyaltyId,
      points is Number,
      accrualRate is Real,
      redemptionRate is Real
    } with {
      briefly as "Everything Reactive BBQ keeps about one loyaltyaccount"
      described as {
        |The stored shape of a loyaltyaccount.
      }
    }

    initial state LoyaltyAccountState of record Restaurant.Loyalty.LoyaltyAccount.LoyaltyAccountFields with {
      briefly as "The state of one loyaltyaccount"
      described as {
        |A loyaltyaccount has a single state; its fields change but its kind does not.
      }
    }

    handler LoyaltyAccountHandler is {
      on init {
        set field Restaurant.Loyalty.LoyaltyAccount.LoyaltyAccountFields.loyaltyId to "a freshly minted identifier"
      }
      on command AccruePoints {
        morph entity LoyaltyAccount to state LoyaltyAccountState with record Restaurant.Loyalty.LoyaltyAccount.LoyaltyAccountFields(
          loyaltyId = prompt("the loyaltyId of the resulting LoyaltyAccount state"),
          points = prompt("the points of the resulting LoyaltyAccount state"),
          accrualRate = prompt("the accrualRate of the resulting LoyaltyAccount state"),
          redemptionRate = prompt("the redemptionRate of the resulting LoyaltyAccount state")
        )
        send event PointsAccrued(
          loyaltyId = prompt("the loyaltyId carried by PointsAccrued")
        ) to outlet Restaurant.Loyalty.LoyaltyAccount.LoyaltyAccountEvents
      }
      on query WhichLoyaltyAccount {
        reply result TheLoyaltyAccount(
          loyaltyId = prompt("the loyaltyId carried by TheLoyaltyAccount"),
          summary = prompt("the summary carried by TheLoyaltyAccount")
        )
      }
    } with {
      briefly as "Handles messages addressed to a loyaltyaccount"
      described as {
        |Records loyaltyaccounts and answers questions about them.
      }
    }

  } with {
    briefly as "A single loyaltyaccount at Reactive BBQ"
    described as {
      |The entity that remembers that a customer earned loyalty points.
    }
  }



  repository LoyaltyAccountStore as sink is {
    command PersistPointsAccrued is {
      loyaltyId is Restaurant.Loyalty.LoyaltyId
    } with {
      briefly as "Apply PointsAccrued to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no
        |`yields` because storing a row records no new entity state. A
        |repository is changed by commands and read by queries, never by
        |events.
      }
    }

    inlet Recorded is command Restaurant.Loyalty.LoyaltyAccountStore.PersistPointsAccrued with {
      briefly as "Where loyalty account persistence commands arrive"
      described as {
        |A projector turns each loyalty account event into one of these.
      }
    }
    schema LoyaltyAccountSchema is flat
      of Held as record Restaurant.Loyalty.LoyaltyAccountProjection.Projected
    with {
      briefly as "How loyaltyaccounts are laid out in storage"
      described as {
        |A flat schema: one stored row per loyaltyaccount.
      }
    }
    handler LoyaltyAccountStoreHandler is {
      on command Restaurant.Loyalty.LoyaltyAccountStore.PersistPointsAccrued {
        do "apply what the command carries to the stored row"
      }
    } with {
      briefly as "Keeps loyaltyaccount storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the loyaltyaccounts of this context"
    described as {
      |Entities are stateful, so Loyalty keeps a repository.
    }
  }

  connector AddressingLoyaltyAccount is {
    from outlet Restaurant.Loyalty.LoyaltyAccountDispatch to inlet Restaurant.Loyalty.LoyaltyAccount.LoyaltyAccountCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

projector LoyaltyAccountProjection as flow is {
  inlet Observed is event Restaurant.Loyalty.LoyaltyAccount.PointsAccrued with {
    briefly as "Where loyalty account events are observed"
    described as {
      |The projector sees what the entity announced.
    }
  }

  outlet Persisting is command Restaurant.Loyalty.LoyaltyAccountStore.PersistPointsAccrued with {
    briefly as "Where persistence commands leave for the store"
    described as {
      |Turning the event into a command is the projector's whole job.
    }
  }

  updates repository Restaurant.Loyalty.LoyaltyAccountStore

  record Projected is {
    loyaltyId is Restaurant.Loyalty.LoyaltyId
  } with {
    briefly as "The shape this projection maintains"
    described as {
      |One projected row per loyalty account, keyed by its identifier. The store holds
      |exactly this.
    }
  }

  handler LoyaltyAccountProjectionHandler is {
    on pointsAccrued: event Restaurant.Loyalty.LoyaltyAccount.PointsAccrued {
      tell command Restaurant.Loyalty.LoyaltyAccountStore.PersistPointsAccrued(
        loyaltyId = pointsAccrued.loyaltyId
      ) to repository Restaurant.Loyalty.LoyaltyAccountStore
    }
  } with {
    briefly as "Turns loyalty account events into persistence commands"
    described as {
      |A repository is changed by commands, so something must translate.
    }
  }
} with {
  briefly as "Projects loyalty account events into the store"
  described as {
    |Stands between what the entity announced and what the store is told.
  }
}

  connector ObservingLoyaltyAccount is {
    from outlet Restaurant.Loyalty.LoyaltyAccount.LoyaltyAccountEvents to inlet Restaurant.Loyalty.LoyaltyAccountProjection.Observed
  } with {
    briefly as "Carries loyalty account events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector RecordingLoyaltyAccount is {
    from outlet Restaurant.Loyalty.LoyaltyAccountProjection.Persisting to inlet LoyaltyAccountStore.Recorded
  } with {
    briefly as "Carries loyaltyaccount events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns reward points earned by customers"
  described as {
    |This Loyalty bounded context keeps track of reward points for customers
    |and the accrual and redemption of those points.
  }
}
