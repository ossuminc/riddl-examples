context Menus as router is {

  inlet MenuIn is command Restaurant.Menus.Menu.ComposeMenu with {
    briefly as "Where menu commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet MenuDispatch is command Restaurant.Menus.Menu.ComposeMenu with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler MenusMenuBoundary is {
    on request: command Restaurant.Menus.Menu.ComposeMenu {
      send request to outlet Restaurant.Menus.MenuDispatch
    }
  } with {
    briefly as "Routes composing requests to the Menu entity"
    described as {
      |A second boundary pair: this context owns two entities, and an outlet
      |carries exactly one connector.
    }
  }


  inlet MenuItemIn is command Restaurant.Menus.MenuItem.AddMenuItem with {
    briefly as "Where menuitem commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet MenuItemDispatch is command Restaurant.Menus.MenuItem.AddMenuItem with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler MenusBoundary is {
    on request: command Restaurant.Menus.MenuItem.AddMenuItem {
      send request to outlet Restaurant.Menus.MenuItemDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type MenuItemId is Id(Restaurant.Menus.MenuItem) with {
    briefly as "Unique identifier for one menuitem"
    described as {
      |Defined inside Menus because menuitem identity is this context's concern.
    }
  }

  entity MenuItem as flow is {

    inlet MenuItemCommands is command Restaurant.Menus.MenuItem.AddMenuItem with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet MenuItemEvents is event Restaurant.Menus.MenuItem.MenuItemAdded with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command AddMenuItem is {
      menuItemId is Id(MenuItem),
      name is String,
      description is String,
      price is Number
    } with {
      briefly as "Ask for a menuitem to be recorded"
      described as {
        |Sent when a dish was added to the catalogue.
      }
    }

    query WhichMenuItem replies result TheMenuItem is {
      menuItemId is Restaurant.Menus.MenuItemId
    } with {
      briefly as "Ask for the current state of one menuitem"
      described as {
        |Sent when a reader wants a menuitem they already know of.
      }
    }

    result TheMenuItem is {
      menuItemId is Restaurant.Menus.MenuItemId,
      summary is String
    } with {
      briefly as "The answer to a WhichMenuItem query"
      described as {
        |Carries the identity and a short summary of the menuitem.
      }
    }

    event MenuItemAdded is {
      menuItemId is Restaurant.Menus.MenuItemId
    } with {
      briefly as "Records that a dish was added to the catalogue"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record MenuItemFields is {
      menuItemId is Restaurant.Menus.MenuItemId,
      name is String,
      description is String,
      price is Number
    } with {
      briefly as "Everything Reactive BBQ keeps about one menuitem"
      described as {
        |The stored shape of a menuitem.
      }
    }

    initial state MenuItemState of record Restaurant.Menus.MenuItem.MenuItemFields with {
      briefly as "The state of one menuitem"
      described as {
        |A menuitem has a single state; its fields change but its kind does not.
      }
    }

    handler MenuItemHandler is {
      on init {
        set field Restaurant.Menus.MenuItem.MenuItemFields.menuItemId to "a freshly minted identifier"
      }
      on command AddMenuItem {
        morph entity MenuItem to state MenuItemState with record Restaurant.Menus.MenuItem.MenuItemFields(
          menuItemId = prompt("the menuItemId of the resulting MenuItem state"),
          name = prompt("the name of the resulting MenuItem state"),
          description = prompt("the description of the resulting MenuItem state"),
          price = prompt("the price of the resulting MenuItem state")
        )
        send event MenuItemAdded(
          menuItemId = prompt("the menuItemId carried by MenuItemAdded")
        ) to outlet Restaurant.Menus.MenuItem.MenuItemEvents
      }
      on query WhichMenuItem {
        reply result TheMenuItem(
          menuItemId = prompt("the menuItemId carried by TheMenuItem"),
          summary = prompt("the summary carried by TheMenuItem")
        )
      }
    } with {
      briefly as "Handles messages addressed to a menuitem"
      described as {
        |Records menuitems and answers questions about them.
      }
    }

  } with {
    briefly as "A single menuitem at Reactive BBQ"
    described as {
      |The entity that remembers that a dish was added to the catalogue.
    }
  }



  repository MenuItemStore as sink is {
    inlet Recorded is event Restaurant.Menus.MenuItem.MenuItemAdded with {
      briefly as "Where menuitem events arrive to be persisted"
      described as {
        |The repository learns of changes through this inlet.
      }
    }
    schema MenuItemSchema is flat
      of Held as record Restaurant.Menus.MenuItem.MenuItemFields
    with {
      briefly as "How menuitems are laid out in storage"
      described as {
        |A flat schema: one stored row per menuitem.
      }
    }
    handler MenuItemStoreHandler is {
      on event Restaurant.Menus.MenuItem.MenuItemAdded {
        do "store the identifier carried by the event"
      }
    } with {
      briefly as "Keeps menuitem storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the menuitems of this context"
    described as {
      |Entities are stateful, so Menus keeps a repository.
    }
  }

  connector AddressingMenuItem is {
    from outlet Restaurant.Menus.MenuItemDispatch to inlet Restaurant.Menus.MenuItem.MenuItemCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector RecordingMenuItem is {
    from outlet Restaurant.Menus.MenuItem.MenuItemEvents to inlet MenuItemStore.Recorded
  } with {
    briefly as "Carries menuitem events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

  type MenuId is Id(Restaurant.Menus.Menu) with {
    briefly as "Unique identifier for one menu"
    described as {
      |Defined inside Menus because menu identity is this context's concern.
    }
  }

  entity Menu as flow is {

    inlet MenuCommands is command Restaurant.Menus.Menu.ComposeMenu with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet MenuEvents is event Restaurant.Menus.Menu.MenuComposed with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command ComposeMenu is {
      menuId is Id(Menu),
      title is String,
      season is String
    } with {
      briefly as "Ask for a menu to be recorded"
      described as {
        |Sent when a menu was composed from the catalogue.
      }
    }

    query WhichMenu replies result TheMenu is {
      menuId is Restaurant.Menus.MenuId
    } with {
      briefly as "Ask for the current state of one menu"
      described as {
        |Sent when a reader wants a menu they already know of.
      }
    }

    result TheMenu is {
      menuId is Restaurant.Menus.MenuId,
      summary is String
    } with {
      briefly as "The answer to a WhichMenu query"
      described as {
        |Carries the identity and a short summary of the menu.
      }
    }

    event MenuComposed is {
      menuId is Restaurant.Menus.MenuId
    } with {
      briefly as "Records that a menu was composed from the catalogue"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record MenuFields is {
      menuId is Restaurant.Menus.MenuId,
      title is String,
      season is String
    } with {
      briefly as "Everything Reactive BBQ keeps about one menu"
      described as {
        |The stored shape of a menu.
      }
    }

    initial state MenuState of record Restaurant.Menus.Menu.MenuFields with {
      briefly as "The state of one menu"
      described as {
        |A menu has a single state; its fields change but its kind does not.
      }
    }

    handler MenuHandler is {
      on init {
        set field Restaurant.Menus.Menu.MenuFields.menuId to "a freshly minted identifier"
      }
      on command ComposeMenu {
        morph entity Menu to state MenuState with record Restaurant.Menus.Menu.MenuFields(
          menuId = prompt("the menuId of the resulting Menu state"),
          title = prompt("the title of the resulting Menu state"),
          season = prompt("the season of the resulting Menu state")
        )
        send event MenuComposed(
          menuId = prompt("the menuId carried by MenuComposed")
        ) to outlet Restaurant.Menus.Menu.MenuEvents
      }
      on query WhichMenu {
        reply result TheMenu(
          menuId = prompt("the menuId carried by TheMenu"),
          summary = prompt("the summary carried by TheMenu")
        )
      }
    } with {
      briefly as "Handles messages addressed to a menu"
      described as {
        |Records menus and answers questions about them.
      }
    }

  } with {
    briefly as "A single menu at Reactive BBQ"
    described as {
      |The entity that remembers that a menu was composed from the catalogue.
    }
  }



  repository MenuStore as sink is {
    inlet Recorded is event Restaurant.Menus.Menu.MenuComposed with {
      briefly as "Where menu events arrive to be persisted"
      described as {
        |The repository learns of changes through this inlet.
      }
    }
    schema MenuSchema is flat
      of Held as record Restaurant.Menus.Menu.MenuFields
    with {
      briefly as "How menus are laid out in storage"
      described as {
        |A flat schema: one stored row per menu.
      }
    }
    handler MenuStoreHandler is {
      on event Restaurant.Menus.Menu.MenuComposed {
        do "store the identifier carried by the event"
      }
    } with {
      briefly as "Keeps menu storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the menus of this context"
    described as {
      |Entities are stateful, so Menus keeps a repository.
    }
  }

  connector AddressingMenu is {
    from outlet Restaurant.Menus.MenuDispatch to inlet Restaurant.Menus.Menu.MenuCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector RecordingMenu is {
    from outlet Restaurant.Menus.Menu.MenuEvents to inlet MenuStore.Recorded
  } with {
    briefly as "Carries menu events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns what the restaurant offers to sell"
  described as {
    |The Menus context holds the items a location can sell and the menus
    |that group them.
  }
}
