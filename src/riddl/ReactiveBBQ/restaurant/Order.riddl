context Orders as flow is {

  inlet OrderIn is command Restaurant.Orders.Order.PlaceOrder with {
    briefly as "Where order commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet OrderDispatch is command Restaurant.Orders.Order.PlaceOrder with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler OrdersBoundary is {
    on request: command Restaurant.Orders.Order.PlaceOrder {
      send request to outlet Restaurant.Orders.OrderDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type OrderId is Id(Restaurant.Orders.Order) with {
    briefly as "Unique identifier for one order"
    described as {
      |Defined inside Orders because order identity is this context's concern.
    }
  }

  entity Order as flow is {

    inlet OrderCommands is command Restaurant.Orders.Order.PlaceOrder with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet OrderEvents is event Restaurant.Orders.Order.OrderPlaced with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command PlaceOrder is {
      orderId is Id(Order),
      customerName is String,
      total is Number
    } with {
      briefly as "Ask for a order to be recorded"
      described as {
        |Sent when a customer placed an order.
      }
    }

    query WhichOrder replies result TheOrder is {
      orderId is Restaurant.Orders.OrderId
    } with {
      briefly as "Ask for the current state of one order"
      described as {
        |Sent when a reader wants a order they already know of.
      }
    }

    result TheOrder is {
      orderId is Restaurant.Orders.OrderId,
      summary is String
    } with {
      briefly as "The answer to a WhichOrder query"
      described as {
        |Carries the identity and a short summary of the order.
      }
    }

    event OrderPlaced is {
      orderId is Restaurant.Orders.OrderId
    } with {
      briefly as "Records that a customer placed an order"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record OrderFields is {
      orderId is Restaurant.Orders.OrderId,
      customerName is String,
      total is Number
    } with {
      briefly as "Everything Reactive BBQ keeps about one order"
      described as {
        |The stored shape of a order.
      }
    }

    initial state OrderState of record Restaurant.Orders.Order.OrderFields with {
      briefly as "The state of one order"
      described as {
        |A order has a single state; its fields change but its kind does not.
      }
    }

    handler OrderHandler is {
      on init {
        set field Restaurant.Orders.Order.OrderFields.orderId to "a freshly minted identifier"
      }
      on command PlaceOrder {
        send event OrderPlaced(
          orderId = prompt("the orderId carried by OrderPlaced")
        ) to outlet Restaurant.Orders.Order.OrderEvents
      }
      on query WhichOrder {
        reply result TheOrder(
          orderId = prompt("the orderId carried by TheOrder"),
          summary = prompt("the summary carried by TheOrder")
        )
      }
    } with {
      briefly as "Handles messages addressed to a order"
      described as {
        |Records orders and answers questions about them.
      }
    }

  } with {
    briefly as "A single order at Reactive BBQ"
    described as {
      |The entity that remembers that a customer placed an order.
    }
  }



  repository OrderStore as sink is {
    command PersistOrderPlaced is {
      orderId is Restaurant.Orders.OrderId
    } with {
      briefly as "Apply OrderPlaced to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no
        |`yields` because storing a row records no new entity state. A
        |repository is changed by commands and read by queries, never by
        |events.
      }
    }

    inlet Recorded is command Restaurant.Orders.OrderStore.PersistOrderPlaced with {
      briefly as "Where order persistence commands arrive"
      described as {
        |A projector turns each order event into one of these.
      }
    }
    schema OrderSchema is flat
      of Held as record Restaurant.Orders.OrderProjection.Projected
    with {
      briefly as "How orders are laid out in storage"
      described as {
        |A flat schema: one stored row per order.
      }
    }
    handler OrderStoreHandler is {
      on command Restaurant.Orders.OrderStore.PersistOrderPlaced {
        do "apply what the command carries to the stored row"
      }
    } with {
      briefly as "Keeps order storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the orders of this context"
    described as {
      |Entities are stateful, so Orders keeps a repository.
    }
  }

  connector AddressingOrder is {
    from outlet Restaurant.Orders.OrderDispatch to inlet Restaurant.Orders.Order.OrderCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

projector OrderProjection as flow is {
  inlet Observed is event Restaurant.Orders.Order.OrderPlaced with {
    briefly as "Where order events are observed"
    described as {
      |The projector sees what the entity announced.
    }
  }

  outlet Persisting is command Restaurant.Orders.OrderStore.PersistOrderPlaced with {
    briefly as "Where persistence commands leave for the store"
    described as {
      |Turning the event into a command is the projector's whole job.
    }
  }

  updates repository Restaurant.Orders.OrderStore

  record Projected is {
    orderId is Restaurant.Orders.OrderId
  } with {
    briefly as "The shape this projection maintains"
    described as {
      |One projected row per order, keyed by its identifier. The store holds
      |exactly this.
    }
  }

  handler OrderProjectionHandler is {
    on orderPlaced: event Restaurant.Orders.Order.OrderPlaced {
      tell command Restaurant.Orders.OrderStore.PersistOrderPlaced(
        orderId = orderPlaced.orderId
      ) to repository Restaurant.Orders.OrderStore
    }
  } with {
    briefly as "Turns order events into persistence commands"
    described as {
      |A repository is changed by commands, so something must translate.
    }
  }
} with {
  briefly as "Projects order events into the store"
  described as {
    |Stands between what the entity announced and what the store is told.
  }
}

  connector ObservingOrder is {
    from outlet Restaurant.Orders.Order.OrderEvents to inlet Restaurant.Orders.OrderProjection.Observed
  } with {
    briefly as "Carries order events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector RecordingOrder is {
    from outlet Restaurant.Orders.OrderProjection.Persisting to inlet OrderStore.Recorded
  } with {
    briefly as "Carries order events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns what a customer asked to eat"
  described as {
    |This bounded context defines the handling of restaurant orders: what
    |was ordered, by whom, and how far along it is.
  }
}
