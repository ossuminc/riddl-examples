context Payments as flow is {

  inlet PaymentIn is command Restaurant.Payments.Payment.Pay with {
    briefly as "Where payment commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet PaymentDispatch is command Restaurant.Payments.Payment.Pay with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler PaymentsBoundary is {
    on request: command Restaurant.Payments.Payment.Pay {
      send request to outlet Restaurant.Payments.PaymentDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type PaymentId is Id(Restaurant.Payments.Payment) with {
    briefly as "Unique identifier for one payment"
    described as {
      |Defined inside Payments because payment identity is this context's concern.
    }
  }

  entity Payment as flow is {

    inlet PaymentCommands is command Restaurant.Payments.Payment.Pay with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet PaymentEvents is event Restaurant.Payments.Payment.Paid with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command Pay is {
      paymentId is Id(Payment),
      orderAmount is Number,
      tipAmount is Number,
      cardToken is String
    } with {
      briefly as "Ask for a payment to be recorded"
      described as {
        |Sent when a customer paid for their order.
      }
    }

    query WhichPayment is {
      paymentId is Restaurant.Payments.PaymentId
    } with {
      briefly as "Ask for the current state of one payment"
      described as {
        |Sent when a reader wants a payment they already know of.
      }
    }

    result ThePayment is {
      paymentId is Restaurant.Payments.PaymentId,
      summary is String
    } with {
      briefly as "The answer to a WhichPayment query"
      described as {
        |Carries the identity and a short summary of the payment.
      }
    }

    event Paid is {
      paymentId is Restaurant.Payments.PaymentId
    } with {
      briefly as "Records that a customer paid for their order"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record PaymentFields is {
      paymentId is Restaurant.Payments.PaymentId,
      orderAmount is Number,
      tipAmount is Number,
      cardToken is String
    } with {
      briefly as "Everything Reactive BBQ keeps about one payment"
      described as {
        |The stored shape of a payment.
      }
    }

    initial state PaymentState of record Restaurant.Payments.Payment.PaymentFields with {
      briefly as "The state of one payment"
      described as {
        |A payment has a single state; its fields change but its kind does not.
      }
    }

    handler PaymentHandler is {
      on init {
        set field Restaurant.Payments.Payment.PaymentFields.paymentId to "a freshly minted identifier"
      }
      on command Pay {
        morph entity Payment to state PaymentState with record Restaurant.Payments.Payment.PaymentFields(
          paymentId = prompt("the paymentId of the resulting Payment state"),
          orderAmount = prompt("the orderAmount of the resulting Payment state"),
          tipAmount = prompt("the tipAmount of the resulting Payment state"),
          cardToken = prompt("the cardToken of the resulting Payment state")
        )
        send event Paid(paymentId = prompt("the paymentId carried by Paid")) to outlet Restaurant.Payments.Payment.PaymentEvents
      }
      on query WhichPayment {
        reply result ThePayment(
          paymentId = prompt("the paymentId carried by ThePayment"),
          summary = prompt("the summary carried by ThePayment")
        )
      }
    } with {
      briefly as "Handles messages addressed to a payment"
      described as {
        |Records payments and answers questions about them.
      }
    }

  } with {
    briefly as "A single payment at Reactive BBQ"
    described as {
      |The entity that remembers that a customer paid for their order.
    }
  }



  repository PaymentStore as sink is {
    inlet Recorded is event Restaurant.Payments.Payment.Paid with {
      briefly as "Where payment events arrive to be persisted"
      described as {
        |The repository learns of changes through this inlet.
      }
    }
    schema PaymentSchema is flat
      of Held as record Restaurant.Payments.Payment.PaymentFields
    with {
      briefly as "How payments are laid out in storage"
      described as {
        |A flat schema: one stored row per payment.
      }
    }
    handler PaymentStoreHandler is {
      on event Restaurant.Payments.Payment.Paid {
        do "store the identifier carried by the event"
      }
    } with {
      briefly as "Keeps payment storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the payments of this context"
    described as {
      |Entities are stateful, so Payments keeps a repository.
    }
  }

  connector AddressingPayment is {
    from outlet Restaurant.Payments.PaymentDispatch to inlet Restaurant.Payments.Payment.PaymentCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector RecordingPayment is {
    from outlet Restaurant.Payments.Payment.PaymentEvents to inlet PaymentStore.Recorded
  } with {
    briefly as "Carries payment events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns the taking of money for orders"
  described as {
    |The Payment bounded context deals with receiving payments from
    |customers for their orders.
  }
}
