context Reservations as flow is {

  inlet ReservationIn is command Restaurant.Reservations.Reservation.BookTable with {
    briefly as "Where reservation commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet ReservationDispatch is command Restaurant.Reservations.Reservation.BookTable with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler ReservationsBoundary is {
    on request: command Restaurant.Reservations.Reservation.BookTable {
      send request to outlet Restaurant.Reservations.ReservationDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type ReservationId is Id(Restaurant.Reservations.Reservation) with {
    briefly as "Unique identifier for one reservation"
    described as {
      |Defined inside Reservations because reservation identity is this context's concern.
    }
  }

  entity Reservation as flow is {

    inlet ReservationCommands is command Restaurant.Reservations.Reservation.BookTable with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet ReservationEvents is event Restaurant.Reservations.Reservation.TableBooked with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command BookTable is {
      reservationId is Id(Reservation),
      partyName is String,
      phoneNumber is String,
      time is Time,
      date is Date
    } with {
      briefly as "Ask for a reservation to be recorded"
      described as {
        |Sent when a party reserved a table.
      }
    }

    query WhichReservation replies result TheReservation is {
      reservationId is Restaurant.Reservations.ReservationId
    } with {
      briefly as "Ask for the current state of one reservation"
      described as {
        |Sent when a reader wants a reservation they already know of.
      }
    }

    result TheReservation is {
      reservationId is Restaurant.Reservations.ReservationId,
      summary is String
    } with {
      briefly as "The answer to a WhichReservation query"
      described as {
        |Carries the identity and a short summary of the reservation.
      }
    }

    event TableBooked is {
      reservationId is Restaurant.Reservations.ReservationId
    } with {
      briefly as "Records that a party reserved a table"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record ReservationFields is {
      reservationId is Restaurant.Reservations.ReservationId,
      partyName is String,
      phoneNumber is String,
      time is Time,
      date is Date
    } with {
      briefly as "Everything Reactive BBQ keeps about one reservation"
      described as {
        |The stored shape of a reservation.
      }
    }

    initial state ReservationState of record Restaurant.Reservations.Reservation.ReservationFields with {
      briefly as "The state of one reservation"
      described as {
        |A reservation has a single state; its fields change but its kind does not.
      }
    }

    handler ReservationHandler is {
      on init {
        set field Restaurant.Reservations.Reservation.ReservationFields.reservationId to "a freshly minted identifier"
      }
      on command BookTable {
        send event TableBooked(
          reservationId = prompt("the reservationId carried by TableBooked")
        ) to outlet Restaurant.Reservations.Reservation.ReservationEvents
      }
      on query WhichReservation {
        reply result TheReservation(
          reservationId = prompt("the reservationId carried by TheReservation"),
          summary = prompt("the summary carried by TheReservation")
        )
      }
    } with {
      briefly as "Handles messages addressed to a reservation"
      described as {
        |Records reservations and answers questions about them.
      }
    }

  } with {
    briefly as "A single reservation at Reactive BBQ"
    described as {
      |The entity that remembers that a party reserved a table.
    }
  }



  repository ReservationStore as sink is {
    command PersistTableBooked is {
      reservationId is Restaurant.Reservations.ReservationId
    } with {
      briefly as "Apply TableBooked to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no
        |`yields` because storing a row records no new entity state. A
        |repository is changed by commands and read by queries, never by
        |events.
      }
    }

    inlet Recorded is command Restaurant.Reservations.ReservationStore.PersistTableBooked with {
      briefly as "Where reservation persistence commands arrive"
      described as {
        |A projector turns each reservation event into one of these.
      }
    }
    schema ReservationSchema is flat
      of Held as record Restaurant.Reservations.ReservationProjection.Projected
    with {
      briefly as "How reservations are laid out in storage"
      described as {
        |A flat schema: one stored row per reservation.
      }
    }
    handler ReservationStoreHandler is {
      on command Restaurant.Reservations.ReservationStore.PersistTableBooked {
        do "apply what the command carries to the stored row"
      }
    } with {
      briefly as "Keeps reservation storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the reservations of this context"
    described as {
      |Entities are stateful, so Reservations keeps a repository.
    }
  }

  connector AddressingReservation is {
    from outlet Restaurant.Reservations.ReservationDispatch to inlet Restaurant.Reservations.Reservation.ReservationCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

projector ReservationProjection as flow is {
  inlet Observed is event Restaurant.Reservations.Reservation.TableBooked with {
    briefly as "Where reservation events are observed"
    described as {
      |The projector sees what the entity announced.
    }
  }

  outlet Persisting is command Restaurant.Reservations.ReservationStore.PersistTableBooked with {
    briefly as "Where persistence commands leave for the store"
    described as {
      |Turning the event into a command is the projector's whole job.
    }
  }

  updates repository Restaurant.Reservations.ReservationStore

  record Projected is {
    reservationId is Restaurant.Reservations.ReservationId
  } with {
    briefly as "The shape this projection maintains"
    described as {
      |One projected row per reservation, keyed by its identifier. The store holds
      |exactly this.
    }
  }

  handler ReservationProjectionHandler is {
    on tableBooked: event Restaurant.Reservations.Reservation.TableBooked {
      tell command Restaurant.Reservations.ReservationStore.PersistTableBooked(
        reservationId = tableBooked.reservationId
      ) to repository Restaurant.Reservations.ReservationStore
    }
  } with {
    briefly as "Turns reservation events into persistence commands"
    described as {
      |A repository is changed by commands, so something must translate.
    }
  }
} with {
  briefly as "Projects reservation events into the store"
  described as {
    |Stands between what the entity announced and what the store is told.
  }
}

  connector ObservingReservation is {
    from outlet Restaurant.Reservations.Reservation.ReservationEvents to inlet Restaurant.Reservations.ReservationProjection.Observed
  } with {
    briefly as "Carries reservation events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector RecordingReservation is {
    from outlet Restaurant.Reservations.ReservationProjection.Persisting to inlet ReservationStore.Recorded
  } with {
    briefly as "Carries reservation events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns bookings made ahead of arrival"
  described as {
    |The Reservations context holds a party's intention to dine at a given
    |time, before any order exists.
  }
}
