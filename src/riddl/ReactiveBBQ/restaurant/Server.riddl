context Servers as flow is {

  inlet ServerIn is command Restaurant.Servers.Server.AddServer with {
    briefly as "Where server commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet ServerDispatch is command Restaurant.Servers.Server.AddServer with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler ServersBoundary is {
    on request: command Restaurant.Servers.Server.AddServer {
      send request to outlet Restaurant.Servers.ServerDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type ServerId is Id(Restaurant.Servers.Server) with {
    briefly as "Unique identifier for one server"
    described as {
      |Defined inside Servers because server identity is this context's concern.
    }
  }

  entity Server as flow is {

    inlet ServerCommands is command Restaurant.Servers.Server.AddServer with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet ServerEvents is event Restaurant.Servers.Server.ServerAdded with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command AddServer is {
      serverId is Id(Server),
      name is String,
      section is String
    } with {
      briefly as "Ask for a server to be recorded"
      described as {
        |Sent when a server joined the roster.
      }
    }

    query WhichServer replies result TheServer is {
      serverId is Restaurant.Servers.ServerId
    } with {
      briefly as "Ask for the current state of one server"
      described as {
        |Sent when a reader wants a server they already know of.
      }
    }

    result TheServer is {
      serverId is Restaurant.Servers.ServerId,
      summary is String
    } with {
      briefly as "The answer to a WhichServer query"
      described as {
        |Carries the identity and a short summary of the server.
      }
    }

    event ServerAdded is {
      serverId is Restaurant.Servers.ServerId
    } with {
      briefly as "Records that a server joined the roster"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record ServerFields is {
      serverId is Restaurant.Servers.ServerId,
      name is String,
      section is String
    } with {
      briefly as "Everything Reactive BBQ keeps about one server"
      described as {
        |The stored shape of a server.
      }
    }

    initial state ServerState of record Restaurant.Servers.Server.ServerFields with {
      briefly as "The state of one server"
      described as {
        |A server has a single state; its fields change but its kind does not.
      }
    }

    handler ServerHandler is {
      on init {
        set field Restaurant.Servers.Server.ServerFields.serverId to "a freshly minted identifier"
      }
      on command AddServer {
        morph entity Server to state ServerState with record Restaurant.Servers.Server.ServerFields(
          serverId = prompt("the serverId of the resulting Server state"),
          name = prompt("the name of the resulting Server state"),
          section = prompt("the section of the resulting Server state")
        )
        send event ServerAdded(
          serverId = prompt("the serverId carried by ServerAdded")
        ) to outlet Restaurant.Servers.Server.ServerEvents
      }
      on query WhichServer {
        reply result TheServer(
          serverId = prompt("the serverId carried by TheServer"),
          summary = prompt("the summary carried by TheServer")
        )
      }
    } with {
      briefly as "Handles messages addressed to a server"
      described as {
        |Records servers and answers questions about them.
      }
    }

  } with {
    briefly as "A single server at Reactive BBQ"
    described as {
      |The entity that remembers that a server joined the roster.
    }
  }



  repository ServerStore as sink is {
    command PersistServerAdded is {
      serverId is Restaurant.Servers.ServerId
    } with {
      briefly as "Apply ServerAdded to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no
        |`yields` because storing a row records no new entity state. A
        |repository is changed by commands and read by queries, never by
        |events.
      }
    }

    inlet Recorded is command Restaurant.Servers.ServerStore.PersistServerAdded with {
      briefly as "Where server persistence commands arrive"
      described as {
        |A projector turns each server event into one of these.
      }
    }
    schema ServerSchema is flat
      of Held as record Restaurant.Servers.ServerProjection.Projected
    with {
      briefly as "How servers are laid out in storage"
      described as {
        |A flat schema: one stored row per server.
      }
    }
    handler ServerStoreHandler is {
      on command Restaurant.Servers.ServerStore.PersistServerAdded {
        do "apply what the command carries to the stored row"
      }
    } with {
      briefly as "Keeps server storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the servers of this context"
    described as {
      |Entities are stateful, so Servers keeps a repository.
    }
  }

  connector AddressingServer is {
    from outlet Restaurant.Servers.ServerDispatch to inlet Restaurant.Servers.Server.ServerCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

projector ServerProjection as flow is {
  inlet Observed is event Restaurant.Servers.Server.ServerAdded with {
    briefly as "Where server events are observed"
    described as {
      |The projector sees what the entity announced.
    }
  }

  outlet Persisting is command Restaurant.Servers.ServerStore.PersistServerAdded with {
    briefly as "Where persistence commands leave for the store"
    described as {
      |Turning the event into a command is the projector's whole job.
    }
  }

  updates repository Restaurant.Servers.ServerStore

  record Projected is {
    serverId is Restaurant.Servers.ServerId
  } with {
    briefly as "The shape this projection maintains"
    described as {
      |One projected row per server, keyed by its identifier. The store holds
      |exactly this.
    }
  }

  handler ServerProjectionHandler is {
    on serverAdded: event Restaurant.Servers.Server.ServerAdded {
      tell command Restaurant.Servers.ServerStore.PersistServerAdded(
        serverId = serverAdded.serverId
      ) to repository Restaurant.Servers.ServerStore
    }
  } with {
    briefly as "Turns server events into persistence commands"
    described as {
      |A repository is changed by commands, so something must translate.
    }
  }
} with {
  briefly as "Projects server events into the store"
  described as {
    |Stands between what the entity announced and what the store is told.
  }
}

  connector ObservingServer is {
    from outlet Restaurant.Servers.Server.ServerEvents to inlet Restaurant.Servers.ServerProjection.Observed
  } with {
    briefly as "Carries server events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector RecordingServer is {
    from outlet Restaurant.Servers.ServerProjection.Persisting to inlet ServerStore.Recorded
  } with {
    briefly as "Carries server events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns the waiting staff"
  described as {
    |The Servers context tracks who is working and which section they cover.
  }
}
