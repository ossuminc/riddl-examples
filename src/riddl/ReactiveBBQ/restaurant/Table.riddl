context Tables as flow is {

  inlet TableIn is command Restaurant.Tables.Table.AddTable with {
    briefly as "Where table commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet TableDispatch is command Restaurant.Tables.Table.AddTable with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler TablesBoundary is {
    on request: command Restaurant.Tables.Table.AddTable {
      send request to outlet Restaurant.Tables.TableDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type TableId is Id(Restaurant.Tables.Table) with {
    briefly as "Unique identifier for one table"
    described as {
      |Defined inside Tables because table identity is this context's concern.
    }
  }

  entity Table as flow is {

    inlet TableCommands is command Restaurant.Tables.Table.AddTable with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet TableEvents is event Restaurant.Tables.Table.TableAdded with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command AddTable is {
      tableId is Id(Table),
      seats is Integer,
      section is String
    } with {
      briefly as "Ask for a table to be recorded"
      described as {
        |Sent when a table was put into service.
      }
    }

    query WhichTable replies result TheTable is {
      tableId is Restaurant.Tables.TableId
    } with {
      briefly as "Ask for the current state of one table"
      described as {
        |Sent when a reader wants a table they already know of.
      }
    }

    result TheTable is {
      tableId is Restaurant.Tables.TableId,
      summary is String
    } with {
      briefly as "The answer to a WhichTable query"
      described as {
        |Carries the identity and a short summary of the table.
      }
    }

    event TableAdded is {
      tableId is Restaurant.Tables.TableId
    } with {
      briefly as "Records that a table was put into service"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record TableFields is {
      tableId is Restaurant.Tables.TableId,
      seats is Integer,
      section is String
    } with {
      briefly as "Everything Reactive BBQ keeps about one table"
      described as {
        |The stored shape of a table.
      }
    }

    initial state TableState of record Restaurant.Tables.Table.TableFields with {
      briefly as "The state of one table"
      described as {
        |A table has a single state; its fields change but its kind does not.
      }
    }

    handler TableHandler is {
      on init {
        set field Restaurant.Tables.Table.TableFields.tableId to "a freshly minted identifier"
      }
      on command AddTable {
        morph entity Table to state TableState with record Restaurant.Tables.Table.TableFields(
          tableId = prompt("the tableId of the resulting Table state"),
          seats = prompt("the seats of the resulting Table state"),
          section = prompt("the section of the resulting Table state")
        )
        send event TableAdded(
          tableId = prompt("the tableId carried by TableAdded")
        ) to outlet Restaurant.Tables.Table.TableEvents
      }
      on query WhichTable {
        reply result TheTable(
          tableId = prompt("the tableId carried by TheTable"),
          summary = prompt("the summary carried by TheTable")
        )
      }
    } with {
      briefly as "Handles messages addressed to a table"
      described as {
        |Records tables and answers questions about them.
      }
    }

  } with {
    briefly as "A single table at Reactive BBQ"
    described as {
      |The entity that remembers that a table was put into service.
    }
  }



  repository TableStore as sink is {
    command PersistTableAdded is {
      tableId is Restaurant.Tables.TableId
    } with {
      briefly as "Apply TableAdded to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no
        |`yields` because storing a row records no new entity state. A
        |repository is changed by commands and read by queries, never by
        |events.
      }
    }

    inlet Recorded is command Restaurant.Tables.TableStore.PersistTableAdded with {
      briefly as "Where table persistence commands arrive"
      described as {
        |A projector turns each table event into one of these.
      }
    }
    schema TableSchema is flat
      of Held as record Restaurant.Tables.TableProjection.Projected
    with {
      briefly as "How tables are laid out in storage"
      described as {
        |A flat schema: one stored row per table.
      }
    }
    handler TableStoreHandler is {
      on command Restaurant.Tables.TableStore.PersistTableAdded {
        do "apply what the command carries to the stored row"
      }
    } with {
      briefly as "Keeps table storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists the tables of this context"
    described as {
      |Entities are stateful, so Tables keeps a repository.
    }
  }

  connector AddressingTable is {
    from outlet Restaurant.Tables.TableDispatch to inlet Restaurant.Tables.Table.TableCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

projector TableProjection as flow is {
  inlet Observed is event Restaurant.Tables.Table.TableAdded with {
    briefly as "Where table events are observed"
    described as {
      |The projector sees what the entity announced.
    }
  }

  outlet Persisting is command Restaurant.Tables.TableStore.PersistTableAdded with {
    briefly as "Where persistence commands leave for the store"
    described as {
      |Turning the event into a command is the projector's whole job.
    }
  }

  updates repository Restaurant.Tables.TableStore

  record Projected is {
    tableId is Restaurant.Tables.TableId
  } with {
    briefly as "The shape this projection maintains"
    described as {
      |One projected row per table, keyed by its identifier. The store holds
      |exactly this.
    }
  }

  handler TableProjectionHandler is {
    on tableAdded: event Restaurant.Tables.Table.TableAdded {
      tell command Restaurant.Tables.TableStore.PersistTableAdded(
        tableId = tableAdded.tableId
      ) to repository Restaurant.Tables.TableStore
    }
  } with {
    briefly as "Turns table events into persistence commands"
    described as {
      |A repository is changed by commands, so something must translate.
    }
  }
} with {
  briefly as "Projects table events into the store"
  described as {
    |Stands between what the entity announced and what the store is told.
  }
}

  connector ObservingTable is {
    from outlet Restaurant.Tables.Table.TableEvents to inlet Restaurant.Tables.TableProjection.Observed
  } with {
    briefly as "Carries table events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector RecordingTable is {
    from outlet Restaurant.Tables.TableProjection.Persisting to inlet TableStore.Recorded
  } with {
    briefly as "Carries table events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Owns the tables in the dining room"
  described as {
    |The Tables context tracks the physical tables a party can be seated at.
  }
}
