domain Restaurant is {

  include "Customer"
  include "Kitchen"
  include "Location"
  include "Loyalty"
  include "Menu"
  include "Order"
  include "Payment"
  include "Reservation"
  include "Server"
  include "Table"

  context RestaurantFrontEnd is {

    inlet CustomerStaged is command Restaurant.Customers.Customer.RegisterCustomer with {
      briefly as "Where the front end's customer requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet CustomerSubmissions is command Restaurant.Customers.Customer.RegisterCustomer with {
      briefly as "Where customer requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet TableStaged is command Restaurant.Tables.Table.AddTable with {
      briefly as "Where the front end's table requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet TableSubmissions is command Restaurant.Tables.Table.AddTable with {
      briefly as "Where table requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet ServerStaged is command Restaurant.Servers.Server.AddServer with {
      briefly as "Where the front end's server requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet ServerSubmissions is command Restaurant.Servers.Server.AddServer with {
      briefly as "Where server requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet LocationStaged is command Restaurant.Locations.Location.OpenLocation with {
      briefly as "Where the front end's location requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet LocationSubmissions is command Restaurant.Locations.Location.OpenLocation with {
      briefly as "Where location requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet OrderStaged is command Restaurant.Orders.Order.PlaceOrder with {
      briefly as "Where the front end's order requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet OrderSubmissions is command Restaurant.Orders.Order.PlaceOrder with {
      briefly as "Where order requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet PaymentStaged is command Restaurant.Payments.Payment.Pay with {
      briefly as "Where the front end's payment requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet PaymentSubmissions is command Restaurant.Payments.Payment.Pay with {
      briefly as "Where payment requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet ReservationStaged is command Restaurant.Reservations.Reservation.BookTable with {
      briefly as "Where the front end's reservation requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet ReservationSubmissions is command Restaurant.Reservations.Reservation.BookTable with {
      briefly as "Where reservation requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet OrderViewerStaged is command Restaurant.Kitchen.OrderViewer.ShowOrders with {
      briefly as "Where the front end's orderviewer requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet OrderViewerSubmissions is command Restaurant.Kitchen.OrderViewer.ShowOrders with {
      briefly as "Where orderviewer requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet MenuItemStaged is command Restaurant.Menus.MenuItem.AddMenuItem with {
      briefly as "Where the front end's menuitem requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet MenuItemSubmissions is command Restaurant.Menus.MenuItem.AddMenuItem with {
      briefly as "Where menuitem requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet MenuStaged is command Restaurant.Menus.Menu.ComposeMenu with {
      briefly as "Where the front end's menu requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet MenuSubmissions is command Restaurant.Menus.Menu.ComposeMenu with {
      briefly as "Where menu requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet LoyaltyAccountStaged is command Restaurant.Loyalty.LoyaltyAccount.AccruePoints with {
      briefly as "Where the front end's loyaltyaccount requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet LoyaltyAccountSubmissions is command Restaurant.Loyalty.LoyaltyAccount.AccruePoints with {
      briefly as "Where loyaltyaccount requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    connector StagingCustomer is {
      from outlet Restaurant.RestaurantFrontEnd.CustomerRequests.Staged to inlet Restaurant.RestaurantFrontEnd.CustomerStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    connector StagingTable is {
      from outlet Restaurant.RestaurantFrontEnd.TableRequests.Staged to inlet Restaurant.RestaurantFrontEnd.TableStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    connector StagingServer is {
      from outlet Restaurant.RestaurantFrontEnd.ServerRequests.Staged to inlet Restaurant.RestaurantFrontEnd.ServerStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    connector StagingLocation is {
      from outlet Restaurant.RestaurantFrontEnd.LocationRequests.Staged to inlet Restaurant.RestaurantFrontEnd.LocationStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    connector StagingOrder is {
      from outlet Restaurant.RestaurantFrontEnd.OrderRequests.Staged to inlet Restaurant.RestaurantFrontEnd.OrderStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    connector StagingPayment is {
      from outlet Restaurant.RestaurantFrontEnd.PaymentRequests.Staged to inlet Restaurant.RestaurantFrontEnd.PaymentStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    connector StagingReservation is {
      from outlet Restaurant.RestaurantFrontEnd.ReservationRequests.Staged to inlet Restaurant.RestaurantFrontEnd.ReservationStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    connector StagingOrderViewer is {
      from outlet Restaurant.RestaurantFrontEnd.OrderViewerRequests.Staged to inlet Restaurant.RestaurantFrontEnd.OrderViewerStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    connector StagingMenuItem is {
      from outlet Restaurant.RestaurantFrontEnd.MenuItemRequests.Staged to inlet Restaurant.RestaurantFrontEnd.MenuItemStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    connector StagingMenu is {
      from outlet Restaurant.RestaurantFrontEnd.MenuRequests.Staged to inlet Restaurant.RestaurantFrontEnd.MenuStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    connector StagingLoyaltyAccount is {
      from outlet Restaurant.RestaurantFrontEnd.LoyaltyAccountRequests.Staged to inlet Restaurant.RestaurantFrontEnd.LoyaltyAccountStaged
    } with {
      briefly as "Carries front-end requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    handler RestaurantFrontEndBoundary is {
      on registerCustomer: command Restaurant.Customers.Customer.RegisterCustomer {
        send registerCustomer to outlet Restaurant.RestaurantFrontEnd.CustomerSubmissions
      }
      on addTable: command Restaurant.Tables.Table.AddTable {
        send addTable to outlet Restaurant.RestaurantFrontEnd.TableSubmissions
      }
      on addServer: command Restaurant.Servers.Server.AddServer {
        send addServer to outlet Restaurant.RestaurantFrontEnd.ServerSubmissions
      }
      on openLocation: command Restaurant.Locations.Location.OpenLocation {
        send openLocation to outlet Restaurant.RestaurantFrontEnd.LocationSubmissions
      }
      on placeOrder: command Restaurant.Orders.Order.PlaceOrder {
        send placeOrder to outlet Restaurant.RestaurantFrontEnd.OrderSubmissions
      }
      on pay: command Restaurant.Payments.Payment.Pay {
        send pay to outlet Restaurant.RestaurantFrontEnd.PaymentSubmissions
      }
      on bookTable: command Restaurant.Reservations.Reservation.BookTable {
        send bookTable to outlet Restaurant.RestaurantFrontEnd.ReservationSubmissions
      }
      on showOrders: command Restaurant.Kitchen.OrderViewer.ShowOrders {
        send showOrders to outlet Restaurant.RestaurantFrontEnd.OrderViewerSubmissions
      }
      on addMenuItem: command Restaurant.Menus.MenuItem.AddMenuItem {
        send addMenuItem to outlet Restaurant.RestaurantFrontEnd.MenuItemSubmissions
      }
      on composeMenu: command Restaurant.Menus.Menu.ComposeMenu {
        send composeMenu to outlet Restaurant.RestaurantFrontEnd.MenuSubmissions
      }
      on accruePoints: command Restaurant.Loyalty.LoyaltyAccount.AccruePoints {
        send accruePoints to outlet Restaurant.RestaurantFrontEnd.LoyaltyAccountSubmissions
      }
    } with {
      briefly as "Republishes staged requests on the context's own outlets"
      described as {
        |The front end's internals stay private; peers see only these outlets.
      }
    }

    processor CustomerRequests as source is {
      outlet Staged is command Restaurant.Customers.Customer.RegisterCustomer with {
        briefly as "Where customer requests leave the front end"
        described as {
          |Requests reach the Customers context over a domain-scoped connector.
        }
      }
      handler CustomerRequestsHandler is {
        on command Restaurant.Customers.Customer.RegisterCustomer {
          send command Restaurant.Customers.Customer.RegisterCustomer(
            id = prompt("the id carried by RegisterCustomer"),
            name = prompt("the name carried by RegisterCustomer"),
            phone = prompt("the phone carried by RegisterCustomer")
          ) to outlet Restaurant.RestaurantFrontEnd.CustomerRequests.Staged
        }
        on other {
          do "ignore requests that are not about customers"
        }
      } with {
        briefly as "Forwards customer requests into the domain"
        described as {
          |Runs when a caller asks for a customer change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Customers"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor TableRequests as source is {
      outlet Staged is command Restaurant.Tables.Table.AddTable with {
        briefly as "Where table requests leave the front end"
        described as {
          |Requests reach the Tables context over a domain-scoped connector.
        }
      }
      handler TableRequestsHandler is {
        on command Restaurant.Tables.Table.AddTable {
          send command Restaurant.Tables.Table.AddTable(
            id = prompt("the id carried by AddTable"),
            seats = prompt("the seats carried by AddTable"),
            section = prompt("the section carried by AddTable")
          ) to outlet Restaurant.RestaurantFrontEnd.TableRequests.Staged
        }
        on other {
          do "ignore requests that are not about tables"
        }
      } with {
        briefly as "Forwards table requests into the domain"
        described as {
          |Runs when a caller asks for a table change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Tables"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor ServerRequests as source is {
      outlet Staged is command Restaurant.Servers.Server.AddServer with {
        briefly as "Where server requests leave the front end"
        described as {
          |Requests reach the Servers context over a domain-scoped connector.
        }
      }
      handler ServerRequestsHandler is {
        on command Restaurant.Servers.Server.AddServer {
          send command Restaurant.Servers.Server.AddServer(
            id = prompt("the id carried by AddServer"),
            name = prompt("the name carried by AddServer"),
            section = prompt("the section carried by AddServer")
          ) to outlet Restaurant.RestaurantFrontEnd.ServerRequests.Staged
        }
        on other {
          do "ignore requests that are not about servers"
        }
      } with {
        briefly as "Forwards server requests into the domain"
        described as {
          |Runs when a caller asks for a server change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Servers"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor LocationRequests as source is {
      outlet Staged is command Restaurant.Locations.Location.OpenLocation with {
        briefly as "Where location requests leave the front end"
        described as {
          |Requests reach the Locations context over a domain-scoped connector.
        }
      }
      handler LocationRequestsHandler is {
        on command Restaurant.Locations.Location.OpenLocation {
          send command Restaurant.Locations.Location.OpenLocation(
            id = prompt("the id carried by OpenLocation"),
            name = prompt("the name carried by OpenLocation"),
            city = prompt("the city carried by OpenLocation")
          ) to outlet Restaurant.RestaurantFrontEnd.LocationRequests.Staged
        }
        on other {
          do "ignore requests that are not about locations"
        }
      } with {
        briefly as "Forwards location requests into the domain"
        described as {
          |Runs when a caller asks for a location change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Locations"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor OrderRequests as source is {
      outlet Staged is command Restaurant.Orders.Order.PlaceOrder with {
        briefly as "Where order requests leave the front end"
        described as {
          |Requests reach the Orders context over a domain-scoped connector.
        }
      }
      handler OrderRequestsHandler is {
        on command Restaurant.Orders.Order.PlaceOrder {
          send command Restaurant.Orders.Order.PlaceOrder(
            id = prompt("the id carried by PlaceOrder"),
            customerName = prompt("the customerName carried by PlaceOrder"),
            total = prompt("the total carried by PlaceOrder")
          ) to outlet Restaurant.RestaurantFrontEnd.OrderRequests.Staged
        }
        on other {
          do "ignore requests that are not about orders"
        }
      } with {
        briefly as "Forwards order requests into the domain"
        described as {
          |Runs when a caller asks for a order change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Orders"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor PaymentRequests as source is {
      outlet Staged is command Restaurant.Payments.Payment.Pay with {
        briefly as "Where payment requests leave the front end"
        described as {
          |Requests reach the Payments context over a domain-scoped connector.
        }
      }
      handler PaymentRequestsHandler is {
        on command Restaurant.Payments.Payment.Pay {
          send command Restaurant.Payments.Payment.Pay(
            id = prompt("the id carried by Pay"),
            orderAmount = prompt("the orderAmount carried by Pay"),
            tipAmount = prompt("the tipAmount carried by Pay"),
            cardToken = prompt("the cardToken carried by Pay")
          ) to outlet Restaurant.RestaurantFrontEnd.PaymentRequests.Staged
        }
        on other {
          do "ignore requests that are not about payments"
        }
      } with {
        briefly as "Forwards payment requests into the domain"
        described as {
          |Runs when a caller asks for a payment change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Payments"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor ReservationRequests as source is {
      outlet Staged is command Restaurant.Reservations.Reservation.BookTable with {
        briefly as "Where reservation requests leave the front end"
        described as {
          |Requests reach the Reservations context over a domain-scoped connector.
        }
      }
      handler ReservationRequestsHandler is {
        on command Restaurant.Reservations.Reservation.BookTable {
          send command Restaurant.Reservations.Reservation.BookTable(
            id = prompt("the id carried by BookTable"),
            partyName = prompt("the partyName carried by BookTable"),
            phoneNumber = prompt("the phoneNumber carried by BookTable"),
            time = prompt("the time carried by BookTable"),
            date = prompt("the date carried by BookTable")
          ) to outlet Restaurant.RestaurantFrontEnd.ReservationRequests.Staged
        }
        on other {
          do "ignore requests that are not about reservations"
        }
      } with {
        briefly as "Forwards reservation requests into the domain"
        described as {
          |Runs when a caller asks for a reservation change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Reservations"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor OrderViewerRequests as source is {
      outlet Staged is command Restaurant.Kitchen.OrderViewer.ShowOrders with {
        briefly as "Where orderviewer requests leave the front end"
        described as {
          |Requests reach the Kitchen context over a domain-scoped connector.
        }
      }
      handler OrderViewerRequestsHandler is {
        on command Restaurant.Kitchen.OrderViewer.ShowOrders {
          send command Restaurant.Kitchen.OrderViewer.ShowOrders(
            id = prompt("the id carried by ShowOrders"),
            viewType = prompt("the viewType carried by ShowOrders"),
            station = prompt("the station carried by ShowOrders")
          ) to outlet Restaurant.RestaurantFrontEnd.OrderViewerRequests.Staged
        }
        on other {
          do "ignore requests that are not about orderviewers"
        }
      } with {
        briefly as "Forwards orderviewer requests into the domain"
        described as {
          |Runs when a caller asks for a orderviewer change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Kitchen"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor MenuItemRequests as source is {
      outlet Staged is command Restaurant.Menus.MenuItem.AddMenuItem with {
        briefly as "Where menuitem requests leave the front end"
        described as {
          |Requests reach the Menus context over a domain-scoped connector.
        }
      }
      handler MenuItemRequestsHandler is {
        on command Restaurant.Menus.MenuItem.AddMenuItem {
          send command Restaurant.Menus.MenuItem.AddMenuItem(
            id = prompt("the id carried by AddMenuItem"),
            name = prompt("the name carried by AddMenuItem"),
            description = prompt("the description carried by AddMenuItem"),
            price = prompt("the price carried by AddMenuItem")
          ) to outlet Restaurant.RestaurantFrontEnd.MenuItemRequests.Staged
        }
        on other {
          do "ignore requests that are not about menuitems"
        }
      } with {
        briefly as "Forwards menuitem requests into the domain"
        described as {
          |Runs when a caller asks for a menuitem change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Menus"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor MenuRequests as source is {
      outlet Staged is command Restaurant.Menus.Menu.ComposeMenu with {
        briefly as "Where menu requests leave the front end"
        described as {
          |Requests reach the Menus context over a domain-scoped connector.
        }
      }
      handler MenuRequestsHandler is {
        on command Restaurant.Menus.Menu.ComposeMenu {
          send command Restaurant.Menus.Menu.ComposeMenu(
            id = prompt("the id carried by ComposeMenu"),
            title = prompt("the title carried by ComposeMenu"),
            season = prompt("the season carried by ComposeMenu")
          ) to outlet Restaurant.RestaurantFrontEnd.MenuRequests.Staged
        }
        on other {
          do "ignore requests that are not about menus"
        }
      } with {
        briefly as "Forwards menu requests into the domain"
        described as {
          |Runs when a caller asks for a menu change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Menus"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor LoyaltyAccountRequests as source is {
      outlet Staged is command Restaurant.Loyalty.LoyaltyAccount.AccruePoints with {
        briefly as "Where loyaltyaccount requests leave the front end"
        described as {
          |Requests reach the Loyalty context over a domain-scoped connector.
        }
      }
      handler LoyaltyAccountRequestsHandler is {
        on command Restaurant.Loyalty.LoyaltyAccount.AccruePoints {
          send command Restaurant.Loyalty.LoyaltyAccount.AccruePoints(
            id = prompt("the id carried by AccruePoints"),
            points = prompt("the points carried by AccruePoints"),
            accrualRate = prompt("the accrualRate carried by AccruePoints"),
            redemptionRate = prompt("the redemptionRate carried by AccruePoints")
          ) to outlet Restaurant.RestaurantFrontEnd.LoyaltyAccountRequests.Staged
        }
        on other {
          do "ignore requests that are not about loyaltyaccounts"
        }
      } with {
        briefly as "Forwards loyaltyaccount requests into the domain"
        described as {
          |Runs when a caller asks for a loyaltyaccount change.
        }
      }
    } with {
      briefly as "The front end's outbound path to Loyalty"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

  } with {
    briefly as "Where staff and diners reach the restaurant systems"
    described as {
      |The point-of-sale terminals, the kitchen display and the booking site
      |all sit outside this model. This context stands in for them, giving
      |every context's sink something upstream to receive from.
    }
  }

  persistent connector CustomerRequests is {
    from outlet Restaurant.RestaurantFrontEnd.CustomerSubmissions
    to inlet Restaurant.Customers.CustomerIn
  } with {
    briefly as "Carries customer requests from the front end to Customers"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector TableRequests is {
    from outlet Restaurant.RestaurantFrontEnd.TableSubmissions
    to inlet Restaurant.Tables.TableIn
  } with {
    briefly as "Carries table requests from the front end to Tables"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector ServerRequests is {
    from outlet Restaurant.RestaurantFrontEnd.ServerSubmissions
    to inlet Restaurant.Servers.ServerIn
  } with {
    briefly as "Carries server requests from the front end to Servers"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector LocationRequests is {
    from outlet Restaurant.RestaurantFrontEnd.LocationSubmissions
    to inlet Restaurant.Locations.LocationIn
  } with {
    briefly as "Carries location requests from the front end to Locations"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector OrderRequests is {
    from outlet Restaurant.RestaurantFrontEnd.OrderSubmissions
    to inlet Restaurant.Orders.OrderIn
  } with {
    briefly as "Carries order requests from the front end to Orders"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector PaymentRequests is {
    from outlet Restaurant.RestaurantFrontEnd.PaymentSubmissions
    to inlet Restaurant.Payments.PaymentIn
  } with {
    briefly as "Carries payment requests from the front end to Payments"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector ReservationRequests is {
    from outlet Restaurant.RestaurantFrontEnd.ReservationSubmissions
    to inlet Restaurant.Reservations.ReservationIn
  } with {
    briefly as "Carries reservation requests from the front end to Reservations"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector OrderViewerRequests is {
    from outlet Restaurant.RestaurantFrontEnd.OrderViewerSubmissions
    to inlet Restaurant.Kitchen.OrderViewerIn
  } with {
    briefly as "Carries orderviewer requests from the front end to Kitchen"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector MenuItemRequests is {
    from outlet Restaurant.RestaurantFrontEnd.MenuItemSubmissions
    to inlet Restaurant.Menus.MenuItemIn
  } with {
    briefly as "Carries menuitem requests from the front end to Menus"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector MenuRequests is {
    from outlet Restaurant.RestaurantFrontEnd.MenuSubmissions
    to inlet Restaurant.Menus.MenuIn
  } with {
    briefly as "Carries menu requests from the front end to Menus"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector LoyaltyAccountRequests is {
    from outlet Restaurant.RestaurantFrontEnd.LoyaltyAccountSubmissions
    to inlet Restaurant.Loyalty.LoyaltyAccountIn
  } with {
    briefly as "Carries loyaltyaccount requests from the front end to Loyalty"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

} with {
  briefly as "One restaurant location and everything that happens in it"
  described as {
    |This subdomain pertains to all processes and data associated with a
    |single restaurant location. It includes several bounded contexts, as
    |noted by the include statements above.
    |
    |Entity identifiers used to be declared here, at domain level, to make
    |them ubiquitous. RIDDL 2.0 flags a type used by an entity but declared
    |outside its context, so each context now owns its own identifier type
    |and the contexts exchange messages rather than sharing types.
  }
}
