context ToDoList as flow is {

  inlet ItemIn is command ToDoItem.AddItem with {
    briefly as "Where item commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet ItemDispatch is command ToDoItem.AddItem with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  inlet Failures is record Riddl.GeneratorError with {
    option error-sink
    briefly as "Where hard errors go"
    described as {
      |RIDDL 2.0 wants every domain to name a destination for failures no
      |handler can recover from. An error-sink inlet is infrastructure
      |rather than dataflow, so it does not count toward this processor's
      |arity.
    }
  }

  handler ToDoListBoundary is {
    on request: command ToDoItem.AddItem {
      send request to outlet ReactiveSummit.ToDoList.ItemDispatch
    }
    on other {
      error "unexpected message at the ToDoList boundary"
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }

  type ItemId is Id(ReactiveSummit.ToDoList.ToDoItem) with {
    briefly as "Unique identifier for one to-do item"
    described as {
      |Identifies a single item on an attendee's list. Defined inside this
      |context because the items are its concern.
    }
  }

  record ItemContent is {
    itemId is ItemId,
    itemDescription is String,
    expectedCompletion is TimeStamp?
  } with {
    briefly as "What a to-do item says"
    described as {
      |The description an attendee wrote and, optionally, when they expect
      |to be finished with it.
    }
  }

  entity ToDoItem as flow is {

    inlet ItemCommands is command ToDoItem.AddItem with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet ItemEvents is type ItemEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command AddItem is {
      toDoItemId is Id(ToDoItem),
      content is ItemContent
    } with {
      briefly as "Ask for a new item to be put on the list"
      described as {
        |Sent when an attendee writes down something to do.
      }
    }

    command CompleteItem is {
      itemId is ItemId
    } with {
      briefly as "Mark an item as finished"
      described as {
        |Sent when an attendee ticks an item off.
      }
    }

    query WhichItem replies result TheItem is {
      itemId is ItemId
    } with {
      briefly as "Ask for the current state of one item"
      described as {
        |Sent when a reader wants to see an item they already know of.
      }
    }

    result TheItem is {
      itemId is ItemId,
      itemDescription is String
    } with {
      briefly as "The answer to a WhichItem query"
      described as {
        |Carries the identity and description of the requested item.
      }
    }

    event ItemAdded is {
      content is ItemContent
    } with {
      briefly as "An item joined the list"
      described as {
        |Emitted once a new item has been recorded.
      }
    }

    event ItemCompleted is {
      itemId is ItemId
    } with {
      briefly as "An item was finished"
      described as {
        |Emitted once an item has moved to the Completed state.
      }
    }

    record ActiveState is {
      content is ItemContent,
      createdAt is TimeStamp
    } with {
      briefly as "The state of an item still to be done"
      described as {
        |What the item says and when it was written down.
      }
    }

    record CompletedState is {
      content is ItemContent,
      createdAt is TimeStamp,
      completedAt is TimeStamp
    } with {
      briefly as "The state of an item already done"
      described as {
        |As ActiveState, plus when the attendee finished it.
      }
    }

    initial state Active of record ActiveState with {
      briefly as "Where an item begins"
      described as {
        |Every item starts active and stays so until completed.
      }
    }

    state Completed of record CompletedState with {
      briefly as "Where an item ends"
      described as {
        |An item becomes completed once and does not return.
      }
    }

    handler InputHandler is {
      on init {
        set field ActiveState.createdAt to "the moment the item was written"
      }
      on command AddItem {
        morph entity ToDoItem to state Active with record ActiveState(
          content = prompt("the content of the resulting ToDoItem state"),
          createdAt = prompt("the createdAt of the resulting ToDoItem state")
        )
        send event ItemAdded(
          content = prompt("the content carried by ItemAdded")
        ) to outlet ReactiveSummit.ToDoList.ToDoItem.ItemEvents
      }
      on command CompleteItem {
        morph entity ToDoItem to state Completed with record CompletedState(
          content = prompt("the content of the resulting ToDoItem state"),
          createdAt = prompt("the createdAt of the resulting ToDoItem state"),
          completedAt = prompt("the completedAt of the resulting ToDoItem state")
        )
        send event ItemCompleted(
          itemId = prompt("the itemId carried by ItemCompleted")
        ) to outlet ReactiveSummit.ToDoList.ToDoItem.ItemEvents
      }
      on query WhichItem {
        reply result TheItem(
          itemId = prompt("the itemId carried by TheItem"),
          itemDescription = prompt("the itemDescription carried by TheItem")
        )
      }
    } with {
      briefly as "Handles messages addressed to a to-do item"
      described as {
        |Adds items, completes them, and answers questions about them.
      }
    }

  } with {
    briefly as "A single thing an attendee means to do"
    described as {
      |The ToDoItem entity moves once, from Active to Completed, and is
      |readable at any point along the way.
    }
  }

  type ItemEvent is one of {
    event ToDoItem.ItemAdded or event ToDoItem.ItemCompleted
  } with {
    briefly as "Anything this context announces about its items"
    described as {
      |The alternation of every event the context publishes, so one outlet
      |can carry them all.
    }
  }



  repository Items as sink is {
    command PersistItemAdded is {
      content is ItemContent
    } with {
      briefly as "Apply ItemAdded to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    command PersistItemCompleted is {
      itemId is ItemId
    } with {
      briefly as "Apply ItemCompleted to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    type ItemsCommand is one of { command PersistItemAdded or command PersistItemCompleted } with {
      briefly as "Anything this store can be told to do"
      described as {
        |One alternation so a single inlet and connector carry them all.
      }
    }

    inlet Recorded is type ReactiveSummit.ToDoList.Items.ItemsCommand with {
      briefly as "Where item persistence commands arrive"
      described as {
        |A projector turns each item event into one of these.
      }
    }
    schema Store is flat
      of Held as record ReactiveSummit.ToDoList.ItemProjection.Projected
    with {
      briefly as "How items are laid out in storage"
      described as {
        |A flat schema: one stored row per item.
      }
    }
    handler StoreHandler is {
      on command ReactiveSummit.ToDoList.Items.PersistItemAdded {
        do "apply what PersistItemAdded carries to the stored row"
      }
      on command RecordView {
        do "apply the refreshed row the command carries to the store"
      }
      on command ReactiveSummit.ToDoList.Items.PersistItemCompleted {
        do "apply what PersistItemCompleted carries to the stored row"
      }
    } with {
      briefly as "Keeps storage in step with what happened"
      described as {
        |Writes each item event into the store.
      }
    }
  } with {
    briefly as "Persists the items of this context"
    described as {
      |Entities are stateful, so ToDoList keeps a repository in which their
      |state outlives any single process.
    }
  }

  projector ToDoItems is {
    updates repository Items
    record ItemView is {
      itemDescription is String,
      done is Boolean
    } with {
      briefly as "The read model of one item"
      described as {
        |What a list needs in order to draw a row: the text, and whether it
        |has been ticked off.
      }
    }
    command RecordView is {
      view is ItemView
    } with {
      briefly as "Hand a refreshed row to the repository"
      described as {
        |Carries the projected view so it can be persisted. This also gives
        |ItemView a use as a field type rather than only as a path.
      }
    }
    handler ProjectionHandler is {
      on event ToDoItem.ItemAdded {
        set field ItemView.done to "false"
        tell command RecordView(view = prompt("the view carried by RecordView")) to repository Items
      }
      on event ToDoItem.ItemCompleted {
        set field ItemView.done to "true"
        tell command RecordView(view = prompt("the view carried by RecordView")) to repository Items
      }
    } with {
      briefly as "Keeps the read model in step with the events"
      described as {
        |A projector is event-only in RIDDL 2.0; it may not take commands or
        |queries.
      }
    }
  } with {
    briefly as "The read model of the attendee's list"
    described as {
      |Projects item events into a shape the application can display without
      |querying each entity in turn.
    }
  }

  connector ErrorReporting is {
    from outlet Riddl.ForeverEmpty.void to inlet ReactiveSummit.ToDoList.Failures
  } with {
    briefly as "Terminates the error-sink inlet"
    described as {
      |Nothing in this model produces a GeneratorError — those come from
      |generators at runtime, not from anything the model declares. The
      |predefined ForeverEmpty source exists for exactly this: a port that
      |must be connected but has no modelled producer.
    }
  }

  connector AddressingItem is {
    from outlet ReactiveSummit.ToDoList.ItemDispatch
    to inlet ReactiveSummit.ToDoList.ToDoItem.ItemCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  projector ItemProjection as flow is {
    inlet Observed is type ReactiveSummit.ToDoList.ItemEvent with {
      briefly as "Where item events are observed"
      described as {
        |The projector sees what was announced.
      }
    }

    outlet Persisting is type ReactiveSummit.ToDoList.Items.ItemsCommand with {
      briefly as "Where persistence commands leave for the store"
      described as {
        |Turning each event into a command is the projector's whole job.
      }
    }

    updates repository ReactiveSummit.ToDoList.Items

    record Projected is {
      content is ItemContent
    } with {
      briefly as "The shape this projection maintains"
      described as {
        |One projected row per item. The store holds exactly this.
      }
    }

    handler ItemProjectionHandler is {
      on itemAdded: event ReactiveSummit.ToDoList.ToDoItem.ItemAdded {
        tell command ReactiveSummit.ToDoList.Items.PersistItemAdded(
          content = itemAdded.content
        ) to repository ReactiveSummit.ToDoList.Items
      }
      on itemCompleted: event ReactiveSummit.ToDoList.ToDoItem.ItemCompleted {
        tell command ReactiveSummit.ToDoList.Items.PersistItemCompleted(
          itemId = itemCompleted.itemId
        ) to repository ReactiveSummit.ToDoList.Items
      }
    } with {
      briefly as "Turns item events into persistence commands"
      described as {
        |A repository is changed by commands, so something must translate.
      }
    }
  } with {
    briefly as "Projects item events into the store"
    described as {
      |Stands between what was announced and what the store is told.
    }
  }

  connector ObservingItemProjection is {
    from outlet ReactiveSummit.ToDoList.ToDoItem.ItemEvents to inlet ReactiveSummit.ToDoList.ItemProjection.Observed
  } with {
    briefly as "Carries item events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector Recording is {
    from outlet ReactiveSummit.ToDoList.ItemProjection.Persisting to inlet Items.Recorded
  } with {
    briefly as "Carries item events to storage"
    described as {
      |Connects what the context announces to the repository that records
      |it.
    }
  }

} with {
  briefly as "Owns the attendees' to-do items"
  described as {
    |The ToDoList context is responsible for the items themselves: adding
    |them, completing them, and remembering them. It does not talk to
    |users; the ToDoListUI application does that.
  }
}
