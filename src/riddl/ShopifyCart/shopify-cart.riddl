domain ShopifyCart is {
  author Claude is {
    name is "Anthropic Claude"
    email is "support@anthropic.com"
  } with {
    briefly as "The author of this example model"
    described as {
      |Written with Claude, Anthropic's assistant, as an exercise in
      |modelling a familiar e-commerce domain in RIDDL.
    }
  }

  // Define Boolean type for UI components
  type Bool is Boolean with {
    briefly as "Boolean type for UI components"
    described by {
      | A wrapper for the predefined Boolean type, used in UI components.
    }
  }

  type CartId is UUID  with {
    briefly as "Unique identifier for shopping carts"
    described by {
      | A UUID used to uniquely identify each shopping cart in the system.
      | This identifier persists throughout the shopping and checkout process.
    }
  }

  type InventoryStatus is any of {
    InStock
    LowStock
    OutOfStock
    Discontinued
  }  with {
    briefly as "Possible states of product inventory"
    described by {
      | Defines the possible states for product inventory:
      | - InStock: Product is available with adequate inventory
      | - LowStock: Product is available but inventory is running low
      | - OutOfStock: Product is temporarily unavailable
      | - Discontinued: Product is permanently unavailable
    }
  }

  type ProductId is UUID  with {
    briefly as "Unique identifier for products"
    described by {
      | A UUID used to uniquely identify each product in the catalog.
    }
  }

  type SKU is Pattern("^[A-Z0-9]{6,10}$")  with {
    briefly as "Stock Keeping Unit identifier"
    described by {
      | Alphanumeric identifier consisting of 6-10 characters that uniquely
      | identifies a product variant in the inventory system.
    }
  }

  type Price is Decimal(10, 2)
  with {
    briefly as "Monetary value with two decimal places"
    described by {
      | Represents monetary amounts with up to 10 digits before the decimal point
      | and exactly 2 digits after. Supports values from $0.00 to $9,999,999,999.99.
    }
  }

  type Quantity is Integer
  with {
    briefly as "Count of items"
    described by {
      | Represents a non-negative whole number quantity of items.
    }
  }

  type Email is Pattern("^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$")
  with {
    briefly as "Email address format"
    described by {
      | Represents an email address in standard format, used for customer identification
      | and communications.
    }
  }

  type Name is String(1, 100)  with {
    briefly as "Person or product name"
    described by {
      | A string between 1 and 100 characters representing a name.
      | Used for product names and customer names.
    }
  }

  type Address is {
    street1 is String
    street2 is String
    city is String
    state is String
    zipCode is String
    country is String
  }
  with {
    briefly as "Physical mailing address"
    described by {
      | Represents a physical address with standard components
      | used for shipping and billing purposes.
    }
  }

  // Commands hoisted to domain scope: they are sent across the
  // UserInterface -> ShoppingContext seam, so RIDDL 2.0 requires them to be
  // declared in a domain ancestral to both contexts.
  command UpdateProductPrice is {
    id is Id(Product),
    productId is ProductId
    newPrice is Price
  }
  with {
    briefly as "Command to change a product's price"
    described by {
      | Updates the price of a specific product identified by productId.
      | The new price must be a positive value.
    }
  }

  command UpdateInventory is {
    id is Id(Product),
    productId is ProductId
    newQuantity is Quantity
  }
  with {
    briefly as "Command to update product inventory quantity"
    described by {
      | Updates the available quantity of a specific product.
      | Also automatically updates the inventory status based on quantity thresholds.
    }
  }

  command AddToCart is {
    id is Id(Cart),
    cartId is CartId
    productId is ProductId
    quantity is Quantity
  }
  with {
    briefly as "Command to add a product to the cart"
    described by {
      | Adds a specified quantity of a product to a cart.
      | Validates that the product exists and is in stock.
      | Recalculates cart totals after adding the item.
    }
  }

  command RemoveFromCart is {
    id is Id(Cart),
    cartId is CartId
    productId is ProductId
  }
  with {
    briefly as "Command to remove a product from the cart"
    described by {
      | Removes all instances of a specified product from the cart.
      | Recalculates cart totals after removal.
    }
  }

  command UpdateQuantity is {
    id is Id(Cart),
    cartId is CartId
    productId is ProductId
    quantity is Quantity
  }
  with {
    briefly as "Command to update product quantity in the cart"
    described by {
      | Changes the quantity of a specific product in the cart.
      | If quantity is zero, the item is removed completely.
      | Recalculates cart totals after the update.
    }
  }

  command InitiateCheckout is {
    id is Id(Checkout),
    cartId is CartId
    customerEmail is Email
    customerName is Name
    shippingAddress is Address
    billingAddress is Address
  }
  with {
    briefly as "Command to begin the checkout process"
    described by {
      | Starts the checkout process for a specific cart.
      | Collects customer information and addresses needed for shipping and billing.
    }
  }

  command SelectPaymentMethod is {
    id is Id(Checkout),
    cartId is CartId
    paymentType is String
    paymentDetails is String
  }
  with {
    briefly as "Command to select and save payment method"
    described by {
      | Associates a payment method with an ongoing checkout.
      | Payment details are tokenized for security.
    }
  }

  command CompleteCheckout is {
    id is Id(Checkout),
    cartId is CartId
  }
  with {
    briefly as "Command to finalize the purchase"
    described by {
      | Completes the checkout process by processing payment, creating an order,
      | and clearing the cart. Requires that a valid cart with items exists and
      | that a payment method has been selected.
    }
  }

  context ShoppingContext is {
    // Product Record Type for State
    record ProductRecord is {
      productId is ProductId
      sku is SKU
      name is Name
      description is String
      price: Price
      inventory is {
        quantity is Quantity with {
          briefly as "Product inventory count"
          described by {
            | The number of units available in inventory for the product.
          }
        }
        status is InventoryStatus with {
          briefly as "Current inventory status"
          described by {
            | The availability status of the product based on quantity thresholds.
          }
        }
      }
    }
    with {
      briefly as "Record type containing product data"
      described by {
        | Defines the structure of product data including identification, pricing,
        | and inventory information.
      }
    }

    // Product Entity
    entity Product is {


      query WhichProduct is {
        id is ProductIdentity
      } with {
        briefly as "Ask for the current state of one product"
        described as {
          |Sent when a reader wants a product they already know of.
        }
      }

      result TheProduct is {
        id is ProductIdentity,
        summary is String
      } with {
        briefly as "The answer to a WhichProduct query"
        described as {
          |Carries the identity and a short summary.
        }
      }


      state ProductData of record ProductRecord with {
        briefly as "Product state containing all product information"
        described by {
          | Contains the complete product information including identification,
          | pricing, and inventory status. This state is modified by price updates
          | and inventory changes.
        }
      }

      // Commands

      command CreateProduct is {
        id is Id(Product),
        sku is SKU
        name is Name
        price is Price
      }
      with {
        briefly as "Command to add a new product to the catalogue"
        described by {
          | Creates a product in the catalogue. Unlike price and inventory
          | updates, this originates inside ShoppingContext rather than being
          | sent in from UserInterface, so it crosses no context seam and is
          | declared here, on the entity that owns it.
        }
      }



      // Events
      event ProductCreated is {
        id is Id(Product),
        productId is ProductId
      }
      with {
        briefly as "Event indicating a product joined the catalogue"
        described by {
          | Emitted once a new product has been accepted into the catalogue.
        }
      }

      event ProductPriceUpdated is {
        id is Id(Product),
        productId is ProductId
        oldPrice is Price
        newPrice is Price
      }
      with {
        briefly as "Event indicating a product price change"
        described by {
          | Emitted when a product's price is successfully updated.
          | Contains both old and new prices for auditing and UI updates.
        }
      }

      event InventoryUpdated is {
        id is Id(Product),
        productId is ProductId
        oldQuantity is Quantity
        newQuantity is Quantity
        newStatus is InventoryStatus
      }
      with {
        briefly as "Event indicating inventory quantity and status changes"
        described by {
          | Emitted when a product's inventory level changes.
          | Includes both the quantity change and the resulting inventory status.
        }
      }

      // Handler for processing commands
      handler ProductCommandHandler is {
        on query WhichProduct {
          reply result TheProduct(
            id = prompt("the id carried by TheProduct"),
            summary = prompt("the summary carried by TheProduct")
          )
        }

        on init {
          set field ProductRecord.productId to "a freshly minted product identifier"
        }

        // FIXED: Ambiguous reference by using fully qualified path
        on command ShopifyCart.UpdateProductPrice is {
          // Validate the price change. The two outcomes are one decision, so
          // they are one when/else: a command must either record what happened
          // or refuse, on every path.
          when prompt("newPrice > 0") then
            // Update the product price in the ProductData state
            morph entity Product to state ProductData with record ProductRecord(
              productId = prompt("the productId of the resulting ShoppingContext state"),
              sku = prompt("the sku of the resulting ShoppingContext state"),
              name = prompt("the name of the resulting ShoppingContext state"),
              description = prompt("the description of the resulting ShoppingContext state"),
              price = prompt("the price of the resulting ShoppingContext state"),
              inventory = prompt("the inventory of the resulting ShoppingContext state")
            )
            // Emit event
            tell event ProductPriceUpdated(
              id = prompt("the id carried by ProductPriceUpdated"),
              productId = prompt("the productId carried by ProductPriceUpdated"),
              oldPrice = prompt("the oldPrice carried by ProductPriceUpdated"),
              newPrice = prompt("the newPrice carried by ProductPriceUpdated")
            ) to entity Product
          else
            error "Price must be greater than zero"
          end
        }

        // FIXED: Ambiguous reference by using fully qualified path
        on command ShopifyCart.UpdateInventory is {
          // Determine new inventory status based on quantity
          // Update product with new inventory data
          morph entity Product to state ProductData with record ProductRecord(
            productId = prompt("the productId of the resulting ShoppingContext state"),
            sku = prompt("the sku of the resulting ShoppingContext state"),
            name = prompt("the name of the resulting ShoppingContext state"),
            description = prompt("the description of the resulting ShoppingContext state"),
            price = prompt("the price of the resulting ShoppingContext state"),
            inventory = prompt("the inventory of the resulting ShoppingContext state")
          )
          // Emit event
          tell event InventoryUpdated(
            id = prompt("the id carried by InventoryUpdated"),
            productId = prompt("the productId carried by InventoryUpdated"),
            oldQuantity = prompt("the oldQuantity carried by InventoryUpdated"),
            newQuantity = prompt("the newQuantity carried by InventoryUpdated"),
            newStatus = prompt("the newStatus carried by InventoryUpdated")
          ) to entity Product
        }

        on command CreateProduct is {
          // A creation command either records the new product or refuses it.
          // Both outcomes are covered, so every path discharges.
          when prompt("the sku is well formed and not already in the catalogue") then
            tell event ProductCreated(
              id = prompt("the id carried by ProductCreated"),
              productId = prompt("the productId carried by ProductCreated")
            ) to entity Product
          else
            error "Cannot create product"
          end
        }

      }
      with {
        briefly as "Processes commands for product management"
        described by {
          | Handles commands related to product information and inventory management.
          | Validates input data, updates product state, and emits relevant events.
        }
      }
    }
    with {
      briefly as "Represents a purchasable item in the store"
      described by {
        | The Product entity represents items that can be purchased in the store.
        | It contains all product attributes such as name, price, and SKU,
        | as well as inventory information. Products respond to commands for
        | updating price and inventory levels.
      }
    }

    // Cart Item Record
    type CartItem is {
      productId is ProductId
      sku is SKU
      name is Name
      price: Price
      quantity is Quantity
      totalPrice is Price
    }
    with {
      briefly as "Record type for items in a cart"
      described by {
        | Defines the structure of an item in a shopping cart, including
        | product details, quantity, and calculated price.
      }
    }

    // Cart Record
    record CartRecord is {
      cartId is CartId
      items is many CartItem
      subtotal is Price
      taxes is Price
      shipping is Price
      discount is Price
      total is Price
    }
    with {
      briefly as "Record type containing cart data"
      described by {
        | Defines the complete structure of a shopping cart including
        | all items and calculated totals.
      }
    }

    // Cart Entity
    entity Cart is {


      query WhichCart is {
        id is CartIdentity
      } with {
        briefly as "Ask for the current state of one cart"
        described as {
          |Sent when a reader wants a cart they already know of.
        }
      }

      result TheCart is {
        id is CartIdentity,
        summary is String
      } with {
        briefly as "The answer to a WhichCart query"
        described as {
          |Carries the identity and a short summary.
        }
      }

      state CartData of record CartRecord with {
        briefly as "Shopping cart state containing all cart information"
        described by {
          | Contains the complete shopping cart information including all items,
          | quantities, and calculated totals. This state is modified whenever
          | items are added, removed, or quantities are changed.
        }
      }

      // Helper functions for cart operations
      record AppendItemToCartInput is {
        items is many CartItem,
        productId is ProductId,
        quantity is Quantity
      } with {
        briefly as "What appendItemToCart needs to do its work"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      record AppendItemToCartOutput is {
        items is many CartItem
      } with {
        briefly as "What appendItemToCart produces"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      function appendItemToCart is {
        requires record AppendItemToCartInput
        returns record AppendItemToCartOutput
        do "Add item to cart or update quantity if already exists"
      } with {
        briefly as "Adds a product to cart or updates quantity if already present"
        described by {
          | Adds the specified product and quantity to the cart. If the product
          | already exists in the cart, its quantity is increased. Also updates
          | the total price of the item based on the new quantity.
        }
      }

      record CalculateSubtotalInput is {
        items is many CartItem,
        productId is ProductId,
        quantity is Quantity
      } with {
        briefly as "What calculateSubtotal needs to do its work"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      record CalculateSubtotalOutput is {
        price: Price
      } with {
        briefly as "What calculateSubtotal produces"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      function calculateSubtotal is {
        requires record CalculateSubtotalInput
        returns record CalculateSubtotalOutput
        do "Calculate cart subtotal from all items"
      } with {
        briefly as "Calculates the cart subtotal based on all items"
        described by {
          | Calculates the total price of all items in the cart before taxes,
          | shipping, or discounts. If productId and quantity are provided,
          | it calculates what the subtotal would be after adding or updating
          | the specified product.
        }
      }

      record CalculateTaxesInput is {
        items is many CartItem,
        productId is ProductId,
        quantity is Quantity
      } with {
        briefly as "What calculateTaxes needs to do its work"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      record CalculateTaxesOutput is {
        price: Price
      } with {
        briefly as "What calculateTaxes produces"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      function calculateTaxes is {
        requires record CalculateTaxesInput
        returns record CalculateTaxesOutput
        do "Calculate taxes based on subtotal and tax rules"
      } with {
        briefly as "Calculates taxes based on cart subtotal"
        described by {
          | Calculates the taxes for the cart based on the current subtotal and
          | applicable tax rules. The default tax rate is 8.5% but can be adjusted
          | based on location and product types.
        }
      }

      record CalculateTotalInput is {
        subtotal is Price,
        taxes is Price,
        shipping is Price,
        discount is Price
      } with {
        briefly as "What calculateTotal needs to do its work"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      record CalculateTotalOutput is {
        price: Price
      } with {
        briefly as "What calculateTotal produces"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      function calculateTotal is {
        requires record CalculateTotalInput
        returns record CalculateTotalOutput
        do "Add subtotal, taxes, shipping and subtract discount"
      } with {
        briefly as "Calculates the final cart total"
        described by {
          | Calculates the final amount by adding subtotal, taxes, and shipping,
          | then subtracting any discounts. This is the final amount the customer
          | will pay at checkout.
        }
      }

      record RemoveItemFromCartInput is {
        items is many CartItem,
        productId is ProductId
      } with {
        briefly as "What removeItemFromCart needs to do its work"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      record RemoveItemFromCartOutput is {
        items is many CartItem
      } with {
        briefly as "What removeItemFromCart produces"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      function removeItemFromCart is {
        requires record RemoveItemFromCartInput
        returns record RemoveItemFromCartOutput
        do "Remove item from cart items by productId"
      } with {
        briefly as "Removes a product from the cart"
        described by {
          | Removes the specified product completely from the cart regardless of
          | its quantity. Returns a new collection of items without the specified product.
        }
      }

      record UpdateItemQuantityInput is {
        items is many CartItem,
        productId is ProductId,
        quantity is Quantity
      } with {
        briefly as "What updateItemQuantity needs to do its work"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      record UpdateItemQuantityOutput is {
        items is many CartItem
      } with {
        briefly as "What updateItemQuantity produces"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      function updateItemQuantity is {
        requires record UpdateItemQuantityInput
        returns record UpdateItemQuantityOutput
        do "Update quantity of an item in cart"
      } with {
        briefly as "Updates the quantity of a product in the cart"
        described by {
          | Updates the quantity of the specified product in the cart to the provided value.
          | Also recalculates the total price of the item based on the new quantity.
        }
      }

      record CalculateSubtotalAfterRemovalInput is {
        items is many CartItem,
        productId is ProductId
      } with {
        briefly as "What calculateSubtotalAfterRemoval needs to do its work"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      record CalculateSubtotalAfterRemovalOutput is {
        price: Price
      } with {
        briefly as "What calculateSubtotalAfterRemoval produces"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      function calculateSubtotalAfterRemoval is {
        requires record CalculateSubtotalAfterRemovalInput
        returns record CalculateSubtotalAfterRemovalOutput
        do "Calculate subtotal after removing an item"
      } with {
        briefly as "Calculates cart subtotal after removing a product"
        described by {
          | Calculates what the cart subtotal would be after removing the specified
          | product completely. This helps preview the updated cart total before
          | actually modifying the cart.
        }

      }

      record CalculateTaxesAfterRemovalInput is {
        items is many CartItem,
        productId is ProductId
      } with {
        briefly as "What calculateTaxesAfterRemoval needs to do its work"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      record CalculateTaxesAfterRemovalOutput is {
        price: Price
      } with {
        briefly as "What calculateTaxesAfterRemoval produces"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      function calculateTaxesAfterRemoval is {
        requires record CalculateTaxesAfterRemovalInput
        returns record CalculateTaxesAfterRemovalOutput
        do "Calculate taxes after removing an item"
      } with {
        briefly as "Calculates taxes after removing a product"
        described by {
          | Calculates what the cart taxes would be after removing the specified
          | product. This helps preview the updated tax amount before actually
          | modifying the cart.
        }

      }

      record CalculateSubtotalAfterUpdateInput is {
        items is many CartItem,
        productId is ProductId,
        quantity is Quantity
      } with {
        briefly as "What calculateSubtotalAfterUpdate needs to do its work"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      record CalculateSubtotalAfterUpdateOutput is {
        price: Price
      } with {
        briefly as "What calculateSubtotalAfterUpdate produces"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      function calculateSubtotalAfterUpdate is {
        requires record CalculateSubtotalAfterUpdateInput
        returns record CalculateSubtotalAfterUpdateOutput
        do "Calculate subtotal after updating quantity"
      } with {
        briefly as "Calculates cart subtotal after updating product quantity"
        described by {
          | Calculates what the cart subtotal would be after updating the quantity
          | of the specified product. This helps preview the updated cart total
          | before actually modifying the cart.
        }

      }

      record CalculateTaxesAfterUpdateInput is {
        items is many CartItem,
        productId is ProductId,
        quantity is Quantity
      } with {
        briefly as "What calculateTaxesAfterUpdate needs to do its work"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      record CalculateTaxesAfterUpdateOutput is {
        price: Price
      } with {
        briefly as "What calculateTaxesAfterUpdate produces"
        described as {
          |Named because RIDDL 2.0 deprecates inline aggregation on
          |'requires' and 'returns'.
        }
      }

      function calculateTaxesAfterUpdate is {
        requires record CalculateTaxesAfterUpdateInput
        returns record CalculateTaxesAfterUpdateOutput
        do "Calculate taxes after updating quantity"
      } with {
        briefly as "Calculates taxes after updating product quantity"
        described by {
          | Calculates what the cart taxes would be after updating the quantity
          | of the specified product. This helps preview the updated tax amount
          | before actually modifying the cart.
        }

      }

      // Commands
      command CreateCart is {
        // No parameters, just creates a new empty cart
      }
      with {
        briefly as "Command to create a new shopping cart"
        described by {
          | Initializes a new empty shopping cart with a unique identifier.
          | All monetary values are initialized to zero.
        }
      }




      command ApplyDiscount is {
        cartId is CartId
        discountCode is String
        discountAmount is Price
      }
      with {
        briefly as "Command to apply a discount to the cart"
        described by {
          | Applies a discount to the cart total using a discount code.
          | Validates that the discount code is valid before applying.
          | Recalculates cart total after applying the discount.
        }
      }

      // Events
      event CartCreated is {
        id is Id(Cart),
        cartId is CartId
      }
      with {
        briefly as "Event indicating a new cart was created"
        described by {
          | Emitted when a new shopping cart is successfully created.
          | Contains the new cart's identifier for reference.
        }
      }

      event ItemAddedToCart is {
        id is Id(Cart),
        cartId is CartId
        productId is ProductId
        quantity is Quantity
        name is Name
        price: Price
      }
      with {
        briefly as "Event indicating a product was added to the cart"
        described by {
          | Emitted when a product is successfully added to a cart.
          | Contains product details and quantity for UI updates.
        }
      }

      event ItemRemovedFromCart is {
        id is Id(Cart),
        cartId is CartId
        productId is ProductId
      }
      with {
        briefly as "Event indicating a product was removed from the cart"
        described by {
          | Emitted when a product is successfully removed from a cart.
          | Identifies the product that was removed.
        }
      }

      event CartQuantityUpdated is {
        id is Id(Cart),
        cartId is CartId
        productId is ProductId
        oldQuantity is Quantity
        newQuantity is Quantity
      }
      with {
        briefly as "Event indicating a product quantity change in the cart"
        described by {
          | Emitted when the quantity of a product in the cart is changed.
          | Contains both old and new quantities for reference.
        }
      }

      event DiscountApplied is {
        id is Id(Cart),
        cartId is CartId
        discountCode is String
        discountAmount is Price
      }
      with {
        briefly as "Event indicating a discount was applied to the cart"
        described by {
          | Emitted when a discount is successfully applied to a cart.
          | Contains the discount code and amount for reference.
        }
      }

      // Handler for processing commands
      handler CartCommandHandler is {
        on query WhichCart {
          reply result TheCart(
            id = prompt("the id carried by TheCart"),
            summary = prompt("the summary carried by TheCart")
          )
        }

        on init {
          set field CartRecord.cartId to "a freshly minted cart identifier"
        }

        on command CreateCart is {
          // Create a new cart with an ID and initialized values
          morph entity Cart to state CartData with record CartRecord(
            cartId = prompt("the cartId of the resulting ShoppingContext state"),
            items = prompt("the items of the resulting ShoppingContext state"),
            subtotal = prompt("the subtotal of the resulting ShoppingContext state"),
            taxes = prompt("the taxes of the resulting ShoppingContext state"),
            shipping = prompt("the shipping of the resulting ShoppingContext state"),
            discount = prompt("the discount of the resulting ShoppingContext state"),
            total = prompt("the total of the resulting ShoppingContext state")
          )

          // Emit event
          tell event CartCreated(
            id = prompt("the id carried by CartCreated"),
            cartId = prompt("the cartId carried by CartCreated")
          ) to entity Cart
        }

        on command AddToCart is {
          // Check if product exists and is in stock
          when prompt("productExists(command.productId) && isInStock(command.productId)") then
            // Get product details and calculate new cart state
            // Update cart state
            morph entity Cart to state CartData with record CartRecord(
              cartId = prompt("the cartId of the resulting ShoppingContext state"),
              items = prompt("the items of the resulting ShoppingContext state"),
              subtotal = prompt("the subtotal of the resulting ShoppingContext state"),
              taxes = prompt("the taxes of the resulting ShoppingContext state"),
              shipping = prompt("the shipping of the resulting ShoppingContext state"),
              discount = prompt("the discount of the resulting ShoppingContext state"),
              total = prompt("the total of the resulting ShoppingContext state")
            )
            // Emit event
            tell event ItemAddedToCart(
              id = prompt("the id carried by ItemAddedToCart"),
              cartId = prompt("the cartId carried by ItemAddedToCart"),
              productId = prompt("the productId carried by ItemAddedToCart"),
              quantity = prompt("the quantity carried by ItemAddedToCart"),
              name = prompt("the name carried by ItemAddedToCart"),
              price = prompt("the price carried by ItemAddedToCart")
            ) to entity Cart
          else
            error "Product is not available"
          end
        }

        on command RemoveFromCart is {
          // Update cart state
          morph entity Cart to state CartData with record CartRecord(
            cartId = prompt("the cartId of the resulting ShoppingContext state"),
            items = prompt("the items of the resulting ShoppingContext state"),
            subtotal = prompt("the subtotal of the resulting ShoppingContext state"),
            taxes = prompt("the taxes of the resulting ShoppingContext state"),
            shipping = prompt("the shipping of the resulting ShoppingContext state"),
            discount = prompt("the discount of the resulting ShoppingContext state"),
            total = prompt("the total of the resulting ShoppingContext state")
          )
          // Emit event
          tell event ItemRemovedFromCart(
            id = prompt("the id carried by ItemRemovedFromCart"),
            cartId = prompt("the cartId carried by ItemRemovedFromCart"),
            productId = prompt("the productId carried by ItemRemovedFromCart")
          ) to entity Cart
        }

        // FIXED: Ambiguous reference by using fully qualified path
        on command ShopifyCart.UpdateQuantity is {
          // Validate new quantity. Three outcomes, so the guards nest rather
          // than sitting side by side — side-by-side guards leave a path where
          // none matches and nothing is recorded.
          when prompt("command.quantity > 0") then
            // Update cart state
            morph entity Cart to state CartData with record CartRecord(
              cartId = prompt("the cartId of the resulting ShoppingContext state"),
              items = prompt("the items of the resulting ShoppingContext state"),
              subtotal = prompt("the subtotal of the resulting ShoppingContext state"),
              taxes = prompt("the taxes of the resulting ShoppingContext state"),
              shipping = prompt("the shipping of the resulting ShoppingContext state"),
              discount = prompt("the discount of the resulting ShoppingContext state"),
              total = prompt("the total of the resulting ShoppingContext state")
            )
            // Emit event
            tell event CartQuantityUpdated(
              id = prompt("the id carried by CartQuantityUpdated"),
              cartId = prompt("the cartId carried by CartQuantityUpdated"),
              productId = prompt("the productId carried by CartQuantityUpdated"),
              oldQuantity = prompt("the oldQuantity carried by CartQuantityUpdated"),
              newQuantity = prompt("the newQuantity carried by CartQuantityUpdated")
            ) to entity Cart
          else
            when prompt("command.quantity == 0") then
              // Quantity zero means the item leaves the cart. Record the
              // removal here rather than telling Cart a RemoveFromCart
              // command: that self-dispatch emitted nothing on this path, and
              // the entity already knows what happened.
              morph entity Cart to state CartData with record CartRecord(
                cartId = prompt("the cartId of the resulting ShoppingContext state"),
                items = prompt("the items of the resulting ShoppingContext state"),
                subtotal = prompt("the subtotal of the resulting ShoppingContext state"),
                taxes = prompt("the taxes of the resulting ShoppingContext state"),
                shipping = prompt("the shipping of the resulting ShoppingContext state"),
                discount = prompt("the discount of the resulting ShoppingContext state"),
                total = prompt("the total of the resulting ShoppingContext state")
              )
              tell event ItemRemovedFromCart(
                id = prompt("the id carried by ItemRemovedFromCart"),
                cartId = prompt("the cartId carried by ItemRemovedFromCart"),
                productId = prompt("the productId carried by ItemRemovedFromCart")
              ) to entity Cart
            else
              error "Quantity must be zero or positive"
            end
          end
        }

        on command ApplyDiscount is {
          // Validate discount code
          when prompt("isValidDiscountCode(command.discountCode)") then
            // Update cart state
            morph entity Cart to state CartData with record CartRecord(
              cartId = prompt("the cartId of the resulting ShoppingContext state"),
              items = prompt("the items of the resulting ShoppingContext state"),
              subtotal = prompt("the subtotal of the resulting ShoppingContext state"),
              taxes = prompt("the taxes of the resulting ShoppingContext state"),
              shipping = prompt("the shipping of the resulting ShoppingContext state"),
              discount = prompt("the discount of the resulting ShoppingContext state"),
              total = prompt("the total of the resulting ShoppingContext state")
            )
            // Emit event
            tell event DiscountApplied(
              id = prompt("the id carried by DiscountApplied"),
              cartId = prompt("the cartId carried by DiscountApplied"),
              discountCode = prompt("the discountCode carried by DiscountApplied"),
              discountAmount = prompt("the discountAmount carried by DiscountApplied")
            ) to entity Cart
          else
            error "Invalid discount code"
          end
        }
      }
      with {
        briefly as "Processes commands for cart management"
        described by {
          | Handles all shopping cart operations including creation, adding items,
          | removing items, updating quantities, and applying discounts.
          | Validates input data, maintains cart state, and emits relevant events.
        }
      }
    }
    with {
      briefly as "Represents a customer's shopping cart"
      described by {
        | The Cart entity represents a customer's shopping session and contains
        | all selected products and their quantities. It maintains running totals
        | for subtotal, taxes, shipping, discounts, and the final amount.
        | The cart responds to commands for adding, removing, and updating items.
      }
    }

    // Customer Information Record
    type CustomerInfo is {
      email is Email
      name is Name
      shippingAddress is Address
      billingAddress is Address
    }
    with {
      briefly as "Record type for customer details"
      described by {
        | Contains customer identification and address information
        | needed for order processing and fulfillment.
      }
    }

    // Payment Method Record
    type PaymentMethod is {
      type is String
      details is String // Tokenized payment details
    }
    with {
      briefly as "Record type for payment information"
      described by {
        | Contains tokenized payment details and payment type.
        | Actual sensitive payment data is not stored directly.
      }
    }

    // Checkout Record
    type CheckoutRecord is {
      cartId is CartId
      customer is CustomerInfo
      paymentMethod is PaymentMethod
    }
    with {
      briefly as "Record type containing checkout data"
      described by {
        | Defines the complete structure of checkout data including
        | cart reference, customer information, and payment details.
      }
    }

    // Checkout Process
    entity Checkout is {


      query WhichCheckout is {
        id is CheckoutIdentity
      } with {
        briefly as "Ask for the current state of one checkout"
        described as {
          |Sent when a reader wants a checkout they already know of.
        }
      }

      result TheCheckout is {
        id is CheckoutIdentity,
        summary is String
      } with {
        briefly as "The answer to a WhichCheckout query"
        described as {
          |Carries the identity and a short summary.
        }
      }



      state CheckoutData of record CheckoutRecord with {
        briefly as "Checkout state containing cart and customer data"
        described by {
          | Contains all the information needed to complete a purchase, including
          | cart identifier, customer information, and payment details.
        }

      }

      // Commands

      command CancelCheckout is {
        id is Id(Checkout),
        cartId is CartId
        reason is String
      }
      with {
        briefly as "Command to abandon a checkout before it completes"
        described by {
          | Ends a checkout without producing an order, raised inside
          | ShoppingContext by a timeout or by the shopper backing out. It
          | crosses no context seam, so it is declared here on the entity
          | that owns it.
        }
      }




      // Events
      event CheckoutCancelled is {
        id is Id(Checkout),
        cartId is CartId
        reason is String
      }
      with {
        briefly as "Event indicating a checkout was abandoned"
        described by {
          | Emitted when a checkout ends without completing. The cart itself
          | survives; only the checkout attempt is discarded.
        }
      }

      event CheckoutInitiated is {
        id is Id(Checkout),
        cartId is CartId
        customerEmail is Email
      }
      with {
        briefly as "Event indicating checkout has begun"
        described by {
          | Emitted when the checkout process is successfully initiated.
          | Contains customer identification for reference.
        }
      }

      event PaymentMethodSelected is {
        id is Id(Checkout),
        cartId is CartId
        paymentType is String
      }
      with {
        briefly as "Event indicating payment method was selected"
        described by {
          | Emitted when a payment method is successfully associated with a checkout.
          | Contains the type of payment selected (e.g., credit card, PayPal).
        }
      }

      event CheckoutCompleted is {
        id is Id(Checkout),
        cartId is CartId
        orderId is UUID
      }
      with {
        briefly as "Event indicating checkout was successful"
        described by {
          | Emitted when the checkout process completes successfully.
          | Contains the newly created order identifier.
        }
      }

      // Handler for processing commands
      handler CheckoutCommandHandler is {
        on query WhichCheckout {
          reply result TheCheckout(
            id = prompt("the id carried by TheCheckout"),
            summary = prompt("the summary carried by TheCheckout")
          )
        }

        on init {
          set field CheckoutRecord.cartId to "the cart this checkout is for"
        }

        // FIXED: Ambiguous reference by using fully qualified path
        on command ShopifyCart.InitiateCheckout is {
          // Initialize checkout with customer information
          // FIXED: Ambiguous references by using fully qualified paths
          morph entity ShopifyCart.ShoppingContext.Checkout to state CheckoutData with record CheckoutRecord(
            cartId = prompt("the cartId of the resulting Checkout state"),
            customer = prompt("the customer of the resulting Checkout state"),
            paymentMethod = prompt("the paymentMethod of the resulting Checkout state")
          )

          // Emit event
          // FIXED: Ambiguous reference by using fully qualified path
          tell event CheckoutInitiated(
            id = prompt("the id carried by CheckoutInitiated"),
            cartId = prompt("the cartId carried by CheckoutInitiated"),
            customerEmail = prompt("the customerEmail carried by CheckoutInitiated")
          ) to entity ShopifyCart.ShoppingContext.Checkout
        }

        on command SelectPaymentMethod is {
          // Update checkout with payment method
          // FIXED: Ambiguous reference by using fully qualified path
          morph entity ShopifyCart.ShoppingContext.Checkout to state CheckoutData with record CheckoutRecord(
            cartId = prompt("the cartId of the resulting Checkout state"),
            customer = prompt("the customer of the resulting Checkout state"),
            paymentMethod = prompt("the paymentMethod of the resulting Checkout state")
          )

          // Emit event
          // FIXED: Ambiguous reference by using fully qualified path
          tell event PaymentMethodSelected(
            id = prompt("the id carried by PaymentMethodSelected"),
            cartId = prompt("the cartId carried by PaymentMethodSelected"),
            paymentType = prompt("the paymentType carried by PaymentMethodSelected")
          ) to entity ShopifyCart.ShoppingContext.Checkout
        }

        on command CompleteCheckout is {
          // Validate cart and payment information
          when prompt("isValidCart(command.cartId) && hasPaymentMethod()") then
            // Process payment, Create order, Clear cart
            // Emit event with new order ID
            tell event CheckoutCompleted(
              id = prompt("the id carried by CheckoutCompleted"),
              cartId = prompt("the cartId carried by CheckoutCompleted"),
              orderId = prompt("the orderId carried by CheckoutCompleted")
            ) to entity ShopifyCart.ShoppingContext.Checkout
          else
            error "Cannot complete checkout"
          end
        }

        on command CancelCheckout is {
          // Abandoning is still processing: the handler records the outcome
          // or refuses, so every path discharges.
          when prompt("the checkout is still open") then
            tell event CheckoutCancelled(
              id = prompt("the id carried by CheckoutCancelled"),
              cartId = prompt("the cartId carried by CheckoutCancelled"),
              reason = prompt("the reason carried by CheckoutCancelled")
            ) to entity ShopifyCart.ShoppingContext.Checkout
          else
            error "Cannot cancel a checkout that has already completed"
          end
        }

      }
      with {
        briefly as "Processes commands for checkout flow"
        described by {
          | Handles the multi-step checkout process including collecting customer information,
          | selecting payment methods, and finalizing purchases. Validates checkout state
          | at each step and emits appropriate events.
        }
      }
    }
    with {
      briefly as "Manages the purchase completion process"
      described by {
        | The Checkout entity manages the process of converting a shopping cart
        | into a completed order. It collects customer information, shipping and
        | billing addresses, and payment details. The checkout process consists
        | of several steps that must be completed in sequence.
      }
    }

    // Repository for Cart data
    repository CartRepository is {

      inlet Recorded is type ShoppingEvent with {
        briefly as "Where shopping events arrive to be persisted"
        described as {
          |The repository learns of changes through this inlet.
        }
      }

      schema CartData is relational of
        cart as record CartRecord
        link cartItems as field Cart.items.id to field Product.id
      with {
        briefly as "How carts are laid out in storage"
        described as {
          |A relational schema: the cart, with its items linked to the
          |products they refer to.
        }
      }

      // Message handlers
      handler CartRepositoryHandler is {
        on event ShopifyCart.ShoppingContext.Cart.CartCreated {
          do "store the cart identifier carried by the event"
        }

        on event CartCreated is {
          do "Create new cart record in Cart repository"
        }

        on event ItemAddedToCart is {
          do "Add item to cart in Cart repository"
        }

        on event ItemRemovedFromCart is {
          do "Remove item from cart in Cart repository"
        }

        on event CartQuantityUpdated is {
          do "Update item quantity in Cart repository"
        }

        on event DiscountApplied is {
          do "Apply discount to cart in Cart repository"
        }
      }
      with {
        briefly as "Handles persistence of cart events"
        described by {
          | Handles all event-driven persistence operations related to shopping carts.
          | Responds to cart events by updating the persistent state of carts and their items.
        }
      }
    }
    with {
      briefly as "Persistent storage for shopping cart data"
      described by {
        | The CartRepository provides persistent storage for shopping cart data,
        | including the cart itself and all items within it. It uses a flat schema
        | with links between cart items and product records.
      }
    }

    // Repository for Product data
    repository ProductRepository is {

      schema ProductData is flat of
        product as record ProductRecord
      with {
        briefly as "How products are laid out in storage"
        described as {
          |A flat schema: one stored row per product.
        }
      }

      handler ProductRepositoryHandler is {
        on event ProductPriceUpdated is {
          do "Update product price in Product repository"
        }

        on event InventoryUpdated is {
          do "Update product inventory in Product repository"
        }
      }
      with {
        briefly as "Handles persistence of product events"
        described by {
          | Handles event-driven persistence operations related to products.
          | Responds to product events by updating the persistent state of product records.
        }
      }
    }
    with {
      briefly as "Persistent storage for product data"
      described by {
        | The ProductRepository provides persistent storage for product data,
        | including details like name, price, and inventory status.
        | It uses a flat schema for simplicity.
      }
    }

    record CheckoutProcessInput is {
      paymentType is String,
      paymentDetails is String
    } with {
      briefly as "What the checkout saga needs to run"
      described as {
        |Named because RIDDL 2.0 deprecates inline aggregation on
        |'requires' and 'returns'.
      }
    }

    record CheckoutProcessOutput is {
      orderPlaced is Boolean
    } with {
      briefly as "What the checkout saga reports when it finishes"
      described as {
        |Named because RIDDL 2.0 deprecates inline aggregation on
        |'requires' and 'returns'.
      }
    }

    // Saga for the checkout process
    saga CheckoutProcess is {

      requires record CheckoutProcessInput

      returns record CheckoutProcessOutput

      step ValidateCart is {
        tell command ShopifyCart.RemoveFromCart(
          id = prompt("the id carried by RemoveFromCart"),
          cartId = prompt("the cartId carried by RemoveFromCart"),
          productId = prompt("the productId carried by RemoveFromCart")
        ) to entity Cart
        // Check if cart exists and has items
        when prompt("cartRepository.exists(cartId) && cartRepository.hasItems(cartId)") then
          do "Continue to next step after cart validation"
        end
        when prompt("!cartRepository.exists(cartId) || !cartRepository.hasItems(cartId)") then
          error "Cart is empty or does not exist"
        end
      } reverted by {
        do "No action needed for cart validation revert"
      }
      with {
        briefly as "Validates cart exists and contains items"
        described by {
          | First step in the checkout process that confirms the cart
          | exists and contains at least one item.
        }
      }

      step ValidateInventory is {
        tell command ShopifyCart.UpdateInventory(
          id = prompt("the id carried by UpdateInventory"),
          productId = prompt("the productId carried by UpdateInventory"),
          newQuantity = prompt("the newQuantity carried by UpdateInventory")
        ) to entity Product
        // Check inventory for all items in cart
        when prompt("allItemsHaveInventory(Cart.items)") then
          do "Inventory validated for all items"
        end
        when prompt("!allItemsHaveInventory(Cart.items)") then
          error "Insufficient inventory for product"
        end
      } reverted by {
        do "No action needed for inventory validation revert"
      }
      with {
        briefly as "Confirms sufficient inventory for all items"
        described by {
          | Validates that all items in the cart have sufficient inventory
          | before proceeding with the checkout.
        }
      }

      step ProcessPayment is {
        tell command ShopifyCart.CompleteCheckout(
          id = prompt("the id carried by CompleteCheckout"),
          cartId = prompt("the cartId carried by CompleteCheckout")
        ) to entity ShopifyCart.ShoppingContext.Checkout
        // Process payment with payment provider
        when prompt("paymentService.process(cartId, paymentInfo)") then
          do "Payment processed successfully"
        end
        when prompt("!paymentService.process(cartId, paymentInfo)") then
          error "Payment failed"
        end
      } reverted by {
        // Refund payment if necessary
        when prompt("paymentWasProcessed") then
          do "Refund payment via paymentService"
        end
      }
      with {
        briefly as "Processes payment for the order"
        described by {
          | Attempts to process payment using the provided payment details.
          | If payment fails, the checkout process is aborted.
          | If later steps fail, payment is refunded as part of compensation.
        }
      }

      step CreateOrder is {
        tell command ShopifyCart.CompleteCheckout(
          id = prompt("the id carried by CompleteCheckout"),
          cartId = prompt("the cartId carried by CompleteCheckout")
        ) to entity ShopifyCart.ShoppingContext.Checkout
        do "Create order from cart using orderService"
      } reverted by {
        // Cancel order if created
        when prompt("orderWasCreated") then
          do "Cancel order via orderService"
        end
      }
      with {
        briefly as "Creates an order record from the cart"
        described by {
          | Creates a new order record based on the contents of the cart
          | and the customer information. If later steps fail,
          | the order is canceled as part of compensation.
        }
      }

      step UpdateInventoryLevels is {
        tell command ShopifyCart.UpdateInventory(
          id = prompt("the id carried by UpdateInventory"),
          productId = prompt("the productId carried by UpdateInventory"),
          newQuantity = prompt("the newQuantity carried by UpdateInventory")
        ) to entity Product
        do "Reduce inventory for all purchased items via inventoryService"
      } reverted by {
        do "Restore inventory levels for all items via inventoryService"
      } with {
        briefly as "Reduces inventory levels for purchased items"
        described by {
          | Updates inventory quantities to reflect items that have been purchased.
          | If later steps fail, inventory levels are restored as part of compensation.
        }
      }

      step SendConfirmation is {
        tell command ShopifyCart.CompleteCheckout(
          id = prompt("the id carried by CompleteCheckout"),
          cartId = prompt("the cartId carried by CompleteCheckout")
        ) to entity ShopifyCart.ShoppingContext.Checkout
        do "Send order confirmation email to customer"
      } reverted by {
        do "No action needed for email revert"
      } with {
        briefly as "Sends order confirmation to customer"
        described by {
          | Sends an email confirmation to the customer with order details.
          | There is no compensation action since emails cannot be unsent.
        }
      }
    }
    with {
      briefly as "Orchestrates the checkout process steps"
      described by {
        | This saga orchestrates the multi-step process of completing a checkout,
        | including validating the cart and inventory, processing payment,
        | creating an order, updating inventory, and sending confirmation.
        |
        | It includes compensation actions (reversion steps) for each stage to ensure
        | consistency if a later stage fails. This provides transactional integrity
        | across multiple services.
      }
    }
    type ProductIdentity is Id(ShopifyCart.ShoppingContext.Product) with {
      briefly as "This entity's own identity type"
      described as {
        |RIDDL 2.0 wants each entity to declare the Id type that names it.
      }
    }
    type CartIdentity is Id(ShopifyCart.ShoppingContext.Cart) with {
      briefly as "This entity's own identity type"
      described as {
        |RIDDL 2.0 wants each entity to declare the Id type that names it.
      }
    }
    type CheckoutIdentity is Id(ShopifyCart.ShoppingContext.Checkout) with {
      briefly as "This entity's own identity type"
      described as {
        |RIDDL 2.0 wants each entity to declare the Id type that names it.
      }
    }

    type ShoppingEvent is one of {
      event ShopifyCart.ShoppingContext.Cart.CartCreated or event ShopifyCart.ShoppingContext.Product.ProductPriceUpdated
    } with {
      briefly as "Anything ShoppingContext announces"
      described as {
        |The alternation of the events this context publishes so one outlet
        |can carry them all.
      }
    }

    processor ShoppingAnnouncer as source is {
      outlet Published is type ShoppingEvent with {
        briefly as "Where ShoppingContext publishes what happened"
        described as {
          |Events leave this context through this outlet.
        }
      }
      handler ShoppingAnnouncerHandler is {
        on event ShopifyCart.ShoppingContext.Cart.CartCreated {
          send event ShopifyCart.ShoppingContext.Cart.CartCreated(
            id = prompt("the id carried by CartCreated"),
            cartId = prompt("the cartId carried by CartCreated")
          ) to outlet ShoppingAnnouncer.Published
        }
        on other {
          do "ignore anything that is not a shopping event"
        }
      } with {
        briefly as "Publishes shopping events"
        described as {
          |Puts each event the entities announced onto the outlet.
        }
      }
    } with {
      briefly as "The context's publication point"
      described as {
        |A source streamlet carrying what ShoppingContext wants known.
      }
    }

    connector ErrorReporting is {
      from outlet Riddl.ForeverEmpty.void to inlet ShopifyCart.ShoppingContext.ShoppingIntake.Failures
    } with {
      briefly as "Terminates the error-sink inlet"
      described as {
        |Nothing in this model produces a GeneratorError — those come from
        |generators at runtime, not from anything the model declares. The
        |predefined ForeverEmpty source exists for exactly this: a port that
        |must be connected but has no modelled producer.
      }
    }

    connector Announcing is {
      from outlet ShoppingAnnouncer.Published to inlet CartRepository.Recorded
    } with {
      briefly as "Carries shopping events to the cart store"
      described as {
        |Connects what the context announces to what records it.
      }
    }

    processor ShoppingIntake as sink is {
    inlet Failures is record Riddl.GeneratorError with {
      option error-sink
      briefly as "Where hard errors go"
      described as {
        |RIDDL 2.0 wants every domain to name a destination for failures no
        |handler can recover from. An error-sink inlet is infrastructure
        |rather than dataflow, so it does not count toward this processor's
        |arity.
      }
    }
      inlet Requests is type ShopifyCart.ShopperCommand with {
        briefly as "Where shopping commands arrive from the application"
        described as {
          |Everything the application asks the domain to do enters here.
        }
      }
      handler ShoppingIntakeHandler is {
        on command ShopifyCart.AddToCart {
          tell command ShopifyCart.AddToCart(
            id = prompt("the id carried by AddToCart"),
            cartId = prompt("the cartId carried by AddToCart"),
            productId = prompt("the productId carried by AddToCart"),
            quantity = prompt("the quantity carried by AddToCart")
          ) to entity Cart
        }
        on command ShopifyCart.RemoveFromCart {
          tell command ShopifyCart.RemoveFromCart(
            id = prompt("the id carried by RemoveFromCart"),
            cartId = prompt("the cartId carried by RemoveFromCart"),
            productId = prompt("the productId carried by RemoveFromCart")
          ) to entity Cart
        }
        on command ShopifyCart.UpdateQuantity {
          tell command ShopifyCart.UpdateQuantity(
            id = prompt("the id carried by UpdateQuantity"),
            cartId = prompt("the cartId carried by UpdateQuantity"),
            productId = prompt("the productId carried by UpdateQuantity"),
            quantity = prompt("the quantity carried by UpdateQuantity")
          ) to entity Cart
        }
        on command ShopifyCart.InitiateCheckout {
          tell command ShopifyCart.InitiateCheckout(
            id = prompt("the id carried by InitiateCheckout"),
            cartId = prompt("the cartId carried by InitiateCheckout"),
            customerEmail = prompt("the customerEmail carried by InitiateCheckout"),
            customerName = prompt("the customerName carried by InitiateCheckout"),
            shippingAddress = prompt("the shippingAddress carried by InitiateCheckout"),
            billingAddress = prompt("the billingAddress carried by InitiateCheckout")
          ) to entity ShopifyCart.ShoppingContext.Checkout
        }
        on command ShopifyCart.SelectPaymentMethod {
          tell command ShopifyCart.SelectPaymentMethod(
            id = prompt("the id carried by SelectPaymentMethod"),
            cartId = prompt("the cartId carried by SelectPaymentMethod"),
            paymentType = prompt("the paymentType carried by SelectPaymentMethod"),
            paymentDetails = prompt("the paymentDetails carried by SelectPaymentMethod")
          ) to entity ShopifyCart.ShoppingContext.Checkout
        }
        on command ShopifyCart.CompleteCheckout {
          tell command ShopifyCart.CompleteCheckout(
            id = prompt("the id carried by CompleteCheckout"),
            cartId = prompt("the cartId carried by CompleteCheckout")
          ) to entity ShopifyCart.ShoppingContext.Checkout
        }
        on command ShopifyCart.UpdateProductPrice {
          tell command ShopifyCart.UpdateProductPrice(
            id = prompt("the id carried by UpdateProductPrice"),
            productId = prompt("the productId carried by UpdateProductPrice"),
            newPrice = prompt("the newPrice carried by UpdateProductPrice")
          ) to entity Product
        }
        on command ShopifyCart.UpdateInventory {
          tell command ShopifyCart.UpdateInventory(
            id = prompt("the id carried by UpdateInventory"),
            productId = prompt("the productId carried by UpdateInventory"),
            newQuantity = prompt("the newQuantity carried by UpdateInventory")
          ) to entity Product
        }
      } with {
        briefly as "Dispatches arriving commands"
        described as {
          |Receives commands at the boundary and forwards them.
        }
      }
    } with {
      briefly as "The context's front door"
      described as {
        |A sink receiving messages addressed to ShoppingContext.
      }
    }


  }
  with {
    briefly as "Main shopping context containing all commerce entities"
    described by {
      | The ShoppingContext is the primary bounded context for the shopping cart system.
      | It contains all entities, repositories, and processes related to the shopping
      | experience, including products, carts, and checkout processes.
    }
  }

  type ShopperCommand is one of {
    command ShopifyCart.AddToCart or
    command ShopifyCart.RemoveFromCart or
    command ShopifyCart.UpdateQuantity or
    command ShopifyCart.InitiateCheckout or
    command ShopifyCart.SelectPaymentMethod or
    command ShopifyCart.CompleteCheckout or
    command ShopifyCart.UpdateProductPrice or
    command ShopifyCart.UpdateInventory
  } with {
    briefly as "Everything a page can ask the domain to do"
    described as {
      |One alternation so a single outlet, inlet and connector can carry
      |every command the application raises. Each epic step is witnessed by
      |that one path rather than needing a connector apiece.
    }
  }

  persistent connector ShopperRequests is {
    from outlet ShopifyCart.UserInterface.ShopperRequests.Submissions
    to inlet ShopifyCart.ShoppingContext.ShoppingIntake.Requests
  } with {
    briefly as "Carries shopper requests from the application to the domain"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and made
      |persistent as RIDDL 2.0 requires.
    }
  }

  // User definitions for epics

  user Customer is "A shopper who wants to purchase items from the store"
  with {

    briefly as "Primary user who shops and makes purchases"
    described by {
      | The Customer represents the primary user of the shopping system.
      | Customers browse products, add items to carts, and complete purchases.
    }
  }

  user StoreAdmin is "Admin user who manages products and inventory"
  with {

    briefly as "Administrative user who manages store content"
    described by {
      | The StoreAdmin is responsible for maintaining the store,
      | including managing product information and inventory levels.
    }
  }


  record PaymentDetails is { ??? }
  record InventoryUpdateDetails is { ??? }
  record ProductPriceDetails is { ??? }


  application context UserInterface is {

    processor ShopperRequests as source is {
      outlet Submissions is type ShopifyCart.ShopperCommand with {
        briefly as "Where the application sends work into the domain"
        described as {
          |Requests leave the application here and reach ShoppingContext over
          |a domain-scoped connector.
        }
      }
      handler ShopperRequestsHandler is {
        on command ShopifyCart.AddToCart {
          send command ShopifyCart.AddToCart(
            id = prompt("the id carried by AddToCart"),
            cartId = prompt("the cartId carried by AddToCart"),
            productId = prompt("the productId carried by AddToCart"),
            quantity = prompt("the quantity carried by AddToCart")
          ) to outlet Submissions
        }
        on other {
          do "ignore interactions that do not reach the domain"
        }
      } with {
        briefly as "Forwards shopper requests into the domain"
        described as {
          |Runs when a page raises a command.
        }
      }
    } with {
      briefly as "The application's outbound path to ShoppingContext"
      described as {
        |A source streamlet: what the shopper asked for, on its way in.
      }
    }

    handler InteractionRouter is {
      on command ShopifyCart.AddToCart {
        tell command ShopifyCart.AddToCart(
          id = prompt("the id carried by AddToCart"),
          cartId = prompt("the cartId carried by AddToCart"),
          productId = prompt("the productId carried by AddToCart"),
          quantity = prompt("the quantity carried by AddToCart")
        ) to entity Cart
      }
      on command ShopifyCart.RemoveFromCart {
        tell command ShopifyCart.RemoveFromCart(
          id = prompt("the id carried by RemoveFromCart"),
          cartId = prompt("the cartId carried by RemoveFromCart"),
          productId = prompt("the productId carried by RemoveFromCart")
        ) to entity Cart
      }
      on command ShopifyCart.UpdateQuantity {
        tell command ShopifyCart.UpdateQuantity(
          id = prompt("the id carried by UpdateQuantity"),
          cartId = prompt("the cartId carried by UpdateQuantity"),
          productId = prompt("the productId carried by UpdateQuantity"),
          quantity = prompt("the quantity carried by UpdateQuantity")
        ) to entity Cart
      }
      on command ShopifyCart.InitiateCheckout {
        tell command ShopifyCart.InitiateCheckout(
          id = prompt("the id carried by InitiateCheckout"),
          cartId = prompt("the cartId carried by InitiateCheckout"),
          customerEmail = prompt("the customerEmail carried by InitiateCheckout"),
          customerName = prompt("the customerName carried by InitiateCheckout"),
          shippingAddress = prompt("the shippingAddress carried by InitiateCheckout"),
          billingAddress = prompt("the billingAddress carried by InitiateCheckout")
        ) to entity ShopifyCart.ShoppingContext.Checkout
      }
      on command ShopifyCart.SelectPaymentMethod {
        tell command ShopifyCart.SelectPaymentMethod(
          id = prompt("the id carried by SelectPaymentMethod"),
          cartId = prompt("the cartId carried by SelectPaymentMethod"),
          paymentType = prompt("the paymentType carried by SelectPaymentMethod"),
          paymentDetails = prompt("the paymentDetails carried by SelectPaymentMethod")
        ) to entity ShopifyCart.ShoppingContext.Checkout
      }
      on command ShopifyCart.CompleteCheckout {
        tell command ShopifyCart.CompleteCheckout(
          id = prompt("the id carried by CompleteCheckout"),
          cartId = prompt("the cartId carried by CompleteCheckout")
        ) to entity ShopifyCart.ShoppingContext.Checkout
      }
      on command ShopifyCart.UpdateProductPrice {
        tell command ShopifyCart.UpdateProductPrice(
          id = prompt("the id carried by UpdateProductPrice"),
          productId = prompt("the productId carried by UpdateProductPrice"),
          newPrice = prompt("the newPrice carried by UpdateProductPrice")
        ) to entity Product
      }
      on command ShopifyCart.UpdateInventory {
        tell command ShopifyCart.UpdateInventory(
          id = prompt("the id carried by UpdateInventory"),
          productId = prompt("the productId carried by UpdateInventory"),
          newQuantity = prompt("the newQuantity carried by UpdateInventory")
        ) to entity Product
      }
    } with {
      briefly as "Carries what the shopper does on a page into the domain"
      described as {
        |RIDDL 2.0 confines user interaction to the application boundary, and
        |wants each epic step witnessed by real wiring. This handler is that
        |wiring: every command a page can raise is told to the entity that
        |owns it.
      }
    }
    page ProductDetails is { ??? } with {
      briefly as "Page showing product information"
      described by {
        | Displays detailed information about a product including name,
        | description, price, and images. Allows customers to add products to cart.
      }
    }

    page ShoppingCart is {
      // FIXED: Using defined Bool type instead of Boolean
      // FIXED: Renamed to avoid ambiguity
      button CheckoutBtn activates type Bool with {
        briefly as "Starts the checkout flow"
        described as {
          |Takes the shopper from their cart to the checkout pages.
        }
      }
    } with {
      briefly as "Page showing cart contents"
      described by {
        | Displays all items added to the cart with quantities and prices.
        | Allows customers to update quantities, remove items, and proceed to checkout.
      }
    }


    // FIXED: Renamed to avoid ambiguity
    page CheckoutPage is { ??? } with {
      briefly as "Page for entering checkout information"
      described by {
        | Allows customers to enter shipping information, billing details,
        | and proceed to payment processing. First step in the checkout flow.
      }
    }

    page Payment is {
      // FIXED: Added missing form - matches the reference in epics
      form PaymentDetailsEntry submits type PaymentDetails with {
        briefly as "Form for entering payment information"
        described by {
          | Collects payment method and details from the customer.
          | Payment information is tokenized for security before processing.
        }
      }
    } with {
      briefly as "Page for payment processing"
      described by {
        | Allows customers to enter and submit payment information.
        | Second step in the checkout flow after customer information is collected.
      }
    }

    // FIXED: Renamed to avoid ambiguity
    page CheckoutCompletedPage is { ??? } with {
      briefly as "Order confirmation page"
      described by {
        | Displays order confirmation and details after a successful checkout.
        | Shows order number, items purchased, and estimated delivery information.
      }

    }

    page ProductManagement is {
      form InventoryQuantity submits type InventoryUpdateDetails with {
        briefly as "Form for updating product inventory"
        described by {
          | Allows store administrators to update the quantity of products in inventory.
          | Automatically updates the inventory status based on the new quantity.
        }
      }
      item ProductPrice submits type ProductPriceDetails with {
        briefly as "Form field for updating product price"
        described by {
          | Allows store administrators to modify the price of products.
          | Validates that prices are positive values before saving.
        }

      }
    } with {
      briefly as "Admin page for product management"
      described by {
        | Provides administrative interface for managing product information,
        | including updating prices and inventory levels.
      }
    }
  } with {
    briefly as "User interface components for shopping cart system"
    described by {
      | Contains all UI components used in the shopping cart system including
      | product details, shopping cart, checkout flow, and admin pages.
    }
  }

  epic ShoppingCartEpic is {
    user Customer wants to
      "add items to a shopping cart"
    so that
      "they can purchase multiple items at once"

    case AddingToCart is {

      user Customer wants to "add products to cart" so that "they can purchase them later"

      step from user Customer "views" page UserInterface.ProductDetails
      step send command AddToCart from source ShopifyCart.UserInterface.ShopperRequests to sink ShopifyCart.ShoppingContext.ShoppingIntake
      step from entity Cart "updates" to page UserInterface.ShoppingCart
      step focus user Customer on page UserInterface.ShoppingCart
    } with {
      briefly as "Adding products to the shopping cart"
      described by {
        | This use case describes the process of a customer adding a product
        | to their shopping cart from a product detail page.
      }
    }

    // FIXED: Renamed to avoid ambiguity
    case CartQuantityUpdate is {

      user Customer wants to
        "update the quantity of items in cart"
      so that
        "they can adjust their purchase"

      step from user Customer "views" page UserInterface.ShoppingCart
      // FIXED: Ambiguous reference by using fully qualified path
      step send command ShopifyCart.UpdateQuantity from source ShopifyCart.UserInterface.ShopperRequests to sink ShopifyCart.ShoppingContext.ShoppingIntake
      step from entity Cart "updates" to page UserInterface.ShoppingCart
      step focus user Customer on page UserInterface.ShoppingCart
    } with {
      briefly as "Changing item quantities in the cart"
      described by {
        | This use case describes the process of a customer changing
        | the quantity of an item already in their shopping cart.
      }
    }

    case RemoveItems is {

      user Customer wants to "remove items from cart"
       so that "they can change their mind about purchases"

      step from user Customer "views" page UserInterface.ShoppingCart
      step send command RemoveFromCart from source ShopifyCart.UserInterface.ShopperRequests to sink ShopifyCart.ShoppingContext.ShoppingIntake
      step from entity Cart "updates" to page UserInterface.ShoppingCart
      step focus user Customer on page UserInterface.ShoppingCart
    } with {
      briefly as "Removing items from the shopping cart"
      described by {
        | This use case describes the process of a customer removing
        | an item entirely from their shopping cart.
      }
    }
  } with {
    briefly as "User stories related to shopping cart management"
    described by {
      | This epic covers the core shopping cart functionality including
      | adding items to carts, updating quantities, and removing items.
      | These features enable customers to collect multiple items before checkout.
    }
  }



  // Epic for checkout process
  epic CheckoutEpic is {
    user Customer wants to "complete their purchase" so that "they can receive their ordered items"

    // FIXED: Renamed to avoid ambiguity
    case CheckoutStart is {
      user Customer wants to "begin the checkout process" so that
        "they can provide shipping and payment information"

      step from user Customer "views" page UserInterface.ShoppingCart
      // FIXED: Ambiguous reference by using renamed UI component
      step from user Customer "clicks" button UserInterface.ShoppingCart.CheckoutBtn
      // FIXED: Ambiguous references by using fully qualified paths
      step send command ShopifyCart.InitiateCheckout from source ShopifyCart.UserInterface.ShopperRequests to sink ShopifyCart.ShoppingContext.ShoppingIntake
      // FIXED: Ambiguous references by using fully qualified paths and renamed UI component
      step from entity ShopifyCart.ShoppingContext.Checkout "processes" to page UserInterface.CheckoutPage
      // FIXED: Ambiguous reference by using renamed UI component
      step focus user Customer on page UserInterface.CheckoutPage
    } with {
      briefly as "Starting the checkout process"
      described by {
        | This use case describes the process of a customer initiating
        | the checkout process from their shopping cart and providing
        | their shipping and billing information.
      }
    }

    case CompletePayment is {
      user Customer wants to "pay for their items" so that "they can complete their order"

      step from user Customer "views" page UserInterface.Payment
      step from user Customer "enters" form UserInterface.Payment.PaymentDetailsEntry
      step send command SelectPaymentMethod
        from source ShopifyCart.UserInterface.ShopperRequests
        to sink ShopifyCart.ShoppingContext.ShoppingIntake
      step from entity ShopifyCart.ShoppingContext.Checkout "validates" to entity ShopifyCart.ShoppingContext.Checkout
      step from user Customer "confirms" page UserInterface.Payment
      step send command CompleteCheckout from source ShopifyCart.UserInterface.ShopperRequests to sink ShopifyCart.ShoppingContext.ShoppingIntake
      step from entity ShopifyCart.ShoppingContext.Checkout "processes" to saga CheckoutProcess
      step focus user Customer on page UserInterface.CheckoutCompletedPage
    }
    with {
      briefly as "Providing payment and completing purchase"
      described by {
        | This use case describes the process of a customer providing
        | payment information and finalizing their purchase, which
        | results in an order being created.
      }
    }
  } with {
    briefly as "User stories related to the checkout process"
    described by {
      | This epic covers the checkout process including initiating checkout,
      | providing customer and shipping information, selecting payment methods,
      | and completing purchases. These features enable customers to finalize
      | their shopping experience and place orders.
    }
  }


  // Epic for inventory management
  epic InventoryEpic is {
    user StoreAdmin wants to "manage product inventory" so that "accurate stock levels are maintained"

    case UpdateProductInventory is {
      user StoreAdmin wants to "update product inventory levels" so that
        "stock is accurately reflected"

      step from user StoreAdmin "views" page UserInterface.ProductManagement
      step from user StoreAdmin "updates" form InventoryQuantity
      step send command ShopifyCart.UpdateInventory from source ShopifyCart.UserInterface.ShopperRequests to sink ShopifyCart.ShoppingContext.ShoppingIntake
      step from entity Product "processes" to entity Product
      step focus user StoreAdmin on page UserInterface.ProductManagement
    }
    with {
      briefly as "Updating product inventory quantities"
      described by {
        | This use case describes the process of a store administrator
        | updating the inventory quantity for a product, which may also
        | affect its inventory status.
      }
    }

    // FIXED: Renamed to avoid ambiguity
    case ProductPriceUpdate is {
      user StoreAdmin wants to "update product prices" so that "they can adjust for market conditions"

      step from user StoreAdmin "views" page UserInterface.ProductManagement
      step from user StoreAdmin "updates" item ProductPrice
      step send command ShopifyCart.UpdateProductPrice from source ShopifyCart.UserInterface.ShopperRequests to sink ShopifyCart.ShoppingContext.ShoppingIntake
      step from entity Product "processes" to entity Product
      step focus user StoreAdmin on page UserInterface.ProductManagement
    }
    with {
      briefly as "Changing product pricing"
      described by {
        | This use case describes the process of a store administrator
        | updating the price of a product to reflect market changes,
        | sales, or other pricing adjustments.
      }
    }
  } with {
    briefly as "User stories related to inventory management"
    described by {
      | This epic covers inventory management functionality, including
      | updating product inventory levels and prices. These features
      | enable store administrators to maintain accurate product information.
    }
  }
} with {
  briefly as "Shopify shopping cart domain model"
  described by {
    | This domain model represents a simplified Shopify shopping cart system.
    | It includes the core entities, commands, events, and processes required for
    | managing products, shopping carts, and the checkout process.
    |
    | The model demonstrates the reactive nature of the system through command
    | and event handlers, as well as sagas for managing complex workflows
    | like the checkout process.
    |
    | Key features include:
    | - Product and inventory management
    | - Shopping cart operations (add, remove, update)
    | - Multi-step checkout process with compensation
    | - Event-driven persistence through repositories
    | - Clearly defined user stories and interaction patterns
  }
}
