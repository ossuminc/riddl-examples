context Doodle is {

  inlet DrawingIn is command ToDoodles.Doodle.Drawing.CreateDrawing with {
    briefly as "Where drawing commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet DrawingDispatch is command ToDoodles.Doodle.Drawing.CreateDrawing with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  inlet Failures is record Riddl.GeneratorError with {
    option error-sink
    briefly as "Where hard errors go"
    described as {
      |RIDDL 2.0 wants every domain to name a destination for failures it
      |cannot handle. An error-sink inlet is infrastructure rather than
      |dataflow, so it does not count toward this processor's arity and
      |needs no connector.
    }
  }

  handler DoodleBoundary is {
    on request: command ToDoodles.Doodle.Drawing.CreateDrawing {
      send request to outlet ToDoodles.Doodle.DrawingDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }

  type DoodleId is Id(ToDoodles.Doodle.Drawing) with {
    briefly as "Unique identifier for a single doodle"
    described as {
      |Identifies one drawing. Defined inside the Doodle context because the
      |drawings are this context's concern.
    }
  }

  record DrawingData is {
    id is DoodleId,
    title is String,
    strokes is Natural
  } with {
    briefly as "The stored form of a single doodle"
    described as {
      |Everything ToDoodles keeps about one drawing: its identity, the title
      |the artist gave it, and how many strokes it took to make.
    }
  }





  entity Drawing is {

    inlet DrawingCommands is command ToDoodles.Doodle.Drawing.CreateDrawing with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet DrawingEvents is event DrawingCreated with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command CreateDrawing is {
      id is Id(Drawing),
      title is String
    } with {
      briefly as "Ask for a new doodle to be started"
      described as {
        |Sent when an artist begins a new drawing.
      }
    }

    query WhichDrawing is {
      id is DoodleId
    } with {
      briefly as "Ask for the current state of one doodle"
      described as {
        |Sent when a reader wants to see a drawing they already know of.
      }
    }

    result TheDrawing is {
      id is DoodleId,
      title is String
    } with {
      briefly as "The answer to a WhichDrawing query"
      described as {
        |Carries the identity and title of the requested drawing.
      }
    }

    event DrawingCreated is {
      id is DoodleId,
      title is String
    } with {
      briefly as "A new doodle came into being"
      described as {
        |Emitted once a drawing has been recorded.
      }
    }

    state DrawingState of record DrawingData with {
      briefly as "The state of one doodle"
      described as {
        |Holds the drawing's data for as long as it exists.
      }
    }

    handler DrawingHandler is {
      on init {
        set field DrawingState.strokes to "0"
      }
      on command CreateDrawing {
        morph entity Drawing to state DrawingState with record DrawingData(
          id = prompt("the id of the resulting Doodle state"),
          title = prompt("the title of the resulting Doodle state"),
          strokes = prompt("the strokes of the resulting Doodle state")
        )
        send event DrawingCreated(
          id = prompt("the id carried by DrawingCreated"),
          title = prompt("the title carried by DrawingCreated")
        ) to outlet ToDoodles.Doodle.Drawing.DrawingEvents
      }
      on query WhichDrawing {
        reply result TheDrawing(
          id = prompt("the id carried by TheDrawing"),
          title = prompt("the title carried by TheDrawing")
        )
      }
    } with {
      briefly as "Handles messages addressed to a drawing"
      described as {
        |Initializes a new drawing, records the command that creates it, and
        |answers questions about it.
      }
    }

  } with {
    briefly as "A single artistic doodle"
    described as {
      |The Drawing entity is one doodle. It is created once and thereafter
      |only its title and stroke count change.
    }
  }



  repository Drawings is {
    inlet Recorded is event DrawingCreated with {
      briefly as "Where drawing events arrive to be persisted"
      described as {
        |The repository learns of new drawings through this inlet.
      }
    }
    schema Store is flat
      of Held as record DrawingData
    with {
      briefly as "How drawings are laid out in storage"
      described as {
        |A flat schema: one stored row per drawing.
      }
    }
    handler StoreHandler is {
      on event DrawingCreated {
        do "store the title carried by the event"
      }
    } with {
      briefly as "Keeps storage in step with what happened"
      described as {
        |Writes each drawing event into the store.
      }
    }
  } with {
    briefly as "Persists the drawings of this context"
    described as {
      |Entities are stateful, so the Doodle context keeps a repository in
      |which their state outlives any single process.
    }
  }

  connector ErrorReporting is {
    from outlet Riddl.ForeverEmpty.void to inlet ToDoodles.Doodle.Failures
  } with {
    briefly as "Terminates the error-sink inlet"
    described as {
      |Nothing in this model produces a GeneratorError — those come from
      |generators at runtime, not from anything the model declares. The
      |predefined ForeverEmpty source exists for exactly this: a port that
      |must be connected but has no modelled producer.
    }
  }

  connector AddressingDrawing is {
    from outlet ToDoodles.Doodle.DrawingDispatch to inlet ToDoodles.Doodle.Drawing.DrawingCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector Recording is {
    from outlet ToDoodles.Doodle.Drawing.DrawingEvents to inlet Drawings.Recorded
  } with {
    briefly as "Carries drawing events to storage"
    described as {
      |Connects what the Drawing entity announces to the repository that
      |records it.
    }
  }

} with {
  briefly as "Owns the doodles themselves"
  described as {
    |The Doodle context is responsible for individual drawings: creating
    |them, naming them, and keeping their contents. It knows nothing about
    |the lists that gather them, which is the List context's concern.
  }
}
