context List as flow is {

  inlet DoodleListIn is command ToDoodles.List.DoodleList.CreateList with {
    briefly as "Where doodlelist commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet DoodleListDispatch is command ToDoodles.List.DoodleList.CreateList with {
    briefly as "Where entering commands are handed inward"
    described as {
      |Inside the boundary nothing is restricted.
    }
  }

  handler ListBoundary is {
    on request: command ToDoodles.List.DoodleList.CreateList {
      send request to outlet ToDoodles.List.DoodleListDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary inward"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }

  type ListId is Id(ToDoodles.List.DoodleList) with {
    briefly as "Unique identifier for a doodle list"
    described as {
      |Identifies one named collection of doodles. Defined inside the List
      |context because the lists are this context's concern.
    }
  }

  type DoodleKey is String with {
    briefly as "How this context refers to a doodle it does not own"
    described as {
      |The List context stores the identifier of a drawing without depending
      |on the Doodle context's own identifier type. Contexts do not share
      |types; they exchange messages.
    }
  }

  record DoodleListData is {
    listId is ListId,
    name is String,
    entries is many DoodleKey
  } with {
    briefly as "The stored form of one named list of doodles"
    described as {
      |A list has a name and holds keys identifying the doodles gathered
      |into it. The drawings themselves belong to the Doodle context.
    }
  }







  entity DoodleList as flow is {

    inlet DoodleListCommands is command ToDoodles.List.DoodleList.CreateList with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet DoodleListEvents is type ListEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command CreateList is {
      doodleListId is Id(DoodleList),
      name is String
    } with {
      briefly as "Ask for a new, empty doodle list"
      described as {
        |Sent when a user wants somewhere to gather doodles.
      }
    }

    command AddDoodleToList is {
      list is ListId,
      doodle is DoodleKey
    } with {
      briefly as "Put an existing doodle onto a list"
      described as {
        |Sent when a user files a drawing under one of their lists.
      }
    }

    query WhichList replies result TheList is {
      listId is ListId
    } with {
      briefly as "Ask for the current contents of one list"
      described as {
        |Sent when a reader wants to see what a list holds.
      }
    }

    result TheList is {
      listId is ListId,
      name is String
    } with {
      briefly as "The answer to a WhichList query"
      described as {
        |Carries the identity and name of the requested list.
      }
    }

    event ListCreated is {
      listId is ListId,
      name is String
    } with {
      briefly as "A new list came into being"
      described as {
        |Emitted once an empty list has been recorded.
      }
    }

    event DoodleAddedToList is {
      list is ListId,
      doodle is DoodleKey
    } with {
      briefly as "A doodle joined a list"
      described as {
        |Emitted once a drawing has been recorded as a member of a list.
      }
    }

    state DoodleListState of record DoodleListData with {
      briefly as "The state of one doodle list"
      described as {
        |Holds the list's name and its members.
      }
    }

    handler DoodleListHandler is {
      on init {
        set field DoodleListData.name to "untitled"
      }
      on command CreateList {
        morph entity DoodleList to state DoodleListState with record DoodleListData(
          listId = prompt("the listId of the resulting List state"),
          name = prompt("the name of the resulting List state"),
          entries = prompt("the entries of the resulting List state")
        )
        send event ListCreated(
          listId = prompt("the listId carried by ListCreated"),
          name = prompt("the name carried by ListCreated")
        ) to outlet ToDoodles.List.DoodleList.DoodleListEvents
      }
      on command AddDoodleToList {
        set field DoodleListData.entries to "the list's members plus this doodle"
        send event DoodleAddedToList(
          list = prompt("the list carried by DoodleAddedToList"),
          doodle = prompt("the doodle carried by DoodleAddedToList")
        ) to outlet ToDoodles.List.DoodleList.DoodleListEvents
      }
      on query WhichList {
        reply result TheList(
          listId = prompt("the listId carried by TheList"),
          name = prompt("the name carried by TheList")
        )
      }
    } with {
      briefly as "Handles messages addressed to a doodle list"
      described as {
        |Creates lists, adds members to them, and answers questions about
        |what they contain.
      }
    }

  } with {
    briefly as "A named collection of doodles"
    described as {
      |The DoodleList entity is one list. Lists are created empty and then
      |gain and lose members over their lifetime.
    }
  }

  type ListEvent is one of { event ListCreated or event DoodleAddedToList } with {
    briefly as "Anything the List context announces"
    described as {
      |The alternation of every event this context publishes, so that one
      |outlet can carry them all.
    }
  }



  repository Lists as sink is {
    command PersistListCreated is {
      listId is ListId
    } with {
      briefly as "Apply ListCreated to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    command PersistDoodleAddedToList is {
      list is ListId
    } with {
      briefly as "Apply DoodleAddedToList to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    type ListsCommand is one of { command PersistListCreated or command PersistDoodleAddedToList } with {
      briefly as "Anything this store can be told to do"
      described as {
        |One alternation so a single inlet and connector carry them all.
      }
    }

    inlet Recorded is type ToDoodles.List.Lists.ListsCommand with {
      briefly as "Where list persistence commands arrive"
      described as {
        |A projector turns each list event into one of these.
      }
    }
    schema Store is flat
      of Held as record ToDoodles.List.ListProjection.Projected
    with {
      briefly as "How lists are laid out in storage"
      described as {
        |A flat schema: one stored row per list.
      }
    }
    handler StoreHandler is {
      on command ToDoodles.List.Lists.PersistListCreated {
        do "apply what PersistListCreated carries to the stored row"
      }
      on command ToDoodles.List.Lists.PersistDoodleAddedToList {
        do "apply what PersistDoodleAddedToList carries to the stored row"
      }
    } with {
      briefly as "Keeps storage in step with what happened"
      described as {
        |Writes each list event into the store.
      }
    }
  } with {
    briefly as "Persists the lists of this context"
    described as {
      |Entities are stateful, so the List context keeps a repository in
      |which their state outlives any single process.
    }
  }

  connector AddressingDoodleList is {
    from outlet ToDoodles.List.DoodleListDispatch to inlet ToDoodles.List.DoodleList.DoodleListCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  projector ListProjection as flow is {
    inlet Observed is type ToDoodles.List.ListEvent with {
      briefly as "Where list events are observed"
      described as {
        |The projector sees what was announced.
      }
    }

    outlet Persisting is type ToDoodles.List.Lists.ListsCommand with {
      briefly as "Where persistence commands leave for the store"
      described as {
        |Turning each event into a command is the projector's whole job.
      }
    }

    updates repository ToDoodles.List.Lists

    record Projected is {
      listId is ListId
    } with {
      briefly as "The shape this projection maintains"
      described as {
        |One projected row per list. The store holds exactly this.
      }
    }

    handler ListProjectionHandler is {
      on listCreated: event ToDoodles.List.DoodleList.ListCreated {
        tell command ToDoodles.List.Lists.PersistListCreated(
          listId = listCreated.listId
        ) to repository ToDoodles.List.Lists
      }
      on doodleAddedToList: event ToDoodles.List.DoodleList.DoodleAddedToList {
        tell command ToDoodles.List.Lists.PersistDoodleAddedToList(
          list = doodleAddedToList.list
        ) to repository ToDoodles.List.Lists
      }
    } with {
      briefly as "Turns list events into persistence commands"
      described as {
        |A repository is changed by commands, so something must translate.
      }
    }
  } with {
    briefly as "Projects list events into the store"
    described as {
      |Stands between what was announced and what the store is told.
    }
  }

  connector ObservingListProjection is {
    from outlet ToDoodles.List.DoodleList.DoodleListEvents to inlet ToDoodles.List.ListProjection.Observed
  } with {
    briefly as "Carries list events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector Recording is {
    from outlet ToDoodles.List.ListProjection.Persisting to inlet Lists.Recorded
  } with {
    briefly as "Carries list events to storage"
    described as {
      |Connects what the context announces to the repository that records
      |it.
    }
  }

} with {
  briefly as "Owns the lists that gather doodles"
  described as {
    |The List context is responsible for the named collections a user files
    |their doodles into. It refers to drawings only by key, leaving their
    |contents to the Doodle context.
  }
}
