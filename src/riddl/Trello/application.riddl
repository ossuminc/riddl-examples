application context TrelloUI as router is {

  inlet UserManagementStaged is command Trello.UserManagement.Account.CreateAccount with {
    briefly as "Where the application's UserManagement requests collect"
    described as {
      |An inner source cannot reach across the boundary, so it delivers here.
    }
  }

  outlet UserManagementSubmissions is type Trello.UserManagement.UserManagementCommand with {
    briefly as "Where UserManagement requests leave this context"
    described as {
      |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
    }
  }

  connector StagingUserManagement is {
    from outlet Trello.TrelloUI.UserManagementRequests.Staged
    to inlet Trello.TrelloUI.UserManagementStaged
  } with {
    briefly as "Carries application requests to the context boundary"
    described as {
      |Intra-context, so it may address the source's own outlet directly.
    }
  }

  inlet WorkspaceManagementStaged is command Trello.WorkspaceManagement.Workspace.CreateWorkspace with {
    briefly as "Where the application's WorkspaceManagement requests collect"
    described as {
      |An inner source cannot reach across the boundary, so it delivers here.
    }
  }

  outlet WorkspaceManagementSubmissions is type Trello.WorkspaceManagement.WorkspaceManagementCommand with {
    briefly as "Where WorkspaceManagement requests leave this context"
    described as {
      |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
    }
  }

  connector StagingWorkspaceManagement is {
    from outlet Trello.TrelloUI.WorkspaceManagementRequests.Staged
    to inlet Trello.TrelloUI.WorkspaceManagementStaged
  } with {
    briefly as "Carries application requests to the context boundary"
    described as {
      |Intra-context, so it may address the source's own outlet directly.
    }
  }

  inlet BoardManagementStaged is command Trello.BoardManagement.Board.CreateBoard with {
    briefly as "Where the application's BoardManagement requests collect"
    described as {
      |An inner source cannot reach across the boundary, so it delivers here.
    }
  }

  outlet BoardManagementSubmissions is type Trello.BoardManagement.BoardManagementCommand with {
    briefly as "Where BoardManagement requests leave this context"
    described as {
      |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
    }
  }

  connector StagingBoardManagement is {
    from outlet Trello.TrelloUI.BoardManagementRequests.Staged
    to inlet Trello.TrelloUI.BoardManagementStaged
  } with {
    briefly as "Carries application requests to the context boundary"
    described as {
      |Intra-context, so it may address the source's own outlet directly.
    }
  }

  handler TrelloUIBoundary is {
    on createAccount: command Trello.UserManagement.Account.CreateAccount {
      send createAccount to outlet Trello.TrelloUI.UserManagementSubmissions
    }
    on createWorkspace: command Trello.WorkspaceManagement.Workspace.CreateWorkspace {
      send createWorkspace to outlet Trello.TrelloUI.WorkspaceManagementSubmissions
    }
    on createBoard: command Trello.BoardManagement.Board.CreateBoard {
      send createBoard to outlet Trello.TrelloUI.BoardManagementSubmissions
    }
  } with {
    briefly as "Republishes staged requests on the context's own outlets"
    described as {
      |The application's internals stay private; peers see only these outlets.
    }
  }

  record BoardEntry is {
    title is String
  } with {
    briefly as "What a member types when creating a board"
    described as {
      |The application collects a title; everything else is defaulted.
    }
  }

  record BoardSummary is {
    title is String,
    lists is Integer
  } with {
    briefly as "What the application shows about a board"
    described as {
      |Enough to draw a row on the boards page.
    }
  }

  page BoardsPage is {
    list MyBoards shows record BoardSummary with {
      briefly as "The boards a member can open"
      described as {
        |One row per board the member belongs to.
      }
    }
    list JustCreated shows record BoardEntry with {
      briefly as "Echoes back the board just named"
      described as {
        |Confirms what was typed before the board list catches up.
      }
    }
    form NewBoard acquires record BoardEntry with {
      briefly as "Where a new board is named"
      described as {
        |Collects the title, then asks BoardManagement to create it.
      }
    }
  } with {
    briefly as "Where a member sees and creates boards"
    described as {
      |The landing screen of the application.
    }
  }

  handler BoardsPageHandler is {
    on command Trello.BoardManagement.Board.CreateBoard {
      put get from form NewBoard to list JustCreated
    }
  } with {
    briefly as "Reads what the member typed and refreshes what they see"
    described as {
      |Only an application context may `get` from an input or `put` to an
      |output, so the screen's own behaviour lives here.
    }
  }

    processor UserManagementRequests as source is {
      outlet Staged is command Trello.UserManagement.Account.CreateAccount with {
        briefly as "Where UserManagement requests leave the application"
        described as {
          |Requests reach the UserManagement context over a domain-scoped connector.
        }
      }
      handler UserManagementRequestsHandler is {
        on command Trello.UserManagement.Account.CreateAccount {
          send command Trello.UserManagement.Account.CreateAccount(
            accountId = prompt("the accountId carried by CreateAccount"),
            username = prompt("the username carried by CreateAccount"),
            email = prompt("the email carried by CreateAccount")
          ) to outlet Trello.TrelloUI.UserManagementRequests.Staged
        }
        on other {
          do "forward whatever else the member asked of UserManagement"
        }
      } with {
        briefly as "Forwards UserManagement requests into the domain"
        described as {
          |Runs when a page raises a command bound for UserManagement.
        }
      }
    } with {
      briefly as "The application's outbound path to UserManagement"
      described as {
        |A source streamlet: what the member asked for, on its way in.
      }
    }

    processor WorkspaceManagementRequests as source is {
      outlet Staged is command Trello.WorkspaceManagement.Workspace.CreateWorkspace with {
        briefly as "Where WorkspaceManagement requests leave the application"
        described as {
          |Requests reach the WorkspaceManagement context over a domain-scoped connector.
        }
      }
      handler WorkspaceManagementRequestsHandler is {
        on command Trello.WorkspaceManagement.Workspace.CreateWorkspace {
          send command Trello.WorkspaceManagement.Workspace.CreateWorkspace(
            workspaceId = prompt("the workspaceId carried by CreateWorkspace"),
            name = prompt("the name carried by CreateWorkspace"),
            visibility = prompt("the visibility carried by CreateWorkspace")
          ) to outlet Trello.TrelloUI.WorkspaceManagementRequests.Staged
        }
        on other {
          do "forward whatever else the member asked of WorkspaceManagement"
        }
      } with {
        briefly as "Forwards WorkspaceManagement requests into the domain"
        described as {
          |Runs when a page raises a command bound for WorkspaceManagement.
        }
      }
    } with {
      briefly as "The application's outbound path to WorkspaceManagement"
      described as {
        |A source streamlet: what the member asked for, on its way in.
      }
    }

    processor BoardManagementRequests as source is {
      outlet Staged is command Trello.BoardManagement.Board.CreateBoard with {
        briefly as "Where BoardManagement requests leave the application"
        described as {
          |Requests reach the BoardManagement context over a domain-scoped connector.
        }
      }
      handler BoardManagementRequestsHandler is {
        on command Trello.BoardManagement.Board.CreateBoard {
          send command Trello.BoardManagement.Board.CreateBoard(
            boardId = prompt("the boardId carried by CreateBoard"),
            title = prompt("the title carried by CreateBoard"),
            visibility = prompt("the visibility carried by CreateBoard")
          ) to outlet Trello.TrelloUI.BoardManagementRequests.Staged
        }
        on other {
          do "forward whatever else the member asked of BoardManagement"
        }
      } with {
        briefly as "Forwards BoardManagement requests into the domain"
        described as {
          |Runs when a page raises a command bound for BoardManagement.
        }
      }
    } with {
      briefly as "The application's outbound path to BoardManagement"
      described as {
        |A source streamlet: what the member asked for, on its way in.
      }
    }

} with {
  briefly as "The application through which members reach Trello"
  described as {
    |TrelloUI is the only place a member touches this system. RIDDL 2.0
    |requires the application intention on any context holding UI groups and
    |confines user interaction to the application boundary.
  }
  option is technology("react.js")
}
