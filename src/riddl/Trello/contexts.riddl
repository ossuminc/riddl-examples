context UserManagement as split is {

  inlet Failures is record Riddl.GeneratorError with {
    option error-sink
    briefly as "Where hard errors go"
    described as {
      |RIDDL 2.0 wants every domain to name a destination for failures no
      |handler can recover from. An error-sink inlet is infrastructure
      |rather than dataflow, so it does not count toward this processor's
      |arity.
    }
  }

  inlet UserManagementIn is type Trello.UserManagement.UserManagementCommand with {
    briefly as "Where commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet AccountDispatch is type Trello.UserManagement.AccountCommand with {
    briefly as "Where entering commands bound for Account are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  outlet NotificationDispatch is type Trello.UserManagement.NotificationCommand with {
    briefly as "Where entering commands bound for Notification are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  handler UserManagementBoundary is {
    on createAccount: command Trello.UserManagement.Account.CreateAccount {
      send createAccount to outlet Trello.UserManagement.AccountDispatch
    }
    on updateProfile: command Trello.UserManagement.Account.UpdateProfile {
      send updateProfile to outlet Trello.UserManagement.AccountDispatch
    }
    on updateSettings: command Trello.UserManagement.Account.UpdateSettings {
      send updateSettings to outlet Trello.UserManagement.AccountDispatch
    }
    on createNotification: command Trello.UserManagement.Notification.CreateNotification {
      send createNotification to outlet Trello.UserManagement.NotificationDispatch
    }
    on markAsRead: command Trello.UserManagement.Notification.MarkAsRead {
      send markAsRead to outlet Trello.UserManagement.NotificationDispatch
    }
    on markAllAsRead: command Trello.UserManagement.Notification.MarkAllAsRead {
      send markAllAsRead to outlet Trello.UserManagement.NotificationDispatch
    }
    on other {
      error "unexpected message at the UserManagement boundary"
    }
  } with {
    briefly as "Routes what arrives at the boundary to the entity that owns it"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type AccountId is Id(Trello.UserManagement.Account) with {
    briefly as "Unique identifier for one user"
    described as {
      |Defined inside UserManagement because user identity is this context's concern.
    }
  }

  entity Account as flow is {

    inlet AccountCommands is type Trello.UserManagement.AccountCommand with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet AccountEvents is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command CreateAccount is {
      accountId is Id(Account),
      username is String,
      email is String
    } with {
      briefly as "Ask for a user to be created"
      described as {
        |Sent when a person joined Trello.
      }
    }

    command UpdateProfile is {
      accountId is Trello.UserManagement.AccountId
    } with {
      briefly as "Change a member's profile"
      described as {
        |Sent when change a member's profile.
      }
    }

    command UpdateSettings is {
      accountId is Trello.UserManagement.AccountId
    } with {
      briefly as "Change a member's settings"
      described as {
        |Sent when change a member's settings.
      }
    }

    query WhichAccount replies result TheAccount is {
      accountId is Trello.UserManagement.AccountId
    } with {
      briefly as "Ask for the current state of one user"
      described as {
        |Sent when a reader wants a user they already know of.
      }
    }

    result TheAccount is {
      accountId is Trello.UserManagement.AccountId,
      summary is String
    } with {
      briefly as "The answer to a WhichAccount query"
      described as {
        |Carries the identity and a short summary of the user.
      }
    }

    event AccountCreated is {
      accountId is Trello.UserManagement.AccountId
    } with {
      briefly as "Records that a person joined Trello"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record AccountFields is {
      accountId is Trello.UserManagement.AccountId,
      username is String,
      email is String
    } with {
      briefly as "Everything Trello keeps about one user"
      described as {
        |The stored shape of a user.
      }
    }

    initial state AccountState of record Trello.UserManagement.Account.AccountFields with {
      briefly as "The state of one user"
      described as {
        |A user has a single state; its fields change over its lifetime.
      }
    }

    handler AccountHandler is {
      on init {
        set field Trello.UserManagement.Account.AccountFields.accountId to "a freshly minted identifier"
      }
      on command CreateAccount {
        morph entity Account to state AccountState with record Trello.UserManagement.Account.AccountFields(
          accountId = prompt("the accountId of the resulting Account state"),
          username = prompt("the username of the resulting Account state"),
          email = prompt("the email of the resulting Account state")
        )
        send event AccountCreated(
          accountId = prompt("the accountId carried by AccountCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on command UpdateProfile {
        morph entity Account to state AccountState with record Trello.UserManagement.Account.AccountFields(
          accountId = prompt("the accountId of the resulting Account state"),
          username = prompt("the username of the resulting Account state"),
          email = prompt("the email of the resulting Account state")
        )
        send event AccountCreated(
          accountId = prompt("the accountId carried by AccountCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on command UpdateSettings {
        morph entity Account to state AccountState with record Trello.UserManagement.Account.AccountFields(
          accountId = prompt("the accountId of the resulting Account state"),
          username = prompt("the username of the resulting Account state"),
          email = prompt("the email of the resulting Account state")
        )
        send event AccountCreated(
          accountId = prompt("the accountId carried by AccountCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on query WhichAccount {
        reply result TheAccount(
          accountId = prompt("the accountId carried by TheAccount"),
          summary = prompt("the summary carried by TheAccount")
        )
      }
    } with {
      briefly as "Handles messages addressed to a user"
      described as {
        |Creates and changes users and answers questions about them.
      }
    }

  } with {
    briefly as "A single user in Trello"
    described as {
      |The entity that remembers that a person joined Trello.
    }
  }

  type NotificationId is Id(Trello.UserManagement.Notification) with {
    briefly as "Unique identifier for one notification"
    described as {
      |Defined inside UserManagement because notification identity is this context's concern.
    }
  }

  entity Notification as flow is {

    inlet NotificationCommands is type Trello.UserManagement.NotificationCommand with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet NotificationEvents is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command CreateNotification is {
      notificationId is Id(Notification),
      text is String,
      read is Boolean
    } with {
      briefly as "Ask for a notification to be created"
      described as {
        |Sent when a member was told something.
      }
    }

    command MarkAsRead is {
      notificationId is Trello.UserManagement.NotificationId
    } with {
      briefly as "Mark one notification read"
      described as {
        |Sent when mark one notification read.
      }
    }

    command MarkAllAsRead is {
      notificationId is Trello.UserManagement.NotificationId
    } with {
      briefly as "Mark every notification read"
      described as {
        |Sent when mark every notification read.
      }
    }

    query WhichNotification replies result TheNotification is {
      notificationId is Trello.UserManagement.NotificationId
    } with {
      briefly as "Ask for the current state of one notification"
      described as {
        |Sent when a reader wants a notification they already know of.
      }
    }

    result TheNotification is {
      notificationId is Trello.UserManagement.NotificationId,
      summary is String
    } with {
      briefly as "The answer to a WhichNotification query"
      described as {
        |Carries the identity and a short summary of the notification.
      }
    }

    event NotificationCreated is {
      notificationId is Trello.UserManagement.NotificationId
    } with {
      briefly as "Records that a member was told something"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record NotificationFields is {
      notificationId is Trello.UserManagement.NotificationId,
      text is String,
      read is Boolean
    } with {
      briefly as "Everything Trello keeps about one notification"
      described as {
        |The stored shape of a notification.
      }
    }

    initial state NotificationState of record Trello.UserManagement.Notification.NotificationFields with {
      briefly as "The state of one notification"
      described as {
        |A notification has a single state; its fields change over its lifetime.
      }
    }

    handler NotificationHandler is {
      on init {
        set field Trello.UserManagement.Notification.NotificationFields.notificationId to "a freshly minted identifier"
      }
      on command CreateNotification {
        morph entity Notification to state NotificationState with record Trello.UserManagement.Notification.NotificationFields(
          notificationId = prompt("the notificationId of the resulting Notification state"),
          text = prompt("the text of the resulting Notification state"),
          read = prompt("the read of the resulting Notification state")
        )
        send event NotificationCreated(
          notificationId = prompt("the notificationId carried by NotificationCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on command MarkAsRead {
        morph entity Notification to state NotificationState with record Trello.UserManagement.Notification.NotificationFields(
          notificationId = prompt("the notificationId of the resulting Notification state"),
          text = prompt("the text of the resulting Notification state"),
          read = prompt("the read of the resulting Notification state")
        )
        send event NotificationCreated(
          notificationId = prompt("the notificationId carried by NotificationCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on command MarkAllAsRead {
        morph entity Notification to state NotificationState with record Trello.UserManagement.Notification.NotificationFields(
          notificationId = prompt("the notificationId of the resulting Notification state"),
          text = prompt("the text of the resulting Notification state"),
          read = prompt("the read of the resulting Notification state")
        )
        send event NotificationCreated(
          notificationId = prompt("the notificationId carried by NotificationCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on query WhichNotification {
        reply result TheNotification(
          notificationId = prompt("the notificationId carried by TheNotification"),
          summary = prompt("the summary carried by TheNotification")
        )
      }
    } with {
      briefly as "Handles messages addressed to a notification"
      described as {
        |Creates and changes notifications and answers questions about them.
      }
    }

  } with {
    briefly as "A single notification in Trello"
    described as {
      |The entity that remembers that a member was told something.
    }
  }

  type UserManagementEvent is one of {
    event Trello.UserManagement.Account.AccountCreated or
    event Trello.UserManagement.Notification.NotificationCreated
  } with {
    briefly as "Anything UserManagement announces"
    described as {
      |The alternation of every event this context publishes, so one outlet
      |can carry them all.
    }
  }

  type AccountCommand is one of {
    command Trello.UserManagement.Account.CreateAccount or
    command Trello.UserManagement.Account.UpdateProfile or
    command Trello.UserManagement.Account.UpdateSettings
  } with {
    briefly as "What Account can be asked to do"
    described as {
      |A port carries only what its owner handles.
    }
  }

  type NotificationCommand is one of {
    command Trello.UserManagement.Notification.CreateNotification or
    command Trello.UserManagement.Notification.MarkAsRead or
    command Trello.UserManagement.Notification.MarkAllAsRead
  } with {
    briefly as "What Notification can be asked to do"
    described as {
      |A port carries only what its owner handles.
    }
  }

  type UserManagementCommand is one of {
    command Trello.UserManagement.Account.CreateAccount or
    command Trello.UserManagement.Account.UpdateProfile or
    command Trello.UserManagement.Account.UpdateSettings or
    command Trello.UserManagement.Notification.CreateNotification or
    command Trello.UserManagement.Notification.MarkAsRead or
    command Trello.UserManagement.Notification.MarkAllAsRead
  } with {
    briefly as "Everything UserManagement can be asked to do"
    described as {
      |The alternation of every command the application sends here, so one
      |inlet and one connector can carry them all.
    }
  }

  processor UserManagementAnnouncer as merge is {
    inlet FromAccount is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Events arriving from Account"
      described as {
        |Each entity publishes on its own outlet; this merges them.
      }
    }

    inlet FromNotification is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Events arriving from Notification"
      described as {
        |Each entity publishes on its own outlet; this merges them.
      }
    }

    outlet Published is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Where UserManagement publishes what happened"
      described as {
        |Events leave this context through this outlet.
      }
    }
    handler UserManagementAnnouncerHandler is {
      on event Trello.UserManagement.Account.AccountCreated {
        send event Trello.UserManagement.Account.AccountCreated(
          accountId = prompt("the accountId carried by AccountCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on other {
        do "publish any other event this context raises"
      }
    } with {
      briefly as "Publishes UserManagement events"
      described as {
        |Puts each event an entity announced onto the outlet.
      }
    }
  } with {
    briefly as "The context's publication point"
    described as {
      |A source streamlet carrying what UserManagement wants known elsewhere.
    }
  }


  repository UserManagementStore as sink is {
    command PersistAccountCreated is {
      accountId is Trello.UserManagement.AccountId
    } with {
      briefly as "Apply AccountCreated to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    command PersistNotificationCreated is {
      notificationId is Trello.UserManagement.NotificationId
    } with {
      briefly as "Apply NotificationCreated to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    type UserManagementStoreCommand is one of { command PersistAccountCreated or command PersistNotificationCreated } with {
      briefly as "Anything this store can be told to do"
      described as {
        |One alternation so a single inlet and connector carry them all.
      }
    }

    inlet Recorded is type Trello.UserManagement.UserManagementStore.UserManagementStoreCommand with {
      briefly as "Where user management persistence commands arrive"
      described as {
        |A projector turns each user management event into one of these.
      }
    }
    schema UserManagementSchema is flat
      of Held as record Trello.UserManagement.UserManagementProjection.Projected
    with {
      briefly as "How UserManagement records are laid out in storage"
      described as {
        |A flat schema: one stored row per record.
      }
    }
    handler UserManagementStoreHandler is {
      on command Trello.UserManagement.UserManagementStore.PersistAccountCreated {
        do "apply what PersistAccountCreated carries to the stored row"
      }
      on command Trello.UserManagement.UserManagementStore.PersistNotificationCreated {
        do "apply what PersistNotificationCreated carries to the stored row"
      }
    } with {
      briefly as "Keeps storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists what this context owns"
    described as {
      |Entities are stateful, so UserManagement keeps a repository.
    }
  }

  connector ErrorReporting is {
    from outlet Riddl.ForeverEmpty.void to inlet Trello.UserManagement.Failures
  } with {
    briefly as "Terminates the error-sink inlet"
    described as {
      |Nothing in this model produces a GeneratorError — those come from
      |generators at runtime, not from anything the model declares. The
      |predefined ForeverEmpty source exists for exactly this: a port that
      |must be connected but has no modelled producer.
    }
  }

  connector AddressingAccount is {
    from outlet Trello.UserManagement.AccountDispatch to inlet Trello.UserManagement.Account.AccountCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector AddressingNotification is {
    from outlet Trello.UserManagement.NotificationDispatch to inlet Trello.UserManagement.Notification.NotificationCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector AnnouncingAccount is {
    from outlet Trello.UserManagement.Account.AccountEvents to inlet Trello.UserManagement.UserManagementAnnouncer.FromAccount
  } with {
    briefly as "Carries this entity's events to the context's announcer"
    described as {
      |Publishing goes out the entity's own outlet and merges downstream.
    }
  }

  connector AnnouncingNotification is {
    from outlet Trello.UserManagement.Notification.NotificationEvents to inlet Trello.UserManagement.UserManagementAnnouncer.FromNotification
  } with {
    briefly as "Carries this entity's events to the context's announcer"
    described as {
      |Publishing goes out the entity's own outlet and merges downstream.
    }
  }

  projector UserManagementProjection as flow is {
    inlet Observed is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Where user management events are observed"
      described as {
        |The projector sees what was announced.
      }
    }

    outlet Persisting is type Trello.UserManagement.UserManagementStore.UserManagementStoreCommand with {
      briefly as "Where persistence commands leave for the store"
      described as {
        |Turning each event into a command is the projector's whole job.
      }
    }

    updates repository Trello.UserManagement.UserManagementStore

    record Projected is {
      accountId is Trello.UserManagement.AccountId
    } with {
      briefly as "The shape this projection maintains"
      described as {
        |One projected row per user management. The store holds exactly this.
      }
    }

    handler UserManagementProjectionHandler is {
      on accountCreated: event Trello.UserManagement.Account.AccountCreated {
        tell command Trello.UserManagement.UserManagementStore.PersistAccountCreated(
          accountId = accountCreated.accountId
        ) to repository Trello.UserManagement.UserManagementStore
      }
      on notificationCreated: event Trello.UserManagement.Notification.NotificationCreated {
        tell command Trello.UserManagement.UserManagementStore.PersistNotificationCreated(
          notificationId = notificationCreated.notificationId
        ) to repository Trello.UserManagement.UserManagementStore
      }
    } with {
      briefly as "Turns user management events into persistence commands"
      described as {
        |A repository is changed by commands, so something must translate.
      }
    }
  } with {
    briefly as "Projects user management events into the store"
    described as {
      |Stands between what was announced and what the store is told.
    }
  }

  connector ObservingUserManagementProjection is {
    from outlet UserManagementAnnouncer.Published to inlet Trello.UserManagement.UserManagementProjection.Observed
  } with {
    briefly as "Carries user management events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector UserManagementRecording is {
    from outlet Trello.UserManagement.UserManagementProjection.Persisting to inlet UserManagementStore.Recorded
  } with {
    briefly as "Carries UserManagement events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Members and what they are told"
  described as {
    |Owns who a Trello member is, their profile and settings, and the
    |notifications addressed to them.
  }
}

context WorkspaceManagement as flow is {

  inlet WorkspaceManagementIn is type Trello.WorkspaceManagement.WorkspaceManagementCommand with {
    briefly as "Where commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet WorkspaceDispatch is type Trello.WorkspaceManagement.WorkspaceManagementCommand with {
    briefly as "Where entering commands bound for Workspace are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  handler WorkspaceManagementBoundary is {
    on createWorkspace: command Trello.WorkspaceManagement.Workspace.CreateWorkspace {
      send createWorkspace to outlet Trello.WorkspaceManagement.WorkspaceDispatch
    }
    on addWorkspaceMember: command Trello.WorkspaceManagement.Workspace.AddWorkspaceMember {
      send addWorkspaceMember to outlet Trello.WorkspaceManagement.WorkspaceDispatch
    }
    on updateWorkspaceSettings: command Trello.WorkspaceManagement.Workspace.UpdateWorkspaceSettings {
      send updateWorkspaceSettings to outlet Trello.WorkspaceManagement.WorkspaceDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary to the entity that owns it"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type WorkspaceId is Id(Trello.WorkspaceManagement.Workspace) with {
    briefly as "Unique identifier for one workspace"
    described as {
      |Defined inside WorkspaceManagement because workspace identity is this context's concern.
    }
  }

  entity Workspace as flow is {

    inlet WorkspaceCommands is type Trello.WorkspaceManagement.WorkspaceManagementCommand with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet WorkspaceEvents is type Trello.WorkspaceManagement.WorkspaceManagementEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command CreateWorkspace is {
      workspaceId is Id(Workspace),
      name is String,
      visibility is String
    } with {
      briefly as "Ask for a workspace to be created"
      described as {
        |Sent when a workspace was created.
      }
    }

    command AddWorkspaceMember is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Add a member to a workspace"
      described as {
        |Sent when add a member to a workspace.
      }
    }

    command UpdateWorkspaceSettings is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Change a workspace's settings"
      described as {
        |Sent when change a workspace's settings.
      }
    }

    query WhichWorkspace replies result TheWorkspace is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Ask for the current state of one workspace"
      described as {
        |Sent when a reader wants a workspace they already know of.
      }
    }

    result TheWorkspace is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId,
      summary is String
    } with {
      briefly as "The answer to a WhichWorkspace query"
      described as {
        |Carries the identity and a short summary of the workspace.
      }
    }

    event WorkspaceMemberAdded is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Records that someone was admitted to a workspace"
      described as {
        |Emitted when a member gains access to the workspace's boards.
        |Distinct from WorkspaceCreated because admission happens many
        |times over a workspace's life, and other contexts care about it
        |separately.
      }
    }

    event WorkspaceCreated is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Records that a workspace was created"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record WorkspaceFields is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId,
      name is String,
      visibility is String
    } with {
      briefly as "Everything Trello keeps about one workspace"
      described as {
        |The stored shape of a workspace.
      }
    }

    initial state WorkspaceState of record Trello.WorkspaceManagement.Workspace.WorkspaceFields with {
      briefly as "The state of one workspace"
      described as {
        |A workspace has a single state; its fields change over its lifetime.
      }
    }

    handler WorkspaceHandler is {
      on init {
        set field Trello.WorkspaceManagement.Workspace.WorkspaceFields.workspaceId to "a freshly minted identifier"
      }
      on command CreateWorkspace {
        morph entity Workspace to state WorkspaceState with record Trello.WorkspaceManagement.Workspace.WorkspaceFields(
          workspaceId = prompt("the workspaceId of the resulting Workspace state"),
          name = prompt("the name of the resulting Workspace state"),
          visibility = prompt("the visibility of the resulting Workspace state")
        )
        send event WorkspaceCreated(
          workspaceId = prompt("the workspaceId carried by WorkspaceCreated")
        ) to outlet Trello.WorkspaceManagement.Workspace.WorkspaceEvents
      }
      on command AddWorkspaceMember {
        morph entity Workspace to state WorkspaceState with record Trello.WorkspaceManagement.Workspace.WorkspaceFields(
          workspaceId = prompt("the workspaceId of the resulting Workspace state"),
          name = prompt("the name of the resulting Workspace state"),
          visibility = prompt("the visibility of the resulting Workspace state")
        )
        send event WorkspaceMemberAdded(
          workspaceId = prompt("the workspaceId carried by WorkspaceMemberAdded")
        ) to outlet Trello.WorkspaceManagement.Workspace.WorkspaceEvents
      }
      on command UpdateWorkspaceSettings {
        morph entity Workspace to state WorkspaceState with record Trello.WorkspaceManagement.Workspace.WorkspaceFields(
          workspaceId = prompt("the workspaceId of the resulting Workspace state"),
          name = prompt("the name of the resulting Workspace state"),
          visibility = prompt("the visibility of the resulting Workspace state")
        )
        send event WorkspaceCreated(
          workspaceId = prompt("the workspaceId carried by WorkspaceCreated")
        ) to outlet Trello.WorkspaceManagement.Workspace.WorkspaceEvents
      }
      on query WhichWorkspace {
        reply result TheWorkspace(
          workspaceId = prompt("the workspaceId carried by TheWorkspace"),
          summary = prompt("the summary carried by TheWorkspace")
        )
      }
    } with {
      briefly as "Handles messages addressed to a workspace"
      described as {
        |Creates and changes workspaces and answers questions about them.
      }
    }

  } with {
    briefly as "A single workspace in Trello"
    described as {
      |The entity that remembers that a workspace was created.
    }
  }

  type WorkspaceManagementEvent is one of {
    event Trello.WorkspaceManagement.Workspace.WorkspaceCreated or
    event Trello.WorkspaceManagement.Workspace.WorkspaceMemberAdded
  } with {
    briefly as "Anything WorkspaceManagement announces"
    described as {
      |The alternation of every event this context publishes, so one outlet
      |can carry them all.
    }
  }

  type WorkspaceManagementCommand is one of {
    command Trello.WorkspaceManagement.Workspace.CreateWorkspace or
    command Trello.WorkspaceManagement.Workspace.AddWorkspaceMember or
    command Trello.WorkspaceManagement.Workspace.UpdateWorkspaceSettings
  } with {
    briefly as "Everything WorkspaceManagement can be asked to do"
    described as {
      |The alternation of every command the application sends here, so one
      |inlet and one connector can carry them all.
    }
  }



  repository WorkspaceManagementStore as sink is {
    command PersistWorkspaceCreated is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Apply WorkspaceCreated to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    command PersistWorkspaceMemberAdded is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Apply WorkspaceMemberAdded to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    type WorkspaceManagementStoreCommand is one of { command PersistWorkspaceCreated or command PersistWorkspaceMemberAdded } with {
      briefly as "Anything this store can be told to do"
      described as {
        |One alternation so a single inlet and connector carry them all.
      }
    }

    inlet Recorded is type Trello.WorkspaceManagement.WorkspaceManagementStore.WorkspaceManagementStoreCommand with {
      briefly as "Where workspace persistence commands arrive"
      described as {
        |A projector turns each workspace event into one of these.
      }
    }
    schema WorkspaceManagementSchema is flat
      of Held as record Trello.WorkspaceManagement.WorkspaceManagementProjection.Projected
    with {
      briefly as "How WorkspaceManagement records are laid out in storage"
      described as {
        |A flat schema: one stored row per record.
      }
    }
    handler WorkspaceManagementStoreHandler is {
      on command Trello.WorkspaceManagement.WorkspaceManagementStore.PersistWorkspaceCreated {
        do "apply what PersistWorkspaceCreated carries to the stored row"
      }
      on command Trello.WorkspaceManagement.WorkspaceManagementStore.PersistWorkspaceMemberAdded {
        do "apply what PersistWorkspaceMemberAdded carries to the stored row"
      }
    } with {
      briefly as "Keeps storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists what this context owns"
    described as {
      |Entities are stateful, so WorkspaceManagement keeps a repository.
    }
  }

  connector AddressingWorkspace is {
    from outlet Trello.WorkspaceManagement.WorkspaceDispatch to inlet Trello.WorkspaceManagement.Workspace.WorkspaceCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  projector WorkspaceManagementProjection as flow is {
    inlet Observed is type Trello.WorkspaceManagement.WorkspaceManagementEvent with {
      briefly as "Where workspace events are observed"
      described as {
        |The projector sees what was announced.
      }
    }

    outlet Persisting is type Trello.WorkspaceManagement.WorkspaceManagementStore.WorkspaceManagementStoreCommand with {
      briefly as "Where persistence commands leave for the store"
      described as {
        |Turning each event into a command is the projector's whole job.
      }
    }

    updates repository Trello.WorkspaceManagement.WorkspaceManagementStore

    record Projected is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "The shape this projection maintains"
      described as {
        |One projected row per workspace. The store holds exactly this.
      }
    }

    handler WorkspaceManagementProjectionHandler is {
      on workspaceCreated: event Trello.WorkspaceManagement.Workspace.WorkspaceCreated {
        tell command Trello.WorkspaceManagement.WorkspaceManagementStore.PersistWorkspaceCreated(
          workspaceId = workspaceCreated.workspaceId
        ) to repository Trello.WorkspaceManagement.WorkspaceManagementStore
      }
      on workspaceMemberAdded: event Trello.WorkspaceManagement.Workspace.WorkspaceMemberAdded {
        tell command Trello.WorkspaceManagement.WorkspaceManagementStore.PersistWorkspaceMemberAdded(
          workspaceId = workspaceMemberAdded.workspaceId
        ) to repository Trello.WorkspaceManagement.WorkspaceManagementStore
      }
    } with {
      briefly as "Turns workspace events into persistence commands"
      described as {
        |A repository is changed by commands, so something must translate.
      }
    }
  } with {
    briefly as "Projects workspace events into the store"
    described as {
      |Stands between what was announced and what the store is told.
    }
  }

  connector ObservingWorkspaceManagementProjection is {
    from outlet Trello.WorkspaceManagement.Workspace.WorkspaceEvents to inlet Trello.WorkspaceManagement.WorkspaceManagementProjection.Observed
  } with {
    briefly as "Carries workspace events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector WorkspaceManagementRecording is {
    from outlet Trello.WorkspaceManagement.WorkspaceManagementProjection.Persisting to inlet WorkspaceManagementStore.Recorded
  } with {
    briefly as "Carries WorkspaceManagement events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Workspaces and who belongs to them"
  described as {
    |Owns the workspaces that group boards together and the membership
    |that governs who may see them.
  }
}

context BoardManagement as split is {

  inlet BoardManagementIn is type Trello.BoardManagement.BoardManagementCommand with {
    briefly as "Where commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet BoardDispatch is type Trello.BoardManagement.BoardCommand with {
    briefly as "Where entering commands bound for Board are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  outlet CardListDispatch is type Trello.BoardManagement.CardListCommand with {
    briefly as "Where entering commands bound for CardList are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  outlet CardDispatch is type Trello.BoardManagement.CardCommand with {
    briefly as "Where entering commands bound for Card are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  outlet ActivityDispatch is command Trello.BoardManagement.Activity.RecordActivity with {
    briefly as "Where entering commands bound for Activity are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  handler BoardManagementBoundary is {
    on createBoard: command Trello.BoardManagement.Board.CreateBoard {
      send createBoard to outlet Trello.BoardManagement.BoardDispatch
    }
    on addBoardMember: command Trello.BoardManagement.Board.AddBoardMember {
      send addBoardMember to outlet Trello.BoardManagement.BoardDispatch
    }
    on addList: command Trello.BoardManagement.CardList.AddList {
      send addList to outlet Trello.BoardManagement.CardListDispatch
    }
    on moveList: command Trello.BoardManagement.CardList.MoveList {
      send moveList to outlet Trello.BoardManagement.CardListDispatch
    }
    on addCard: command Trello.BoardManagement.Card.AddCard {
      send addCard to outlet Trello.BoardManagement.CardDispatch
    }
    on editCard: command Trello.BoardManagement.Card.EditCard {
      send editCard to outlet Trello.BoardManagement.CardDispatch
    }
    on moveCard: command Trello.BoardManagement.Card.MoveCard {
      send moveCard to outlet Trello.BoardManagement.CardDispatch
    }
    on assignMember: command Trello.BoardManagement.Card.AssignMember {
      send assignMember to outlet Trello.BoardManagement.CardDispatch
    }
    on addComment: command Trello.BoardManagement.Card.AddComment {
      send addComment to outlet Trello.BoardManagement.CardDispatch
    }
    on addChecklist: command Trello.BoardManagement.Card.AddChecklist {
      send addChecklist to outlet Trello.BoardManagement.CardDispatch
    }
    on setDueDate: command Trello.BoardManagement.Card.SetDueDate {
      send setDueDate to outlet Trello.BoardManagement.CardDispatch
    }
    on recordActivity: command Trello.BoardManagement.Activity.RecordActivity {
      send recordActivity to outlet Trello.BoardManagement.ActivityDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary to the entity that owns it"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type BoardId is Id(Trello.BoardManagement.Board) with {
    briefly as "Unique identifier for one board"
    described as {
      |Defined inside BoardManagement because board identity is this context's concern.
    }
  }

  entity Board as flow is {

    inlet BoardCommands is type Trello.BoardManagement.BoardCommand with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet BoardEvents is type Trello.BoardManagement.BoardManagementEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command CreateBoard is {
      boardId is Id(Board),
      title is String,
      visibility is String
    } with {
      briefly as "Ask for a board to be created"
      described as {
        |Sent when a board was created.
      }
    }

    command AddBoardMember is {
      boardId is Trello.BoardManagement.BoardId
    } with {
      briefly as "Add a member to a board"
      described as {
        |Sent when add a member to a board.
      }
    }

    query WhichBoard replies result TheBoard is {
      boardId is Trello.BoardManagement.BoardId
    } with {
      briefly as "Ask for the current state of one board"
      described as {
        |Sent when a reader wants a board they already know of.
      }
    }

    result TheBoard is {
      boardId is Trello.BoardManagement.BoardId,
      summary is String
    } with {
      briefly as "The answer to a WhichBoard query"
      described as {
        |Carries the identity and a short summary of the board.
      }
    }

    event BoardCreated is {
      boardId is Trello.BoardManagement.BoardId
    } with {
      briefly as "Records that a board was created"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record BoardFields is {
      boardId is Trello.BoardManagement.BoardId,
      title is String,
      visibility is String
    } with {
      briefly as "Everything Trello keeps about one board"
      described as {
        |The stored shape of a board.
      }
    }

    initial state BoardState of record Trello.BoardManagement.Board.BoardFields with {
      briefly as "The state of one board"
      described as {
        |A board has a single state; its fields change over its lifetime.
      }
    }

    handler BoardHandler is {
      on init {
        set field Trello.BoardManagement.Board.BoardFields.boardId to "a freshly minted identifier"
      }
      on command CreateBoard {
        morph entity Board to state BoardState with record Trello.BoardManagement.Board.BoardFields(
          boardId = prompt("the boardId of the resulting Board state"),
          title = prompt("the title of the resulting Board state"),
          visibility = prompt("the visibility of the resulting Board state")
        )
        send event BoardCreated(
          boardId = prompt("the boardId carried by BoardCreated")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on command AddBoardMember {
        morph entity Board to state BoardState with record Trello.BoardManagement.Board.BoardFields(
          boardId = prompt("the boardId of the resulting Board state"),
          title = prompt("the title of the resulting Board state"),
          visibility = prompt("the visibility of the resulting Board state")
        )
        send event BoardCreated(
          boardId = prompt("the boardId carried by BoardCreated")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on query WhichBoard {
        reply result TheBoard(
          boardId = prompt("the boardId carried by TheBoard"),
          summary = prompt("the summary carried by TheBoard")
        )
      }
    } with {
      briefly as "Handles messages addressed to a board"
      described as {
        |Creates and changes boards and answers questions about them.
      }
    }

  } with {
    briefly as "A single board in Trello"
    described as {
      |The entity that remembers that a board was created.
    }
  }

  type CardListId is Id(Trello.BoardManagement.CardList) with {
    briefly as "Unique identifier for one cardlist"
    described as {
      |Defined inside BoardManagement because cardlist identity is this context's concern.
    }
  }

  entity CardList as flow is {

    inlet CardListCommands is type Trello.BoardManagement.CardListCommand with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet CardListEvents is type Trello.BoardManagement.BoardManagementEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command AddList is {
      cardListId is Id(CardList),
      title is String,
      position is Integer
    } with {
      briefly as "Ask for a cardlist to be created"
      described as {
        |Sent when a list was added to a board.
      }
    }

    command MoveList is {
      cardListId is Trello.BoardManagement.CardListId
    } with {
      briefly as "Reorder a list on its board"
      described as {
        |Sent when reorder a list on its board.
      }
    }

    query WhichCardList replies result TheCardList is {
      cardListId is Trello.BoardManagement.CardListId
    } with {
      briefly as "Ask for the current state of one cardlist"
      described as {
        |Sent when a reader wants a cardlist they already know of.
      }
    }

    result TheCardList is {
      cardListId is Trello.BoardManagement.CardListId,
      summary is String
    } with {
      briefly as "The answer to a WhichCardList query"
      described as {
        |Carries the identity and a short summary of the cardlist.
      }
    }

    event ListAdded is {
      cardListId is Trello.BoardManagement.CardListId
    } with {
      briefly as "Records that a list was added to a board"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record CardListFields is {
      cardListId is Trello.BoardManagement.CardListId,
      title is String,
      position is Integer
    } with {
      briefly as "Everything Trello keeps about one cardlist"
      described as {
        |The stored shape of a cardlist.
      }
    }

    initial state CardListState of record Trello.BoardManagement.CardList.CardListFields with {
      briefly as "The state of one cardlist"
      described as {
        |A cardlist has a single state; its fields change over its lifetime.
      }
    }

    handler CardListHandler is {
      on init {
        set field Trello.BoardManagement.CardList.CardListFields.cardListId to "a freshly minted identifier"
      }
      on command AddList {
        morph entity CardList to state CardListState with record Trello.BoardManagement.CardList.CardListFields(
          cardListId = prompt("the cardListId of the resulting CardList state"),
          title = prompt("the title of the resulting CardList state"),
          position = prompt("the position of the resulting CardList state")
        )
        send event ListAdded(
          cardListId = prompt("the cardListId carried by ListAdded")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on command MoveList {
        morph entity CardList to state CardListState with record Trello.BoardManagement.CardList.CardListFields(
          cardListId = prompt("the cardListId of the resulting CardList state"),
          title = prompt("the title of the resulting CardList state"),
          position = prompt("the position of the resulting CardList state")
        )
        send event ListAdded(
          cardListId = prompt("the cardListId carried by ListAdded")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on query WhichCardList {
        reply result TheCardList(
          cardListId = prompt("the cardListId carried by TheCardList"),
          summary = prompt("the summary carried by TheCardList")
        )
      }
    } with {
      briefly as "Handles messages addressed to a cardlist"
      described as {
        |Creates and changes cardlists and answers questions about them.
      }
    }

  } with {
    briefly as "A single cardlist in Trello"
    described as {
      |The entity that remembers that a list was added to a board.
    }
  }

  type CardId is Id(Trello.BoardManagement.Card) with {
    briefly as "Unique identifier for one card"
    described as {
      |Defined inside BoardManagement because card identity is this context's concern.
    }
  }

  entity Card as flow is {

    inlet CardCommands is type Trello.BoardManagement.CardCommand with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet CardEvents is type Trello.BoardManagement.BoardManagementEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command AddCard is {
      cardId is Id(Card),
      title is String,
      description is String,
      dueDate is TimeStamp
    } with {
      briefly as "Ask for a card to be created"
      described as {
        |Sent when a card was added to a list.
      }
    }

    command EditCard is {
      cardId is Trello.BoardManagement.CardId
    } with {
      briefly as "Change a card's details"
      described as {
        |Sent when change a card's details.
      }
    }

    command MoveCard is {
      cardId is Trello.BoardManagement.CardId
    } with {
      briefly as "Move a card to another list"
      described as {
        |Sent when move a card to another list.
      }
    }

    command AssignMember is {
      cardId is Trello.BoardManagement.CardId
    } with {
      briefly as "Give a card an owner"
      described as {
        |Sent when give a card an owner.
      }
    }

    command AddComment is {
      cardId is Trello.BoardManagement.CardId
    } with {
      briefly as "Comment on a card"
      described as {
        |Sent when comment on a card.
      }
    }

    command AddChecklist is {
      cardId is Trello.BoardManagement.CardId
    } with {
      briefly as "Add a checklist to a card"
      described as {
        |Sent when add a checklist to a card.
      }
    }

    command SetDueDate is {
      cardId is Trello.BoardManagement.CardId
    } with {
      briefly as "Give a card a deadline"
      described as {
        |Sent when give a card a deadline.
      }
    }

    query WhichCard replies result TheCard is {
      cardId is Trello.BoardManagement.CardId
    } with {
      briefly as "Ask for the current state of one card"
      described as {
        |Sent when a reader wants a card they already know of.
      }
    }

    result TheCard is {
      cardId is Trello.BoardManagement.CardId,
      summary is String
    } with {
      briefly as "The answer to a WhichCard query"
      described as {
        |Carries the identity and a short summary of the card.
      }
    }

    event CardAdded is {
      cardId is Trello.BoardManagement.CardId
    } with {
      briefly as "Records that a card was added to a list"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record CardFields is {
      cardId is Trello.BoardManagement.CardId,
      title is String,
      description is String,
      dueDate is TimeStamp
    } with {
      briefly as "Everything Trello keeps about one card"
      described as {
        |The stored shape of a card.
      }
    }

    initial state CardState of record Trello.BoardManagement.Card.CardFields with {
      briefly as "The state of one card"
      described as {
        |A card has a single state; its fields change over its lifetime.
      }
    }

    handler CardHandler is {
      on init {
        set field Trello.BoardManagement.Card.CardFields.cardId to "a freshly minted identifier"
      }
      on command AddCard {
        morph entity Card to state CardState with record Trello.BoardManagement.Card.CardFields(
          cardId = prompt("the cardId of the resulting Card state"),
          title = prompt("the title of the resulting Card state"),
          description = prompt("the description of the resulting Card state"),
          dueDate = prompt("the dueDate of the resulting Card state")
        )
        send event CardAdded(
          cardId = prompt("the cardId carried by CardAdded")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on command EditCard {
        morph entity Card to state CardState with record Trello.BoardManagement.Card.CardFields(
          cardId = prompt("the cardId of the resulting Card state"),
          title = prompt("the title of the resulting Card state"),
          description = prompt("the description of the resulting Card state"),
          dueDate = prompt("the dueDate of the resulting Card state")
        )
        send event CardAdded(
          cardId = prompt("the cardId carried by CardAdded")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on command MoveCard {
        morph entity Card to state CardState with record Trello.BoardManagement.Card.CardFields(
          cardId = prompt("the cardId of the resulting Card state"),
          title = prompt("the title of the resulting Card state"),
          description = prompt("the description of the resulting Card state"),
          dueDate = prompt("the dueDate of the resulting Card state")
        )
        send event CardAdded(
          cardId = prompt("the cardId carried by CardAdded")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on command AssignMember {
        morph entity Card to state CardState with record Trello.BoardManagement.Card.CardFields(
          cardId = prompt("the cardId of the resulting Card state"),
          title = prompt("the title of the resulting Card state"),
          description = prompt("the description of the resulting Card state"),
          dueDate = prompt("the dueDate of the resulting Card state")
        )
        send event CardAdded(
          cardId = prompt("the cardId carried by CardAdded")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on command AddComment {
        morph entity Card to state CardState with record Trello.BoardManagement.Card.CardFields(
          cardId = prompt("the cardId of the resulting Card state"),
          title = prompt("the title of the resulting Card state"),
          description = prompt("the description of the resulting Card state"),
          dueDate = prompt("the dueDate of the resulting Card state")
        )
        send event CardAdded(
          cardId = prompt("the cardId carried by CardAdded")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on command AddChecklist {
        morph entity Card to state CardState with record Trello.BoardManagement.Card.CardFields(
          cardId = prompt("the cardId of the resulting Card state"),
          title = prompt("the title of the resulting Card state"),
          description = prompt("the description of the resulting Card state"),
          dueDate = prompt("the dueDate of the resulting Card state")
        )
        send event CardAdded(
          cardId = prompt("the cardId carried by CardAdded")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on command SetDueDate {
        morph entity Card to state CardState with record Trello.BoardManagement.Card.CardFields(
          cardId = prompt("the cardId of the resulting Card state"),
          title = prompt("the title of the resulting Card state"),
          description = prompt("the description of the resulting Card state"),
          dueDate = prompt("the dueDate of the resulting Card state")
        )
        send event CardAdded(
          cardId = prompt("the cardId carried by CardAdded")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on query WhichCard {
        reply result TheCard(
          cardId = prompt("the cardId carried by TheCard"),
          summary = prompt("the summary carried by TheCard")
        )
      }
    } with {
      briefly as "Handles messages addressed to a card"
      described as {
        |Creates and changes cards and answers questions about them.
      }
    }

  } with {
    briefly as "A single card in Trello"
    described as {
      |The entity that remembers that a card was added to a list.
    }
  }

  type ActivityId is Id(Trello.BoardManagement.Activity) with {
    briefly as "Unique identifier for one activity"
    described as {
      |Defined inside BoardManagement because activity identity is this context's concern.
    }
  }

  entity Activity as flow is {

    inlet ActivityCommands is command Trello.BoardManagement.Activity.RecordActivity with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet ActivityEvents is type Trello.BoardManagement.BoardManagementEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command RecordActivity is {
      activityId is Id(Activity),
      summary is String,
      occurredAt is TimeStamp
    } with {
      briefly as "Ask for a activity to be created"
      described as {
        |Sent when something happened on a board.
      }
    }

    query WhichActivity replies result TheActivity is {
      activityId is Trello.BoardManagement.ActivityId
    } with {
      briefly as "Ask for the current state of one activity"
      described as {
        |Sent when a reader wants a activity they already know of.
      }
    }

    result TheActivity is {
      activityId is Trello.BoardManagement.ActivityId,
      summary is String
    } with {
      briefly as "The answer to a WhichActivity query"
      described as {
        |Carries the identity and a short summary of the activity.
      }
    }

    event ActivityRecorded is {
      activityId is Trello.BoardManagement.ActivityId
    } with {
      briefly as "Records that something happened on a board"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record ActivityFields is {
      activityId is Trello.BoardManagement.ActivityId,
      summary is String,
      occurredAt is TimeStamp
    } with {
      briefly as "Everything Trello keeps about one activity"
      described as {
        |The stored shape of a activity.
      }
    }

    initial state ActivityState of record Trello.BoardManagement.Activity.ActivityFields with {
      briefly as "The state of one activity"
      described as {
        |A activity has a single state; its fields change over its lifetime.
      }
    }

    handler ActivityHandler is {
      on init {
        set field Trello.BoardManagement.Activity.ActivityFields.activityId to "a freshly minted identifier"
      }
      on command RecordActivity {
        morph entity Activity to state ActivityState with record Trello.BoardManagement.Activity.ActivityFields(
          activityId = prompt("the activityId of the resulting Activity state"),
          summary = prompt("the summary of the resulting Activity state"),
          occurredAt = prompt("the occurredAt of the resulting Activity state")
        )
        send event ActivityRecorded(
          activityId = prompt("the activityId carried by ActivityRecorded")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on query WhichActivity {
        reply result TheActivity(
          activityId = prompt("the activityId carried by TheActivity"),
          summary = prompt("the summary carried by TheActivity")
        )
      }
    } with {
      briefly as "Handles messages addressed to a activity"
      described as {
        |Creates and changes activitys and answers questions about them.
      }
    }

  } with {
    briefly as "A single activity in Trello"
    described as {
      |The entity that remembers that something happened on a board.
    }
  }

  type BoardManagementEvent is one of {
    event Trello.BoardManagement.Board.BoardCreated or
    event Trello.BoardManagement.CardList.ListAdded or
    event Trello.BoardManagement.Card.CardAdded or
    event Trello.BoardManagement.Activity.ActivityRecorded
  } with {
    briefly as "Anything BoardManagement announces"
    described as {
      |The alternation of every event this context publishes, so one outlet
      |can carry them all.
    }
  }

  type BoardCommand is one of {
    command Trello.BoardManagement.Board.CreateBoard or
    command Trello.BoardManagement.Board.AddBoardMember
  } with {
    briefly as "What Board can be asked to do"
    described as {
      |A port carries only what its owner handles.
    }
  }

  type CardListCommand is one of {
    command Trello.BoardManagement.CardList.AddList or
    command Trello.BoardManagement.CardList.MoveList
  } with {
    briefly as "What CardList can be asked to do"
    described as {
      |A port carries only what its owner handles.
    }
  }

  type CardCommand is one of {
    command Trello.BoardManagement.Card.AddCard or
    command Trello.BoardManagement.Card.EditCard or
    command Trello.BoardManagement.Card.MoveCard or
    command Trello.BoardManagement.Card.AssignMember or
    command Trello.BoardManagement.Card.AddComment or
    command Trello.BoardManagement.Card.AddChecklist or
    command Trello.BoardManagement.Card.SetDueDate
  } with {
    briefly as "What Card can be asked to do"
    described as {
      |A port carries only what its owner handles.
    }
  }

  type BoardManagementCommand is one of {
    command Trello.BoardManagement.Board.CreateBoard or
    command Trello.BoardManagement.Board.AddBoardMember or
    command Trello.BoardManagement.CardList.AddList or
    command Trello.BoardManagement.CardList.MoveList or
    command Trello.BoardManagement.Card.AddCard or
    command Trello.BoardManagement.Card.EditCard or
    command Trello.BoardManagement.Card.MoveCard or
    command Trello.BoardManagement.Card.AssignMember or
    command Trello.BoardManagement.Card.AddComment or
    command Trello.BoardManagement.Card.AddChecklist or
    command Trello.BoardManagement.Card.SetDueDate or
    command Trello.BoardManagement.Activity.RecordActivity
  } with {
    briefly as "Everything BoardManagement can be asked to do"
    described as {
      |The alternation of every command the application sends here, so one
      |inlet and one connector can carry them all.
    }
  }

  processor BoardManagementAnnouncer as merge is {
    inlet FromBoard is type Trello.BoardManagement.BoardManagementEvent with {
      briefly as "Events arriving from Board"
      described as {
        |Each entity publishes on its own outlet; this merges them.
      }
    }

    inlet FromCardList is type Trello.BoardManagement.BoardManagementEvent with {
      briefly as "Events arriving from CardList"
      described as {
        |Each entity publishes on its own outlet; this merges them.
      }
    }

    inlet FromCard is type Trello.BoardManagement.BoardManagementEvent with {
      briefly as "Events arriving from Card"
      described as {
        |Each entity publishes on its own outlet; this merges them.
      }
    }

    inlet FromActivity is type Trello.BoardManagement.BoardManagementEvent with {
      briefly as "Events arriving from Activity"
      described as {
        |Each entity publishes on its own outlet; this merges them.
      }
    }

    outlet Published is type Trello.BoardManagement.BoardManagementEvent with {
      briefly as "Where BoardManagement publishes what happened"
      described as {
        |Events leave this context through this outlet.
      }
    }
    handler BoardManagementAnnouncerHandler is {
      on event Trello.BoardManagement.Board.BoardCreated {
        send event Trello.BoardManagement.Board.BoardCreated(
          boardId = prompt("the boardId carried by BoardCreated")
        ) to outlet BoardManagementAnnouncer.Published
      }
      on other {
        do "publish any other event this context raises"
      }
    } with {
      briefly as "Publishes BoardManagement events"
      described as {
        |Puts each event an entity announced onto the outlet.
      }
    }
  } with {
    briefly as "The context's publication point"
    described as {
      |A source streamlet carrying what BoardManagement wants known elsewhere.
    }
  }


  repository BoardManagementStore as sink is {
    command PersistBoardCreated is {
      boardId is Trello.BoardManagement.BoardId
    } with {
      briefly as "Apply BoardCreated to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    command PersistListAdded is {
      cardListId is Trello.BoardManagement.CardListId
    } with {
      briefly as "Apply ListAdded to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    command PersistCardAdded is {
      cardId is Trello.BoardManagement.CardId
    } with {
      briefly as "Apply CardAdded to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    command PersistActivityRecorded is {
      activityId is Trello.BoardManagement.ActivityId
    } with {
      briefly as "Apply ActivityRecorded to the stored row"
      described as {
        |A persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }

    type BoardManagementStoreCommand is one of { command PersistBoardCreated or command PersistListAdded or command PersistCardAdded or command PersistActivityRecorded } with {
      briefly as "Anything this store can be told to do"
      described as {
        |One alternation so a single inlet and connector carry them all.
      }
    }

    inlet Recorded is type Trello.BoardManagement.BoardManagementStore.BoardManagementStoreCommand with {
      briefly as "Where board persistence commands arrive"
      described as {
        |A projector turns each board event into one of these.
      }
    }
    schema BoardManagementSchema is flat
      of Held as record Trello.BoardManagement.BoardManagementProjection.Projected
    with {
      briefly as "How BoardManagement records are laid out in storage"
      described as {
        |A flat schema: one stored row per record.
      }
    }
    handler BoardManagementStoreHandler is {
      on command Trello.BoardManagement.BoardManagementStore.PersistBoardCreated {
        do "apply what PersistBoardCreated carries to the stored row"
      }
      on command Trello.BoardManagement.BoardManagementStore.PersistListAdded {
        do "apply what PersistListAdded carries to the stored row"
      }
      on command Trello.BoardManagement.BoardManagementStore.PersistCardAdded {
        do "apply what PersistCardAdded carries to the stored row"
      }
      on command Trello.BoardManagement.BoardManagementStore.PersistActivityRecorded {
        do "apply what PersistActivityRecorded carries to the stored row"
      }
    } with {
      briefly as "Keeps storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists what this context owns"
    described as {
      |Entities are stateful, so BoardManagement keeps a repository.
    }
  }

  connector AddressingBoard is {
    from outlet Trello.BoardManagement.BoardDispatch to inlet Trello.BoardManagement.Board.BoardCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector AddressingCardList is {
    from outlet Trello.BoardManagement.CardListDispatch to inlet Trello.BoardManagement.CardList.CardListCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector AddressingCard is {
    from outlet Trello.BoardManagement.CardDispatch to inlet Trello.BoardManagement.Card.CardCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector AddressingActivity is {
    from outlet Trello.BoardManagement.ActivityDispatch to inlet Trello.BoardManagement.Activity.ActivityCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector AnnouncingBoard is {
    from outlet Trello.BoardManagement.Board.BoardEvents to inlet Trello.BoardManagement.BoardManagementAnnouncer.FromBoard
  } with {
    briefly as "Carries this entity's events to the context's announcer"
    described as {
      |Publishing goes out the entity's own outlet and merges downstream.
    }
  }

  connector AnnouncingCardList is {
    from outlet Trello.BoardManagement.CardList.CardListEvents to inlet Trello.BoardManagement.BoardManagementAnnouncer.FromCardList
  } with {
    briefly as "Carries this entity's events to the context's announcer"
    described as {
      |Publishing goes out the entity's own outlet and merges downstream.
    }
  }

  connector AnnouncingCard is {
    from outlet Trello.BoardManagement.Card.CardEvents to inlet Trello.BoardManagement.BoardManagementAnnouncer.FromCard
  } with {
    briefly as "Carries this entity's events to the context's announcer"
    described as {
      |Publishing goes out the entity's own outlet and merges downstream.
    }
  }

  connector AnnouncingActivity is {
    from outlet Trello.BoardManagement.Activity.ActivityEvents to inlet Trello.BoardManagement.BoardManagementAnnouncer.FromActivity
  } with {
    briefly as "Carries this entity's events to the context's announcer"
    described as {
      |Publishing goes out the entity's own outlet and merges downstream.
    }
  }

  projector BoardManagementProjection as flow is {
    inlet Observed is type Trello.BoardManagement.BoardManagementEvent with {
      briefly as "Where board events are observed"
      described as {
        |The projector sees what was announced.
      }
    }

    outlet Persisting is type Trello.BoardManagement.BoardManagementStore.BoardManagementStoreCommand with {
      briefly as "Where persistence commands leave for the store"
      described as {
        |Turning each event into a command is the projector's whole job.
      }
    }

    updates repository Trello.BoardManagement.BoardManagementStore

    record Projected is {
      boardId is Trello.BoardManagement.BoardId
    } with {
      briefly as "The shape this projection maintains"
      described as {
        |One projected row per board. The store holds exactly this.
      }
    }

    handler BoardManagementProjectionHandler is {
      on boardCreated: event Trello.BoardManagement.Board.BoardCreated {
        tell command Trello.BoardManagement.BoardManagementStore.PersistBoardCreated(
          boardId = boardCreated.boardId
        ) to repository Trello.BoardManagement.BoardManagementStore
      }
      on listAdded: event Trello.BoardManagement.CardList.ListAdded {
        tell command Trello.BoardManagement.BoardManagementStore.PersistListAdded(
          cardListId = listAdded.cardListId
        ) to repository Trello.BoardManagement.BoardManagementStore
      }
      on cardAdded: event Trello.BoardManagement.Card.CardAdded {
        tell command Trello.BoardManagement.BoardManagementStore.PersistCardAdded(
          cardId = cardAdded.cardId
        ) to repository Trello.BoardManagement.BoardManagementStore
      }
      on activityRecorded: event Trello.BoardManagement.Activity.ActivityRecorded {
        tell command Trello.BoardManagement.BoardManagementStore.PersistActivityRecorded(
          activityId = activityRecorded.activityId
        ) to repository Trello.BoardManagement.BoardManagementStore
      }
    } with {
      briefly as "Turns board events into persistence commands"
      described as {
        |A repository is changed by commands, so something must translate.
      }
    }
  } with {
    briefly as "Projects board events into the store"
    described as {
      |Stands between what was announced and what the store is told.
    }
  }

  connector ObservingBoardManagementProjection is {
    from outlet BoardManagementAnnouncer.Published to inlet Trello.BoardManagement.BoardManagementProjection.Observed
  } with {
    briefly as "Carries board events to the projector"
    described as {
      |Intra-context, so it may address the projector's own inlet directly.
    }
  }

  connector BoardManagementRecording is {
    from outlet Trello.BoardManagement.BoardManagementProjection.Persisting to inlet BoardManagementStore.Recorded
  } with {
    briefly as "Carries BoardManagement events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Boards, their lists, and the cards on them"
  described as {
    |The heart of Trello: a board holds ordered lists, each list holds
    |cards, and every change is recorded as activity.
  }
}
