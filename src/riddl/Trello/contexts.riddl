context UserManagement as split is {

  inlet Failures is record Riddl.GeneratorError with {
    option error-sink
    briefly as "Where hard errors go"
    described as {
      |RIDDL 2.0 wants every domain to name a destination for failures no
      |handler can recover from. An error-sink inlet is infrastructure
      |rather than dataflow, so it does not count toward this processor's
      |arity.
    }
  }

  inlet UserManagementIn is type Trello.UserManagement.UserManagementCommand with {
    briefly as "Where commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet AccountDispatch is type Trello.UserManagement.UserManagementCommand with {
    briefly as "Where entering commands bound for Account are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  outlet NotificationDispatch is type Trello.UserManagement.UserManagementCommand with {
    briefly as "Where entering commands bound for Notification are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  handler UserManagementBoundary is {
    on createAccount: command Trello.UserManagement.Account.CreateAccount {
      send createAccount to outlet Trello.UserManagement.AccountDispatch
    }
    on updateProfile: command Trello.UserManagement.Account.UpdateProfile {
      send updateProfile to outlet Trello.UserManagement.AccountDispatch
    }
    on updateSettings: command Trello.UserManagement.Account.UpdateSettings {
      send updateSettings to outlet Trello.UserManagement.AccountDispatch
    }
    on createNotification: command Trello.UserManagement.Notification.CreateNotification {
      send createNotification to outlet Trello.UserManagement.NotificationDispatch
    }
    on markAsRead: command Trello.UserManagement.Notification.MarkAsRead {
      send markAsRead to outlet Trello.UserManagement.NotificationDispatch
    }
    on markAllAsRead: command Trello.UserManagement.Notification.MarkAllAsRead {
      send markAllAsRead to outlet Trello.UserManagement.NotificationDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary to the entity that owns it"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type AccountId is Id(Trello.UserManagement.Account) with {
    briefly as "Unique identifier for one user"
    described as {
      |Defined inside UserManagement because user identity is this context's concern.
    }
  }

  entity Account as flow is {

    inlet AccountCommands is type Trello.UserManagement.UserManagementCommand with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet AccountEvents is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command CreateAccount is {
      accountId is Id(Account),
      username is String,
      email is String
    } with {
      briefly as "Ask for a user to be created"
      described as {
        |Sent when a person joined Trello.
      }
    }

    command UpdateProfile is {
      accountId is Trello.UserManagement.AccountId
    } with {
      briefly as "Change a member's profile"
      described as {
        |Sent when change a member's profile.
      }
    }

    command UpdateSettings is {
      accountId is Trello.UserManagement.AccountId
    } with {
      briefly as "Change a member's settings"
      described as {
        |Sent when change a member's settings.
      }
    }

    query WhichAccount replies result TheAccount is {
      accountId is Trello.UserManagement.AccountId
    } with {
      briefly as "Ask for the current state of one user"
      described as {
        |Sent when a reader wants a user they already know of.
      }
    }

    result TheAccount is {
      accountId is Trello.UserManagement.AccountId,
      summary is String
    } with {
      briefly as "The answer to a WhichAccount query"
      described as {
        |Carries the identity and a short summary of the user.
      }
    }

    event AccountCreated is {
      accountId is Trello.UserManagement.AccountId
    } with {
      briefly as "Records that a person joined Trello"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record AccountFields is {
      accountId is Trello.UserManagement.AccountId,
      username is String,
      email is String
    } with {
      briefly as "Everything Trello keeps about one user"
      described as {
        |The stored shape of a user.
      }
    }

    initial state AccountState of record Trello.UserManagement.Account.AccountFields with {
      briefly as "The state of one user"
      described as {
        |A user has a single state; its fields change over its lifetime.
      }
    }

    handler AccountHandler is {
      on init {
        set field Trello.UserManagement.Account.AccountFields.accountId to "a freshly minted identifier"
      }
      on command CreateAccount {
        morph entity Account to state AccountState with record Trello.UserManagement.Account.AccountFields(
          accountId = prompt("the accountId of the resulting Account state"),
          username = prompt("the username of the resulting Account state"),
          email = prompt("the email of the resulting Account state")
        )
        send event AccountCreated(
          accountId = prompt("the accountId carried by AccountCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on command UpdateProfile {
        morph entity Account to state AccountState with record Trello.UserManagement.Account.AccountFields(
          accountId = prompt("the accountId of the resulting Account state"),
          username = prompt("the username of the resulting Account state"),
          email = prompt("the email of the resulting Account state")
        )
        send event AccountCreated(
          accountId = prompt("the accountId carried by AccountCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on command UpdateSettings {
        morph entity Account to state AccountState with record Trello.UserManagement.Account.AccountFields(
          accountId = prompt("the accountId of the resulting Account state"),
          username = prompt("the username of the resulting Account state"),
          email = prompt("the email of the resulting Account state")
        )
        send event AccountCreated(
          accountId = prompt("the accountId carried by AccountCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on query WhichAccount {
        reply result TheAccount(
          accountId = prompt("the accountId carried by TheAccount"),
          summary = prompt("the summary carried by TheAccount")
        )
      }
    } with {
      briefly as "Handles messages addressed to a user"
      described as {
        |Creates and changes users and answers questions about them.
      }
    }

  } with {
    briefly as "A single user in Trello"
    described as {
      |The entity that remembers that a person joined Trello.
    }
  }

  type NotificationId is Id(Trello.UserManagement.Notification) with {
    briefly as "Unique identifier for one notification"
    described as {
      |Defined inside UserManagement because notification identity is this context's concern.
    }
  }

  entity Notification as flow is {

    inlet NotificationCommands is type Trello.UserManagement.UserManagementCommand with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet NotificationEvents is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command CreateNotification is {
      notificationId is Id(Notification),
      text is String,
      read is Boolean
    } with {
      briefly as "Ask for a notification to be created"
      described as {
        |Sent when a member was told something.
      }
    }

    command MarkAsRead is {
      notificationId is Trello.UserManagement.NotificationId
    } with {
      briefly as "Mark one notification read"
      described as {
        |Sent when mark one notification read.
      }
    }

    command MarkAllAsRead is {
      notificationId is Trello.UserManagement.NotificationId
    } with {
      briefly as "Mark every notification read"
      described as {
        |Sent when mark every notification read.
      }
    }

    query WhichNotification replies result TheNotification is {
      notificationId is Trello.UserManagement.NotificationId
    } with {
      briefly as "Ask for the current state of one notification"
      described as {
        |Sent when a reader wants a notification they already know of.
      }
    }

    result TheNotification is {
      notificationId is Trello.UserManagement.NotificationId,
      summary is String
    } with {
      briefly as "The answer to a WhichNotification query"
      described as {
        |Carries the identity and a short summary of the notification.
      }
    }

    event NotificationCreated is {
      notificationId is Trello.UserManagement.NotificationId
    } with {
      briefly as "Records that a member was told something"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record NotificationFields is {
      notificationId is Trello.UserManagement.NotificationId,
      text is String,
      read is Boolean
    } with {
      briefly as "Everything Trello keeps about one notification"
      described as {
        |The stored shape of a notification.
      }
    }

    initial state NotificationState of record Trello.UserManagement.Notification.NotificationFields with {
      briefly as "The state of one notification"
      described as {
        |A notification has a single state; its fields change over its lifetime.
      }
    }

    handler NotificationHandler is {
      on init {
        set field Trello.UserManagement.Notification.NotificationFields.notificationId to "a freshly minted identifier"
      }
      on command CreateNotification {
        morph entity Notification to state NotificationState with record Trello.UserManagement.Notification.NotificationFields(
          notificationId = prompt("the notificationId of the resulting Notification state"),
          text = prompt("the text of the resulting Notification state"),
          read = prompt("the read of the resulting Notification state")
        )
        send event NotificationCreated(
          notificationId = prompt("the notificationId carried by NotificationCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on command MarkAsRead {
        morph entity Notification to state NotificationState with record Trello.UserManagement.Notification.NotificationFields(
          notificationId = prompt("the notificationId of the resulting Notification state"),
          text = prompt("the text of the resulting Notification state"),
          read = prompt("the read of the resulting Notification state")
        )
        send event NotificationCreated(
          notificationId = prompt("the notificationId carried by NotificationCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on command MarkAllAsRead {
        morph entity Notification to state NotificationState with record Trello.UserManagement.Notification.NotificationFields(
          notificationId = prompt("the notificationId of the resulting Notification state"),
          text = prompt("the text of the resulting Notification state"),
          read = prompt("the read of the resulting Notification state")
        )
        send event NotificationCreated(
          notificationId = prompt("the notificationId carried by NotificationCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on query WhichNotification {
        reply result TheNotification(
          notificationId = prompt("the notificationId carried by TheNotification"),
          summary = prompt("the summary carried by TheNotification")
        )
      }
    } with {
      briefly as "Handles messages addressed to a notification"
      described as {
        |Creates and changes notifications and answers questions about them.
      }
    }

  } with {
    briefly as "A single notification in Trello"
    described as {
      |The entity that remembers that a member was told something.
    }
  }

  type UserManagementEvent is one of {
    event Trello.UserManagement.Account.AccountCreated or
    event Trello.UserManagement.Notification.NotificationCreated
  } with {
    briefly as "Anything UserManagement announces"
    described as {
      |The alternation of every event this context publishes, so one outlet
      |can carry them all.
    }
  }

  type UserManagementCommand is one of {
    command Trello.UserManagement.Account.CreateAccount or
    command Trello.UserManagement.Account.UpdateProfile or
    command Trello.UserManagement.Account.UpdateSettings or
    command Trello.UserManagement.Notification.CreateNotification or
    command Trello.UserManagement.Notification.MarkAsRead or
    command Trello.UserManagement.Notification.MarkAllAsRead
  } with {
    briefly as "Everything UserManagement can be asked to do"
    described as {
      |The alternation of every command the application sends here, so one
      |inlet and one connector can carry them all.
    }
  }

  processor UserManagementAnnouncer as merge is {
    inlet FromAccount is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Events arriving from Account"
      described as {
        |Each entity publishes on its own outlet; this merges them.
      }
    }

    inlet FromNotification is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Events arriving from Notification"
      described as {
        |Each entity publishes on its own outlet; this merges them.
      }
    }

    outlet Published is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Where UserManagement publishes what happened"
      described as {
        |Events leave this context through this outlet.
      }
    }
    handler UserManagementAnnouncerHandler is {
      on event Trello.UserManagement.Account.AccountCreated {
        send event Trello.UserManagement.Account.AccountCreated(
          accountId = prompt("the accountId carried by AccountCreated")
        ) to outlet UserManagementAnnouncer.Published
      }
      on other {
        do "publish any other event this context raises"
      }
    } with {
      briefly as "Publishes UserManagement events"
      described as {
        |Puts each event an entity announced onto the outlet.
      }
    }
  } with {
    briefly as "The context's publication point"
    described as {
      |A source streamlet carrying what UserManagement wants known elsewhere.
    }
  }


  repository UserManagementStore as sink is {
    inlet Recorded is type Trello.UserManagement.UserManagementEvent with {
      briefly as "Where events arrive to be persisted"
      described as {
        |The repository learns of changes through this inlet.
      }
    }
    schema UserManagementSchema is flat
      of Held as record Trello.UserManagement.Account.AccountFields
    with {
      briefly as "How UserManagement records are laid out in storage"
      described as {
        |A flat schema: one stored row per record.
      }
    }
    handler UserManagementStoreHandler is {
      on event Trello.UserManagement.Account.AccountCreated {
        do "store the identifier carried by the event"
      }
    } with {
      briefly as "Keeps storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists what this context owns"
    described as {
      |Entities are stateful, so UserManagement keeps a repository.
    }
  }

  connector ErrorReporting is {
    from outlet Riddl.ForeverEmpty.void to inlet Trello.UserManagement.Failures
  } with {
    briefly as "Terminates the error-sink inlet"
    described as {
      |Nothing in this model produces a GeneratorError — those come from
      |generators at runtime, not from anything the model declares. The
      |predefined ForeverEmpty source exists for exactly this: a port that
      |must be connected but has no modelled producer.
    }
  }

  connector AddressingAccount is {
    from outlet Trello.UserManagement.AccountDispatch to inlet Trello.UserManagement.Account.AccountCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector AddressingNotification is {
    from outlet Trello.UserManagement.NotificationDispatch to inlet Trello.UserManagement.Notification.NotificationCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector AnnouncingAccount is {
    from outlet Trello.UserManagement.Account.AccountEvents to inlet Trello.UserManagement.UserManagementAnnouncer.FromAccount
  } with {
    briefly as "Carries this entity's events to the context's announcer"
    described as {
      |Publishing goes out the entity's own outlet and merges downstream.
    }
  }

  connector AnnouncingNotification is {
    from outlet Trello.UserManagement.Notification.NotificationEvents to inlet Trello.UserManagement.UserManagementAnnouncer.FromNotification
  } with {
    briefly as "Carries this entity's events to the context's announcer"
    described as {
      |Publishing goes out the entity's own outlet and merges downstream.
    }
  }

  connector UserManagementRecording is {
    from outlet UserManagementAnnouncer.Published to inlet UserManagementStore.Recorded
  } with {
    briefly as "Carries UserManagement events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Members and what they are told"
  described as {
    |Owns who a Trello member is, their profile and settings, and the
    |notifications addressed to them.
  }
}

context WorkspaceManagement as flow is {

  inlet WorkspaceManagementIn is type Trello.WorkspaceManagement.WorkspaceManagementCommand with {
    briefly as "Where commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet WorkspaceDispatch is type Trello.WorkspaceManagement.WorkspaceManagementCommand with {
    briefly as "Where entering commands bound for Workspace are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  handler WorkspaceManagementBoundary is {
    on createWorkspace: command Trello.WorkspaceManagement.Workspace.CreateWorkspace {
      send createWorkspace to outlet Trello.WorkspaceManagement.WorkspaceDispatch
    }
    on addWorkspaceMember: command Trello.WorkspaceManagement.Workspace.AddWorkspaceMember {
      send addWorkspaceMember to outlet Trello.WorkspaceManagement.WorkspaceDispatch
    }
    on updateWorkspaceSettings: command Trello.WorkspaceManagement.Workspace.UpdateWorkspaceSettings {
      send updateWorkspaceSettings to outlet Trello.WorkspaceManagement.WorkspaceDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary to the entity that owns it"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type WorkspaceId is Id(Trello.WorkspaceManagement.Workspace) with {
    briefly as "Unique identifier for one workspace"
    described as {
      |Defined inside WorkspaceManagement because workspace identity is this context's concern.
    }
  }

  entity Workspace as flow is {

    inlet WorkspaceCommands is type Trello.WorkspaceManagement.WorkspaceManagementCommand with {
      briefly as "Where this entity receives its commands"
      described as {
        |A processor receives only through its OWN inlet.
      }
    }

    outlet WorkspaceEvents is type Trello.WorkspaceManagement.WorkspaceManagementEvent with {
      briefly as "Where this entity publishes what happened"
      described as {
        |Publishing goes out the entity's own outlet.
      }
    }

    command CreateWorkspace is {
      workspaceId is Id(Workspace),
      name is String,
      visibility is String
    } with {
      briefly as "Ask for a workspace to be created"
      described as {
        |Sent when a workspace was created.
      }
    }

    command AddWorkspaceMember is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Add a member to a workspace"
      described as {
        |Sent when add a member to a workspace.
      }
    }

    command UpdateWorkspaceSettings is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Change a workspace's settings"
      described as {
        |Sent when change a workspace's settings.
      }
    }

    query WhichWorkspace replies result TheWorkspace is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Ask for the current state of one workspace"
      described as {
        |Sent when a reader wants a workspace they already know of.
      }
    }

    result TheWorkspace is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId,
      summary is String
    } with {
      briefly as "The answer to a WhichWorkspace query"
      described as {
        |Carries the identity and a short summary of the workspace.
      }
    }

    event WorkspaceMemberAdded is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Records that someone was admitted to a workspace"
      described as {
        |Emitted when a member gains access to the workspace's boards.
        |Distinct from WorkspaceCreated because admission happens many
        |times over a workspace's life, and other contexts care about it
        |separately.
      }
    }

    event WorkspaceCreated is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId
    } with {
      briefly as "Records that a workspace was created"
      described as {
        |Emitted once the change has been accepted.
      }
    }

    record WorkspaceFields is {
      workspaceId is Trello.WorkspaceManagement.WorkspaceId,
      name is String,
      visibility is String
    } with {
      briefly as "Everything Trello keeps about one workspace"
      described as {
        |The stored shape of a workspace.
      }
    }

    initial state WorkspaceState of record Trello.WorkspaceManagement.Workspace.WorkspaceFields with {
      briefly as "The state of one workspace"
      described as {
        |A workspace has a single state; its fields change over its lifetime.
      }
    }

    handler WorkspaceHandler is {
      on init {
        set field Trello.WorkspaceManagement.Workspace.WorkspaceFields.workspaceId to "a freshly minted identifier"
      }
      on command CreateWorkspace {
        morph entity Workspace to state WorkspaceState with record Trello.WorkspaceManagement.Workspace.WorkspaceFields(
          workspaceId = prompt("the workspaceId of the resulting Workspace state"),
          name = prompt("the name of the resulting Workspace state"),
          visibility = prompt("the visibility of the resulting Workspace state")
        )
        send event WorkspaceCreated(
          workspaceId = prompt("the workspaceId carried by WorkspaceCreated")
        ) to outlet Trello.WorkspaceManagement.Workspace.WorkspaceEvents
      }
      on command AddWorkspaceMember {
        morph entity Workspace to state WorkspaceState with record Trello.WorkspaceManagement.Workspace.WorkspaceFields(
          workspaceId = prompt("the workspaceId of the resulting Workspace state"),
          name = prompt("the name of the resulting Workspace state"),
          visibility = prompt("the visibility of the resulting Workspace state")
        )
        send event WorkspaceMemberAdded(
          workspaceId = prompt("the workspaceId carried by WorkspaceMemberAdded")
        ) to outlet Trello.WorkspaceManagement.Workspace.WorkspaceEvents
      }
      on command UpdateWorkspaceSettings {
        morph entity Workspace to state WorkspaceState with record Trello.WorkspaceManagement.Workspace.WorkspaceFields(
          workspaceId = prompt("the workspaceId of the resulting Workspace state"),
          name = prompt("the name of the resulting Workspace state"),
          visibility = prompt("the visibility of the resulting Workspace state")
        )
        send event WorkspaceCreated(
          workspaceId = prompt("the workspaceId carried by WorkspaceCreated")
        ) to outlet Trello.WorkspaceManagement.Workspace.WorkspaceEvents
      }
      on query WhichWorkspace {
        reply result TheWorkspace(
          workspaceId = prompt("the workspaceId carried by TheWorkspace"),
          summary = prompt("the summary carried by TheWorkspace")
        )
      }
    } with {
      briefly as "Handles messages addressed to a workspace"
      described as {
        |Creates and changes workspaces and answers questions about them.
      }
    }

  } with {
    briefly as "A single workspace in Trello"
    described as {
      |The entity that remembers that a workspace was created.
    }
  }

  type WorkspaceManagementEvent is one of {
    event Trello.WorkspaceManagement.Workspace.WorkspaceCreated or
    event Trello.WorkspaceManagement.Workspace.WorkspaceMemberAdded
  } with {
    briefly as "Anything WorkspaceManagement announces"
    described as {
      |The alternation of every event this context publishes, so one outlet
      |can carry them all.
    }
  }

  type WorkspaceManagementCommand is one of {
    command Trello.WorkspaceManagement.Workspace.CreateWorkspace or
    command Trello.WorkspaceManagement.Workspace.AddWorkspaceMember or
    command Trello.WorkspaceManagement.Workspace.UpdateWorkspaceSettings
  } with {
    briefly as "Everything WorkspaceManagement can be asked to do"
    described as {
      |The alternation of every command the application sends here, so one
      |inlet and one connector can carry them all.
    }
  }



  repository WorkspaceManagementStore as sink is {
    inlet Recorded is type Trello.WorkspaceManagement.WorkspaceManagementEvent with {
      briefly as "Where events arrive to be persisted"
      described as {
        |The repository learns of changes through this inlet.
      }
    }
    schema WorkspaceManagementSchema is flat
      of Held as record Trello.WorkspaceManagement.Workspace.WorkspaceFields
    with {
      briefly as "How WorkspaceManagement records are laid out in storage"
      described as {
        |A flat schema: one stored row per record.
      }
    }
    handler WorkspaceManagementStoreHandler is {
      on event Trello.WorkspaceManagement.Workspace.WorkspaceCreated {
        do "store the identifier carried by the event"
      }
    } with {
      briefly as "Keeps storage in step with what happened"
      described as {
        |Writes each event into the store.
      }
    }
  } with {
    briefly as "Persists what this context owns"
    described as {
      |Entities are stateful, so WorkspaceManagement keeps a repository.
    }
  }

  connector AddressingWorkspace is {
    from outlet Trello.WorkspaceManagement.WorkspaceDispatch to inlet Trello.WorkspaceManagement.Workspace.WorkspaceCommands
  } with {
    briefly as "Delivers entering commands to the entity itself"
    described as {
      |A 'tell' does not connect a port; the channel must be modelled.
    }
  }

  connector WorkspaceManagementRecording is {
    from outlet Trello.WorkspaceManagement.Workspace.WorkspaceEvents to inlet WorkspaceManagementStore.Recorded
  } with {
    briefly as "Carries WorkspaceManagement events to storage"
    described as {
      |Connects what the context announces to what records it.
    }
  }

} with {
  briefly as "Workspaces and who belongs to them"
  described as {
    |Owns the workspaces that group boards together and the membership
    |that governs who may see them.
  }
}

context BoardManagement as split is {

  inlet BoardManagementIn is type Trello.BoardManagement.BoardManagementCommand with {
    briefly as "Where commands enter this context"
    described as {
      |RIDDL 2.0 makes the context the SINK for everything entering it.
    }
  }

  outlet BoardDispatch is type Trello.BoardManagement.BoardManagementCommand with {
    briefly as "Where entering commands bound for Board are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  outlet CardListDispatch is type Trello.BoardManagement.BoardManagementCommand with {
    briefly as "Where entering commands bound for CardList are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  outlet CardDispatch is type Trello.BoardManagement.BoardManagementCommand with {
    briefly as "Where entering commands bound for Card are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  outlet ActivityDispatch is type Trello.BoardManagement.BoardManagementCommand with {
    briefly as "Where entering commands bound for Activity are handed inward"
    described as {
      |One outlet per entity: an outlet carries exactly one connector.
    }
  }

  handler BoardManagementBoundary is {
    on createBoard: command Trello.BoardManagement.Board.CreateBoard {
      send createBoard to outlet Trello.BoardManagement.BoardDispatch
    }
    on addBoardMember: command Trello.BoardManagement.Board.AddBoardMember {
      send addBoardMember to outlet Trello.BoardManagement.BoardDispatch
    }
    on addList: command Trello.BoardManagement.CardList.AddList {
      send addList to outlet Trello.BoardManagement.CardListDispatch
    }
    on moveList: command Trello.BoardManagement.CardList.MoveList {
      send moveList to outlet Trello.BoardManagement.CardListDispatch
    }
    on addCard: command Trello.BoardManagement.Card.AddCard {
      send addCard to outlet Trello.BoardManagement.CardDispatch
    }
    on editCard: command Trello.BoardManagement.Card.EditCard {
      send editCard to outlet Trello.BoardManagement.CardDispatch
    }
    on moveCard: command Trello.BoardManagement.Card.MoveCard {
      send moveCard to outlet Trello.BoardManagement.CardDispatch
    }
    on assignMember: command Trello.BoardManagement.Card.AssignMember {
      send assignMember to outlet Trello.BoardManagement.CardDispatch
    }
    on addComment: command Trello.BoardManagement.Card.AddComment {
      send addComment to outlet Trello.BoardManagement.CardDispatch
    }
    on addChecklist: command Trello.BoardManagement.Card.AddChecklist {
      send addChecklist to outlet Trello.BoardManagement.CardDispatch
    }
    on setDueDate: command Trello.BoardManagement.Card.SetDueDate {
      send setDueDate to outlet Trello.BoardManagement.CardDispatch
    }
    on recordActivity: command Trello.BoardManagement.Activity.RecordActivity {
      send recordActivity to outlet Trello.BoardManagement.ActivityDispatch
    }
  } with {
    briefly as "Routes what arrives at the boundary to the entity that owns it"
    described as {
      |Peers address the context; the context decides what responds.
    }
  }


  type BoardId is Id(Trello.BoardManagement.Board) with {
