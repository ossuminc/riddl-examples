user Member is "A Trello user who can create and interact with boards" with {
  briefly as "The ordinary user of Trello"
  described as {
    |A member belongs to workspaces, opens the boards inside them, and moves
    |cards between lists as work progresses.
  }
}

user Admin is "A user with administrative privileges over a workspace" with {
  briefly as "The user who governs a workspace"
  described as {
    |An admin creates workspaces, admits members to them, and sets what the
    |rest of the world may see.
  }
}

epic BoardManagementEpic is {

  user Member wants to "create and manage boards"
    so that "they can organize their work"

  case CreateABoard is {
    user Member wants to "create a new board"
      so that "they can start organizing tasks"
    step focus user Member on group BoardsPage
    step take form NewBoard from user Member
    step send command Trello.BoardManagement.Board.CreateBoard
      from source Trello.TrelloUI.BoardManagementRequests
      to sink Trello.BoardManagement.BoardManagementIntake
  } with {
    briefly as "Creating a board from the boards page"
    described as {
      |The member names a board, the application echoes it back, and the
      |command reaches BoardManagement.
    }
  }

  case AddAListAndCard is {
    user Member wants to "add a list and a card to a board"
      so that "they can track a specific task"
    step send command Trello.BoardManagement.CardList.AddList
      from source Trello.TrelloUI.BoardManagementRequests
      to sink Trello.BoardManagement.BoardManagementIntake
    step send command Trello.BoardManagement.Card.AddCard
      from source Trello.TrelloUI.BoardManagementRequests
      to sink Trello.BoardManagement.BoardManagementIntake
  } with {
    briefly as "Filling a board with lists and cards"
    described as {
      |Lists divide a board into stages; cards are the work that moves
      |between them.
    }
  }

  case MoveACard is {
    user Member wants to "move a card to a different list"
      so that "they can update its status"
    step send command Trello.BoardManagement.Card.MoveCard
      from source Trello.TrelloUI.BoardManagementRequests
      to sink Trello.BoardManagement.BoardManagementIntake
  } with {
    briefly as "Moving a card between lists"
    described as {
      |The gesture at the centre of Trello: dragging a card from one stage
      |to the next.
    }
  }

} with {
  briefly as "How a member organizes work on a board"
  described as {
    |Boards, the lists that divide them and the cards that move across
    |them — the core of what Trello is for.
  }
}

epic CardDetailEpic is {

  user Member wants to "manage card details"
    so that "they can track task information"

  case EnrichACard is {
    user Member wants to "edit a card and give it an owner and a deadline"
      so that "responsibility and timing are clear"
    step send command Trello.BoardManagement.Card.EditCard
      from source Trello.TrelloUI.BoardManagementRequests
      to sink Trello.BoardManagement.BoardManagementIntake
    step send command Trello.BoardManagement.Card.AssignMember
      from source Trello.TrelloUI.BoardManagementRequests
      to sink Trello.BoardManagement.BoardManagementIntake
    step send command Trello.BoardManagement.Card.SetDueDate
      from source Trello.TrelloUI.BoardManagementRequests
      to sink Trello.BoardManagement.BoardManagementIntake
  } with {
    briefly as "Filling in a card"
    described as {
      |A card starts as a title and gains detail as the work is understood.
    }
  }

} with {
  briefly as "How a card acquires its detail"
  described as {
    |Comments, checklists, owners and due dates are all changes to one card.
  }
}

epic WorkspaceManagementEpic is {

  user Admin wants to "manage workspaces and members"
    so that "they can organize teams and projects"

  case SetUpAWorkspace is {
    user Admin wants to "create a workspace and admit a member"
      so that "a team can share boards"
    step send command Trello.WorkspaceManagement.Workspace.CreateWorkspace
      from source Trello.TrelloUI.WorkspaceManagementRequests
      to sink Trello.WorkspaceManagement.WorkspaceManagementIntake
    step send command Trello.WorkspaceManagement.Workspace.AddWorkspaceMember
      from source Trello.TrelloUI.WorkspaceManagementRequests
      to sink Trello.WorkspaceManagement.WorkspaceManagementIntake
  } with {
    briefly as "Standing up a workspace"
    described as {
      |A workspace is created and then populated with the people who may
      |see its boards.
    }
  }

} with {
  briefly as "How an admin sets up a team's space"
  described as {
    |Workspaces group boards and govern who may open them.
  }
}

epic NotificationEpic is {

  user Member wants to "receive and manage notifications"
    so that "they stay informed of relevant updates"

  case ClearNotifications is {
    user Member wants to "mark notifications as read"
      so that "they can focus on new ones"
    step send command Trello.UserManagement.Notification.MarkAsRead
      from source Trello.TrelloUI.UserManagementRequests
      to sink Trello.UserManagement.UserManagementIntake
    step send command Trello.UserManagement.Notification.MarkAllAsRead
      from source Trello.TrelloUI.UserManagementRequests
      to sink Trello.UserManagement.UserManagementIntake
  } with {
    briefly as "Clearing the notification list"
    described as {
      |Notifications are marked read one at a time or all at once.
    }
  }

} with {
  briefly as "How a member keeps up with activity"
  described as {
    |Trello tells members what happened on the boards they follow.
  }
}
