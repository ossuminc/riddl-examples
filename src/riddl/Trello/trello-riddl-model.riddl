domain Trello is {

  author Reid is {
    name: "Reid Spencer"
    email: "reid@ossuminc.com"
    organization: "Ossum Inc."
    title: "Chief Architect"
  } with {
    briefly as "The author of this example model"
    described as {
      |Reid Spencer designs the RIDDL language and writes the example models
      |that exercise it.
    }
  }

  include "contexts"
  include "application"
  include "epics"

  connector UserManagementRequests is {
    from outlet Trello.TrelloUI.UserManagementRequests.UserManagementSubmissions
    to inlet Trello.UserManagement.UserManagementIntake.Requests
  } with {
    briefly as "Carries requests from the application to UserManagement"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and made
      |persistent as RIDDL 2.0 requires.
    }
    option is persistent
  }

  connector WorkspaceManagementRequests is {
    from outlet Trello.TrelloUI.WorkspaceManagementRequests.WorkspaceManagementSubmissions
    to inlet Trello.WorkspaceManagement.WorkspaceManagementIntake.Requests
  } with {
    briefly as "Carries requests from the application to WorkspaceManagement"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and made
      |persistent as RIDDL 2.0 requires.
    }
    option is persistent
  }

  connector BoardManagementRequests is {
    from outlet Trello.TrelloUI.BoardManagementRequests.BoardManagementSubmissions
    to inlet Trello.BoardManagement.BoardManagementIntake.Requests
  } with {
    briefly as "Carries requests from the application to BoardManagement"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and made
      |persistent as RIDDL 2.0 requires.
    }
    option is persistent
  }

} with {
  briefly as "A kanban board application, modelled in RIDDL 2.0"
  described as {
    |Trello organizes work as cards that move across the lists of a board.
    |Boards live in workspaces, workspaces have members, and members are
    |told when something they follow changes.
    |
    |Three contexts carry the model. UserManagement owns members and their
    |notifications. WorkspaceManagement owns the workspaces and who belongs
    |to them. BoardManagement owns boards, their lists, the cards on them,
    |and the activity trail.
    |
    |This model was rebuilt from scratch for RIDDL 2.0. Its predecessor was
    |written before 1.0 and no longer parsed: it opened with an epic step
    |whose syntax has since been replaced, and the file had drifted far
    |enough that repair would have cost more than rewriting.
  }
  by author Reid
}
