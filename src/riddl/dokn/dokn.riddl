domain dokn is {

  author Reid is {
    name: "Reid Spencer"
    email: "reid@ossuminc.com"
    organization: "Ossum Inc."
    title: "Chief Architect"
  } with {
    briefly as "The author of this example model"
    described as {
      |Reid Spencer designs the RIDDL language and writes the example models
      |that exercise it.
    }
  }

  context Companies as flow is {

    inlet CompanyIn is command dokn.Companies.Company.AddCompany with {
      briefly as "Where company commands enter this context"
      described as {
        |RIDDL 2.0 makes the context the SINK for everything entering it: a
        |cross-context connector lands here, never on a portlet of something
        |this context contains.
      }
    }

    outlet CompanyDispatch is command dokn.Companies.Company.AddCompany with {
      briefly as "Where entering commands are handed inward"
      described as {
        |The boundary handler re-sends arrivals here, and an intra-context
        |connector carries them to the entity. Inside the boundary nothing is
        |restricted.
      }
    }

    inlet Failures is record Riddl.GeneratorError with {
      option error-sink
      briefly as "Where hard errors go"
      described as {
        |RIDDL 2.0 wants every domain to name a destination for failures no
        |handler can recover from. An error-sink inlet is infrastructure
        |rather than dataflow, so it does not count toward this processor's
        |arity.
      }
    }

    handler CompaniesBoundary is {
      on request: command dokn.Companies.Company.AddCompany {
        forward request to outlet dokn.Companies.CompanyDispatch
      }
    } with {
      briefly as "Routes what arrives at the boundary inward"
      described as {
        |Keeps the context's contents private: peers address the context, and
        |the context decides what inside it responds.
      }
    }

    type CompanyId is Id(dokn.Companies.Company) with {
      briefly as "Unique identifier for one company"
      described as {
        |Defined inside Companies because company identity is this context's concern.
      }
    }

    type Address is {
      line1 is String,
      city is String,
      province is String,
      country is String,
      postalCode is String
    } with {
      briefly as "A postal address as Companies understands it"
      described as {
        |Each context keeps its own address shape. Contexts do not share
        |types in RIDDL 2.0; they exchange messages.
      }
    }

    type MobileNumber is Pattern("\\(([0-9]{3})\\)([0-9]{3})-([0-9]{4})") with {
      briefly as "A North American mobile number"
      described as {
        |Written as (nnn)nnn-nnnn.
      }
    }

    type EmailAddress is Pattern("^[a-zA-Z0-9_+&*-]+@[a-zA-Z0-9-]+\\.[a-zA-Z]{2,7}") with {
      briefly as "An email address"
      described as {
        |Loosely checked; delivery is the only real test.
      }
    }

    event-sourced available entity Company as flow is {

      inlet CompanyCommands is command dokn.Companies.Company.AddCompany with {
        briefly as "Where this entity receives its commands"
        described as {
          |A processor receives only through its OWN inlet; a port on its
          |context or on a sibling does not deliver to it.
        }
      }

      outlet CompanyEvents is event dokn.Companies.Company.CompanyAdded with {
        briefly as "Where this entity publishes what happened"
        described as {
          |Publishing goes out the entity's own outlet.
        }
      }

      command AddCompany yields event CompanyAdded is {
        companyId is Id(Company),
        mailingAddress is dokn.Companies.Address,
        primaryContactName is String,
        primaryContactPhone is dokn.Companies.MobileNumber,
        primaryContactEmail is dokn.Companies.EmailAddress
      } with {
        briefly as "Ask for a company to be recorded"
        described as {
          |Sent when a company joined the network.
        }
      }

      query WhichCompany replies result TheCompany is {
        companyId is dokn.Companies.CompanyId
      } with {
        briefly as "Ask for the current state of one company"
        described as {
          |Sent when a reader wants a company they already know of.
        }
      }

      result TheCompany is {
        companyId is dokn.Companies.CompanyId,
        summary is String
      } with {
        briefly as "The answer to a WhichCompany query"
        described as {
          |Carries the identity and a short summary of the company.
        }
      }

      event CompanyAdded is {
        companyId is dokn.Companies.CompanyId
      } with {
        briefly as "Records that a company joined the network"
        described as {
          |Emitted once the change has been accepted.
        }
      }

      record Fields is {
        companyId is dokn.Companies.CompanyId,
        mailingAddress is dokn.Companies.Address,
        primaryContactName is String,
        primaryContactPhone is dokn.Companies.MobileNumber,
        primaryContactEmail is dokn.Companies.EmailAddress
      } with {
        briefly as "Everything dokn keeps about one company"
        described as {
          |The stored shape of a company.
        }
      }

      initial state CompanyBase of record dokn.Companies.Company.Fields with {
        briefly as "The state of one company"
        described as {
          |A company has a single state; its fields change but its kind does not.
        }
      }

      handler CompanyHandler is {
        on command AddCompany {
          yield event CompanyAdded(companyId = prompt("the companyId carried by CompanyAdded"))
          send event CompanyAdded(
            companyId = prompt("the companyId carried by CompanyAdded")
          ) to outlet dokn.Companies.Company.CompanyEvents
        }
        on event CompanyAdded {
          morph entity Company to state CompanyBase with record dokn.Companies.Company.Fields(
            companyId = prompt("the companyId of the resulting Company state"),
            mailingAddress = prompt("the mailingAddress of the resulting Company state"),
            primaryContactName = prompt("the primaryContactName of the resulting Company state"),
            primaryContactPhone = prompt("the primaryContactPhone of the resulting Company state"),
            primaryContactEmail = prompt("the primaryContactEmail of the resulting Company state")
          )
          set field dokn.Companies.Company.Fields.companyId to "the identifier carried by the event"
        }
        on query WhichCompany {
          reply result TheCompany(
            companyId = prompt("the companyId carried by TheCompany"),
            summary = prompt("the summary carried by TheCompany")
          )
        }
      } with {
        briefly as "Handles messages addressed to a company"
        described as {
          |Records companys and answers questions about them.
        }
      }

    } with {
      briefly as "A single company known to dokn"
      described as {
        |The entity that remembers that a company joined the network.
      }
    }



    repository CompanyStore as sink is {
      inlet Recorded is event dokn.Companies.Company.CompanyAdded with {
        briefly as "Where company events arrive to be persisted"
        described as {
          |The repository learns of changes through this inlet.
        }
      }
      schema Store is flat
        of Held as record dokn.Companies.Company.Fields
      with {
        briefly as "How companys are laid out in storage"
        described as {
          |A flat schema: one stored row per company.
        }
      }
      handler CompanyStoreHandler is {
        on event dokn.Companies.Company.CompanyAdded {
          do "store the identifier carried by the event"
        }
      } with {
        briefly as "Keeps storage in step with what happened"
        described as {
          |Writes each event into the store.
        }
      }
    } with {
      briefly as "Persists the companys of this context"
      described as {
        |Entities are stateful, so Companies keeps a repository.
      }
    }

    connector ErrorReporting is {
      from outlet Riddl.ForeverEmpty.void to inlet dokn.Companies.Failures
    } with {
      briefly as "Terminates the error-sink inlet"
      described as {
        |Nothing in this model produces a GeneratorError — those come from
        |generators at runtime, not from anything the model declares. The
        |predefined ForeverEmpty source exists for exactly this: a port that
        |must be connected but has no modelled producer.
      }
    }


    connector AddressingCompany is {
      from outlet dokn.Companies.CompanyDispatch to inlet dokn.Companies.Company.CompanyCommands
    } with {
      briefly as "Delivers entering commands to the entity itself"
      described as {
        |A 'tell' does not connect a port -- it is sugar for a send on the
        |outlet connected to the target's inlet, so the channel is modelled.
      }
    }

    connector RecordingCompany is {
      from outlet dokn.Companies.Company.CompanyEvents to inlet CompanyStore.Recorded
    } with {
      briefly as "Carries company events to storage"
      described as {
        |Connects what the context announces to what records it.
      }
    }

  } with {
    briefly as "Owns the companys dokn knows about"
    described as {
      |The Companies context is responsible for companys: recording them,
      |changing them, and answering questions about them.
    }
  }

  context Drivers as flow is {

    inlet DriverIn is command dokn.Drivers.Driver.AddDriverToCompany with {
      briefly as "Where driver commands enter this context"
      described as {
        |RIDDL 2.0 makes the context the SINK for everything entering it.
      }
    }

    outlet DriverDispatch is command dokn.Drivers.Driver.AddDriverToCompany with {
      briefly as "Where entering commands are handed inward"
      described as {
        |Inside the boundary nothing is restricted, so this addresses the
        |entity's own inlet directly.
      }
    }

    handler DriversBoundary is {
      on request: command dokn.Drivers.Driver.AddDriverToCompany {
        forward request to outlet dokn.Drivers.DriverDispatch
      }
    } with {
      briefly as "Routes what arrives at the boundary inward"
      described as {
        |Peers address the context; the context decides what inside it responds.
      }
    }

    type DriverId is Id(dokn.Drivers.Driver) with {
      briefly as "Unique identifier for one driver"
      described as {
        |Defined inside Drivers because driver identity is this context's concern.
      }
    }

    type MobileNumber is Pattern("\\(([0-9]{3})\\)([0-9]{3})-([0-9]{4})") with {
      briefly as "A North American mobile number"
      described as {
        |Written as (nnn)nnn-nnnn.
      }
    }

    event-sourced available entity Driver as flow is {

      inlet DriverCommands is command dokn.Drivers.Driver.AddDriverToCompany with {
        briefly as "Where this entity receives its commands"
        described as {
          |A processor receives only through its OWN inlet.
        }
      }

      outlet DriverEvents is event dokn.Drivers.Driver.DriverAddedToCompany with {
        briefly as "Where this entity publishes what happened"
        described as {
          |Publishing goes out the entity's own outlet.
        }
      }

      command AddDriverToCompany yields event DriverAddedToCompany is {
        driverId is Id(Driver),
        name is String,
        mobile is dokn.Drivers.MobileNumber,
        onDutyTime is TimeStamp
      } with {
        briefly as "Ask for a driver to be recorded"
        described as {
          |Sent when a driver joined a company.
        }
      }

      query WhichDriver replies result TheDriver is {
        driverId is dokn.Drivers.DriverId
      } with {
        briefly as "Ask for the current state of one driver"
        described as {
          |Sent when a reader wants a driver they already know of.
        }
      }

      result TheDriver is {
        driverId is dokn.Drivers.DriverId,
        summary is String
      } with {
        briefly as "The answer to a WhichDriver query"
        described as {
          |Carries the identity and a short summary of the driver.
        }
      }

      event DriverAddedToCompany is {
        driverId is dokn.Drivers.DriverId
      } with {
        briefly as "Records that a driver joined a company"
        described as {
          |Emitted once the change has been accepted.
        }
      }

      record Fields is {
        driverId is dokn.Drivers.DriverId,
        name is String,
        mobile is dokn.Drivers.MobileNumber,
        onDutyTime is TimeStamp
      } with {
        briefly as "Everything dokn keeps about one driver"
        described as {
          |The stored shape of a driver.
        }
      }

      initial state DriverBase of record dokn.Drivers.Driver.Fields with {
        briefly as "The state of one driver"
        described as {
          |A driver has a single state; its fields change but its kind does not.
        }
      }

      handler DriverHandler is {
        on command AddDriverToCompany {
          yield event DriverAddedToCompany(driverId = prompt("the driverId carried by DriverAddedToCompany"))
          send event DriverAddedToCompany(
            driverId = prompt("the driverId carried by DriverAddedToCompany")
          ) to outlet dokn.Drivers.Driver.DriverEvents
        }
        on event DriverAddedToCompany {
          morph entity Driver to state DriverBase with record dokn.Drivers.Driver.Fields(
            driverId = prompt("the driverId of the resulting Driver state"),
            name = prompt("the name of the resulting Driver state"),
            mobile = prompt("the mobile of the resulting Driver state"),
            onDutyTime = prompt("the onDutyTime of the resulting Driver state")
          )
          set field dokn.Drivers.Driver.Fields.driverId to "the identifier carried by the event"
        }
        on query WhichDriver {
          reply result TheDriver(
            driverId = prompt("the driverId carried by TheDriver"),
            summary = prompt("the summary carried by TheDriver")
          )
        }
      } with {
        briefly as "Handles messages addressed to a driver"
        described as {
          |Records drivers and answers questions about them.
        }
      }

    } with {
      briefly as "A single driver known to dokn"
      described as {
        |The entity that remembers that a driver joined a company.
      }
    }



    repository DriverStore as sink is {
      inlet Recorded is event dokn.Drivers.Driver.DriverAddedToCompany with {
        briefly as "Where driver events arrive to be persisted"
        described as {
          |The repository learns of changes through this inlet.
        }
      }
      schema Store is flat
        of Held as record dokn.Drivers.Driver.Fields
      with {
        briefly as "How drivers are laid out in storage"
        described as {
          |A flat schema: one stored row per driver.
        }
      }
      handler DriverStoreHandler is {
        on event dokn.Drivers.Driver.DriverAddedToCompany {
          do "store the identifier carried by the event"
        }
      } with {
        briefly as "Keeps storage in step with what happened"
        described as {
          |Writes each event into the store.
        }
      }
    } with {
      briefly as "Persists the drivers of this context"
      described as {
        |Entities are stateful, so Drivers keeps a repository.
      }
    }

    connector AddressingDriver is {
      from outlet dokn.Drivers.DriverDispatch to inlet dokn.Drivers.Driver.DriverCommands
    } with {
      briefly as "Delivers entering commands to the entity itself"
      described as {
        |A 'tell' does not connect a port; the channel must be modelled.
      }
    }

    connector RecordingDriver is {
      from outlet dokn.Drivers.Driver.DriverEvents to inlet DriverStore.Recorded
    } with {
      briefly as "Carries driver events to storage"
      described as {
        |Connects what the context announces to what records it.
      }
    }

  } with {
    briefly as "Owns the drivers dokn knows about"
    described as {
      |The Drivers context is responsible for drivers: recording them,
      |changing them, and answering questions about them.
    }
  }

  context Notes as flow is {

    inlet NoteIn is command dokn.Notes.Note.CaptureNote with {
      briefly as "Where note commands enter this context"
      described as {
        |RIDDL 2.0 makes the context the SINK for everything entering it.
      }
    }

    outlet NoteDispatch is command dokn.Notes.Note.CaptureNote with {
      briefly as "Where entering commands are handed inward"
      described as {
        |Inside the boundary nothing is restricted, so this addresses the
        |entity's own inlet directly.
      }
    }

    handler NotesBoundary is {
      on request: command dokn.Notes.Note.CaptureNote {
        forward request to outlet dokn.Notes.NoteDispatch
      }
    } with {
      briefly as "Routes what arrives at the boundary inward"
      described as {
        |Peers address the context; the context decides what inside it responds.
      }
    }

    type NoteId is Id(dokn.Notes.Note) with {
      briefly as "Unique identifier for one note"
      described as {
        |Defined inside Notes because note identity is this context's concern.
      }
    }

    event-sourced available entity Note as flow is {

      inlet NoteCommands is command dokn.Notes.Note.CaptureNote with {
        briefly as "Where this entity receives its commands"
        described as {
          |A processor receives only through its OWN inlet.
        }
      }

      outlet NoteEvents is event dokn.Notes.Note.NoteCaptured with {
        briefly as "Where this entity publishes what happened"
        described as {
          |Publishing goes out the entity's own outlet.
        }
      }

      command CaptureNote yields event NoteCaptured is {
        noteId is Id(Note),
        text is String,
        upvoteCount is Integer,
        downvoteCount is Integer,
        approved is Boolean
      } with {
        briefly as "Ask for a note to be recorded"
        described as {
          |Sent when a driver wrote a note about a location.
        }
      }

      query WhichNote replies result TheNote is {
        noteId is dokn.Notes.NoteId
      } with {
        briefly as "Ask for the current state of one note"
        described as {
          |Sent when a reader wants a note they already know of.
        }
      }

      result TheNote is {
        noteId is dokn.Notes.NoteId,
        summary is String
      } with {
        briefly as "The answer to a WhichNote query"
        described as {
          |Carries the identity and a short summary of the note.
        }
      }

      event NoteCaptured is {
        noteId is dokn.Notes.NoteId
      } with {
        briefly as "Records that a driver wrote a note about a location"
        described as {
          |Emitted once the change has been accepted.
        }
      }

      record Fields is {
        noteId is dokn.Notes.NoteId,
        text is String,
        upvoteCount is Integer,
        downvoteCount is Integer,
        approved is Boolean
      } with {
        briefly as "Everything dokn keeps about one note"
        described as {
          |The stored shape of a note.
        }
      }

      initial state NoteBase of record dokn.Notes.Note.Fields with {
        briefly as "The state of one note"
        described as {
          |A note has a single state; its fields change but its kind does not.
        }
      }

      handler NoteHandler is {
        on command CaptureNote {
          yield event NoteCaptured(noteId = prompt("the noteId carried by NoteCaptured"))
          send event NoteCaptured(
            noteId = prompt("the noteId carried by NoteCaptured")
          ) to outlet dokn.Notes.Note.NoteEvents
        }
        on event NoteCaptured {
          morph entity Note to state NoteBase with record dokn.Notes.Note.Fields(
            noteId = prompt("the noteId of the resulting Note state"),
            text = prompt("the text of the resulting Note state"),
            upvoteCount = prompt("the upvoteCount of the resulting Note state"),
            downvoteCount = prompt("the downvoteCount of the resulting Note state"),
            approved = prompt("the approved of the resulting Note state")
          )
          set field dokn.Notes.Note.Fields.noteId to "the identifier carried by the event"
        }
        on query WhichNote {
          reply result TheNote(
            noteId = prompt("the noteId carried by TheNote"),
            summary = prompt("the summary carried by TheNote")
          )
        }
      } with {
        briefly as "Handles messages addressed to a note"
        described as {
          |Records notes and answers questions about them.
        }
      }

    } with {
      briefly as "A single note known to dokn"
      described as {
        |The entity that remembers that a driver wrote a note about a location.
      }
    }



    repository NoteStore as sink is {
      inlet Recorded is event dokn.Notes.Note.NoteCaptured with {
        briefly as "Where note events arrive to be persisted"
        described as {
          |The repository learns of changes through this inlet.
        }
      }
      schema Store is flat
        of Held as record dokn.Notes.Note.Fields
      with {
        briefly as "How notes are laid out in storage"
        described as {
          |A flat schema: one stored row per note.
        }
      }
      handler NoteStoreHandler is {
        on event dokn.Notes.Note.NoteCaptured {
          do "store the identifier carried by the event"
        }
      } with {
        briefly as "Keeps storage in step with what happened"
        described as {
          |Writes each event into the store.
        }
      }
    } with {
      briefly as "Persists the notes of this context"
      described as {
        |Entities are stateful, so Notes keeps a repository.
      }
    }

    connector AddressingNote is {
      from outlet dokn.Notes.NoteDispatch to inlet dokn.Notes.Note.NoteCommands
    } with {
      briefly as "Delivers entering commands to the entity itself"
      described as {
        |A 'tell' does not connect a port; the channel must be modelled.
      }
    }

    connector RecordingNote is {
      from outlet dokn.Notes.Note.NoteEvents to inlet NoteStore.Recorded
    } with {
      briefly as "Carries note events to storage"
      described as {
        |Connects what the context announces to what records it.
      }
    }

  } with {
    briefly as "Owns the notes dokn knows about"
    described as {
      |The Notes context is responsible for notes: recording them,
      |changing them, and answering questions about them.
    }
  }

  context Media as flow is {

    inlet MediumIn is command dokn.Media.Medium.StoreMedium with {
      briefly as "Where medium commands enter this context"
      described as {
        |RIDDL 2.0 makes the context the SINK for everything entering it.
      }
    }

    outlet MediumDispatch is command dokn.Media.Medium.StoreMedium with {
      briefly as "Where entering commands are handed inward"
      described as {
        |Inside the boundary nothing is restricted, so this addresses the
        |entity's own inlet directly.
      }
    }

    handler MediaBoundary is {
      on request: command dokn.Media.Medium.StoreMedium {
        forward request to outlet dokn.Media.MediumDispatch
      }
    } with {
      briefly as "Routes what arrives at the boundary inward"
      described as {
        |Peers address the context; the context decides what inside it responds.
      }
    }

    type MediaId is Id(dokn.Media.Medium) with {
      briefly as "Unique identifier for one medium"
      described as {
        |Defined inside Media because medium identity is this context's concern.
      }
    }

    event-sourced available entity Medium as flow is {

      inlet MediumCommands is command dokn.Media.Medium.StoreMedium with {
        briefly as "Where this entity receives its commands"
        described as {
          |A processor receives only through its OWN inlet.
        }
      }

      outlet MediumEvents is event dokn.Media.Medium.MediumStored with {
        briefly as "Where this entity publishes what happened"
        described as {
          |Publishing goes out the entity's own outlet.
        }
      }

      command StoreMedium yields event MediumStored is {
        mediumId is Id(Medium),
        path is String
      } with {
        briefly as "Ask for a medium to be recorded"
        described as {
          |Sent when a photograph or document was filed.
        }
      }

      query WhichMedium replies result TheMedium is {
        mediaId is dokn.Media.MediaId
      } with {
        briefly as "Ask for the current state of one medium"
        described as {
          |Sent when a reader wants a medium they already know of.
        }
      }

      result TheMedium is {
        mediaId is dokn.Media.MediaId,
        summary is String
      } with {
        briefly as "The answer to a WhichMedium query"
        described as {
          |Carries the identity and a short summary of the medium.
        }
      }

      event MediumStored is {
        mediaId is dokn.Media.MediaId
      } with {
        briefly as "Records that a photograph or document was filed"
        described as {
          |Emitted once the change has been accepted.
        }
      }

      record Fields is {
        mediaId is dokn.Media.MediaId,
        path is String
      } with {
        briefly as "Everything dokn keeps about one medium"
        described as {
          |The stored shape of a medium.
        }
      }

      initial state MediumBase of record dokn.Media.Medium.Fields with {
        briefly as "The state of one medium"
        described as {
          |A medium has a single state; its fields change but its kind does not.
        }
      }

      handler MediumHandler is {
        on command StoreMedium {
          yield event MediumStored(mediaId = prompt("the mediaId carried by MediumStored"))
          send event MediumStored(
            mediaId = prompt("the mediaId carried by MediumStored")
          ) to outlet dokn.Media.Medium.MediumEvents
        }
        on event MediumStored {
          morph entity Medium to state MediumBase with record dokn.Media.Medium.Fields(
            mediaId = prompt("the mediaId of the resulting Medium state"),
            path = prompt("the path of the resulting Medium state")
          )
          set field dokn.Media.Medium.Fields.mediaId to "the identifier carried by the event"
        }
        on query WhichMedium {
          reply result TheMedium(
            mediaId = prompt("the mediaId carried by TheMedium"),
            summary = prompt("the summary carried by TheMedium")
          )
        }
      } with {
        briefly as "Handles messages addressed to a medium"
        described as {
          |Records mediums and answers questions about them.
        }
      }

    } with {
      briefly as "A single medium known to dokn"
      described as {
        |The entity that remembers that a photograph or document was filed.
      }
    }



    repository MediumStore as sink is {
      inlet Recorded is event dokn.Media.Medium.MediumStored with {
        briefly as "Where medium events arrive to be persisted"
        described as {
          |The repository learns of changes through this inlet.
        }
      }
      schema Store is flat
        of Held as record dokn.Media.Medium.Fields
      with {
        briefly as "How mediums are laid out in storage"
        described as {
          |A flat schema: one stored row per medium.
        }
      }
      handler MediumStoreHandler is {
        on event dokn.Media.Medium.MediumStored {
          do "store the identifier carried by the event"
        }
      } with {
        briefly as "Keeps storage in step with what happened"
        described as {
          |Writes each event into the store.
        }
      }
    } with {
      briefly as "Persists the mediums of this context"
      described as {
        |Entities are stateful, so Media keeps a repository.
      }
    }

    connector AddressingMedium is {
      from outlet dokn.Media.MediumDispatch to inlet dokn.Media.Medium.MediumCommands
    } with {
      briefly as "Delivers entering commands to the entity itself"
      described as {
        |A 'tell' does not connect a port; the channel must be modelled.
      }
    }

    connector RecordingMedium is {
      from outlet dokn.Media.Medium.MediumEvents to inlet MediumStore.Recorded
    } with {
      briefly as "Carries medium events to storage"
      described as {
        |Connects what the context announces to what records it.
      }
    }

  } with {
    briefly as "Owns the mediums dokn knows about"
    described as {
      |The Media context is responsible for mediums: recording them,
      |changing them, and answering questions about them.
    }
  }

  context Locations as flow is {

    inlet LocationIn is command dokn.Locations.Location.AddDeliveryLocation with {
      briefly as "Where location commands enter this context"
      described as {
        |RIDDL 2.0 makes the context the SINK for everything entering it.
      }
    }

    outlet LocationDispatch is command dokn.Locations.Location.AddDeliveryLocation with {
      briefly as "Where entering commands are handed inward"
      described as {
        |Inside the boundary nothing is restricted, so this addresses the
        |entity's own inlet directly.
      }
    }

    handler LocationsBoundary is {
      on request: command dokn.Locations.Location.AddDeliveryLocation {
        forward request to outlet dokn.Locations.LocationDispatch
      }
    } with {
      briefly as "Routes what arrives at the boundary inward"
      described as {
        |Peers address the context; the context decides what inside it responds.
      }
    }

    type LocationId is Id(dokn.Locations.Location) with {
      briefly as "Unique identifier for one location"
      described as {
        |Defined inside Locations because location identity is this context's concern.
      }
    }

    type Address is {
      line1 is String,
      city is String,
      province is String,
      country is String,
      postalCode is String
    } with {
      briefly as "A postal address as Locations understands it"
      described as {
        |Each context keeps its own address shape. Contexts do not share
        |types in RIDDL 2.0; they exchange messages.
      }
    }

    type LoadingMethod is any of { Dock, Tailgate, Forklift, None } with {
      briefly as "How freight is moved on and off a vehicle"
      described as {
        |Drivers need to know this before they arrive.
      }
    }

    event-sourced available entity Location as flow is {

      inlet LocationCommands is command dokn.Locations.Location.AddDeliveryLocation with {
        briefly as "Where this entity receives its commands"
        described as {
          |A processor receives only through its OWN inlet.
        }
      }

      outlet LocationEvents is event dokn.Locations.Location.DeliveryLocationAdded with {
        briefly as "Where this entity publishes what happened"
        described as {
          |Publishing goes out the entity's own outlet.
        }
      }

      command AddDeliveryLocation yields event DeliveryLocationAdded is {
        locationId is Id(Location),
        label is String,
        address is dokn.Locations.Address,
        ticketCount is Integer,
        loadingMethod is dokn.Locations.LoadingMethod
      } with {
        briefly as "Ask for a location to be recorded"
        described as {
          |Sent when a delivery location was added.
        }
      }

      query WhichLocation replies result TheLocation is {
        locationId is dokn.Locations.LocationId
      } with {
        briefly as "Ask for the current state of one location"
        described as {
          |Sent when a reader wants a location they already know of.
        }
      }

      result TheLocation is {
        locationId is dokn.Locations.LocationId,
        summary is String
      } with {
        briefly as "The answer to a WhichLocation query"
        described as {
          |Carries the identity and a short summary of the location.
        }
      }

      event DeliveryLocationAdded is {
        locationId is dokn.Locations.LocationId
      } with {
        briefly as "Records that a delivery location was added"
        described as {
          |Emitted once the change has been accepted.
        }
      }

      record Fields is {
        locationId is dokn.Locations.LocationId,
        label is String,
        address is dokn.Locations.Address,
        ticketCount is Integer,
        loadingMethod is dokn.Locations.LoadingMethod
      } with {
        briefly as "Everything dokn keeps about one location"
        described as {
          |The stored shape of a location.
        }
      }

      initial state LocationBase of record dokn.Locations.Location.Fields with {
        briefly as "The state of one location"
        described as {
          |A location has a single state; its fields change but its kind does not.
        }
      }

      handler LocationHandler is {
        on command AddDeliveryLocation {
          yield event DeliveryLocationAdded(locationId = prompt("the locationId carried by DeliveryLocationAdded"))
          send event DeliveryLocationAdded(
            locationId = prompt("the locationId carried by DeliveryLocationAdded")
          ) to outlet dokn.Locations.Location.LocationEvents
        }
        on event DeliveryLocationAdded {
          morph entity Location to state LocationBase with record dokn.Locations.Location.Fields(
            locationId = prompt("the locationId of the resulting Location state"),
            label = prompt("the label of the resulting Location state"),
            address = prompt("the address of the resulting Location state"),
            ticketCount = prompt("the ticketCount of the resulting Location state"),
            loadingMethod = prompt("the loadingMethod of the resulting Location state")
          )
          set field dokn.Locations.Location.Fields.locationId to "the identifier carried by the event"
        }
        on query WhichLocation {
          reply result TheLocation(
            locationId = prompt("the locationId carried by TheLocation"),
            summary = prompt("the summary carried by TheLocation")
          )
        }
      } with {
        briefly as "Handles messages addressed to a location"
        described as {
          |Records locations and answers questions about them.
        }
      }

    } with {
      briefly as "A single location known to dokn"
      described as {
        |The entity that remembers that a delivery location was added.
      }
    }



    repository LocationStore as sink is {
      inlet Recorded is event dokn.Locations.Location.DeliveryLocationAdded with {
        briefly as "Where location events arrive to be persisted"
        described as {
          |The repository learns of changes through this inlet.
        }
      }
      schema Store is flat
        of Held as record dokn.Locations.Location.Fields
      with {
        briefly as "How locations are laid out in storage"
        described as {
          |A flat schema: one stored row per location.
        }
      }
      handler LocationStoreHandler is {
        on event dokn.Locations.Location.DeliveryLocationAdded {
          do "store the identifier carried by the event"
        }
      } with {
        briefly as "Keeps storage in step with what happened"
        described as {
          |Writes each event into the store.
        }
      }
    } with {
      briefly as "Persists the locations of this context"
      described as {
        |Entities are stateful, so Locations keeps a repository.
      }
    }

    connector AddressingLocation is {
      from outlet dokn.Locations.LocationDispatch to inlet dokn.Locations.Location.LocationCommands
    } with {
      briefly as "Delivers entering commands to the entity itself"
      described as {
        |A 'tell' does not connect a port; the channel must be modelled.
      }
    }

    connector RecordingLocation is {
      from outlet dokn.Locations.Location.LocationEvents to inlet LocationStore.Recorded
    } with {
      briefly as "Carries location events to storage"
      described as {
        |Connects what the context announces to what records it.
      }
    }

  } with {
    briefly as "Owns the locations dokn knows about"
    described as {
      |The Locations context is responsible for locations: recording them,
      |changing them, and answering questions about them.
    }
  }

  context Intake as router is {

    inlet CompanyStaged is command dokn.Companies.Company.AddCompany with {
      briefly as "Where the gateway's company requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here
        |and the context republishes on its own outlet.
      }
    }

    outlet CompanySubmissions is command dokn.Companies.Company.AddCompany with {
      briefly as "Where company requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    inlet DriverStaged is command dokn.Drivers.Driver.AddDriverToCompany with {
      briefly as "Where the gateway's driver requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet DriverSubmissions is command dokn.Drivers.Driver.AddDriverToCompany with {
      briefly as "Where driver requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    connector StagingDriver is {
      from outlet dokn.Intake.DriverRequests.Staged to inlet dokn.Intake.DriverStaged
    } with {
      briefly as "Carries gateway requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    inlet NoteStaged is command dokn.Notes.Note.CaptureNote with {
      briefly as "Where the gateway's note requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet NoteSubmissions is command dokn.Notes.Note.CaptureNote with {
      briefly as "Where note requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    connector StagingNote is {
      from outlet dokn.Intake.NoteRequests.Staged to inlet dokn.Intake.NoteStaged
    } with {
      briefly as "Carries gateway requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    inlet MediumStaged is command dokn.Media.Medium.StoreMedium with {
      briefly as "Where the gateway's medium requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet MediumSubmissions is command dokn.Media.Medium.StoreMedium with {
      briefly as "Where medium requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    connector StagingMedium is {
      from outlet dokn.Intake.MediumRequests.Staged to inlet dokn.Intake.MediumStaged
    } with {
      briefly as "Carries gateway requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    inlet LocationStaged is command dokn.Locations.Location.AddDeliveryLocation with {
      briefly as "Where the gateway's location requests collect"
      described as {
        |An inner source cannot reach across the boundary, so it delivers here.
      }
    }

    outlet LocationSubmissions is command dokn.Locations.Location.AddDeliveryLocation with {
      briefly as "Where location requests leave this context"
      described as {
        |RIDDL 2.0 makes the context the SOURCE for everything leaving it.
      }
    }

    connector StagingLocation is {
      from outlet dokn.Intake.LocationRequests.Staged to inlet dokn.Intake.LocationStaged
    } with {
      briefly as "Carries gateway requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    handler IntakeBoundary is {
      on request: command dokn.Companies.Company.AddCompany {
        forward request to outlet dokn.Intake.CompanySubmissions
      }
      on locationRequest: command dokn.Locations.Location.AddDeliveryLocation {
        forward locationRequest to outlet dokn.Intake.LocationSubmissions
      }
      on mediumRequest: command dokn.Media.Medium.StoreMedium {
        forward mediumRequest to outlet dokn.Intake.MediumSubmissions
      }
      on noteRequest: command dokn.Notes.Note.CaptureNote {
        forward noteRequest to outlet dokn.Intake.NoteSubmissions
      }
      on driverRequest: command dokn.Drivers.Driver.AddDriverToCompany {
        forward driverRequest to outlet dokn.Intake.DriverSubmissions
      }
    } with {
      briefly as "Republishes staged requests on the context's own outlet"
      described as {
        |The gateway's internals stay private; peers see only this outlet.
      }
    }

    processor CompanyRequests as source is {
      outlet Staged is command dokn.Companies.Company.AddCompany with {
        briefly as "Where company requests leave the gateway"
        described as {
          |Requests reach the Companies context over a domain-scoped connector.
        }
      }
      handler CompanyRequestsHandler is {
        on command dokn.Companies.Company.AddCompany {
          send command dokn.Companies.Company.AddCompany(
            companyId = prompt("the companyId carried by AddCompany"),
            mailingAddress = prompt("the mailingAddress carried by AddCompany"),
            primaryContactName = prompt("the primaryContactName carried by AddCompany"),
            primaryContactPhone = prompt("the primaryContactPhone carried by AddCompany"),
            primaryContactEmail = prompt("the primaryContactEmail carried by AddCompany")
          ) to outlet dokn.Intake.CompanyRequests.Staged
        }
        on other {
          do "ignore requests that are not about companys"
        }
      } with {
        briefly as "Forwards company requests into the domain"
        described as {
          |Runs when a caller asks dokn to record a company.
        }
      }
    } with {
      briefly as "The gateway's outbound path to Companies"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    connector StagingCompany is {
      from outlet dokn.Intake.CompanyRequests.Staged to inlet dokn.Intake.CompanyStaged
    } with {
      briefly as "Carries gateway requests to the context boundary"
      described as {
        |Intra-context, so it may address the source's own outlet directly.
      }
    }

    processor DriverRequests as source is {
      outlet Staged is command dokn.Drivers.Driver.AddDriverToCompany with {
        briefly as "Where driver requests leave the gateway"
        described as {
          |Requests reach the Drivers context over a domain-scoped connector.
        }
      }
      handler DriverRequestsHandler is {
        on command dokn.Drivers.Driver.AddDriverToCompany {
          send command dokn.Drivers.Driver.AddDriverToCompany(
            driverId = prompt("the driverId carried by AddDriverToCompany"),
            name = prompt("the name carried by AddDriverToCompany"),
            mobile = prompt("the mobile carried by AddDriverToCompany"),
            onDutyTime = prompt("the onDutyTime carried by AddDriverToCompany")
          ) to outlet dokn.Intake.DriverRequests.Staged
        }
        on other {
          do "ignore requests that are not about drivers"
        }
      } with {
        briefly as "Forwards driver requests into the domain"
        described as {
          |Runs when a caller asks dokn to record a driver.
        }
      }
    } with {
      briefly as "The gateway's outbound path to Drivers"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor NoteRequests as source is {
      outlet Staged is command dokn.Notes.Note.CaptureNote with {
        briefly as "Where note requests leave the gateway"
        described as {
          |Requests reach the Notes context over a domain-scoped connector.
        }
      }
      handler NoteRequestsHandler is {
        on command dokn.Notes.Note.CaptureNote {
          send command dokn.Notes.Note.CaptureNote(
            noteId = prompt("the noteId carried by CaptureNote"),
            text = prompt("the text carried by CaptureNote"),
            upvoteCount = prompt("the upvoteCount carried by CaptureNote"),
            downvoteCount = prompt("the downvoteCount carried by CaptureNote"),
            approved = prompt("the approved carried by CaptureNote")
          ) to outlet dokn.Intake.NoteRequests.Staged
        }
        on other {
          do "ignore requests that are not about notes"
        }
      } with {
        briefly as "Forwards note requests into the domain"
        described as {
          |Runs when a caller asks dokn to record a note.
        }
      }
    } with {
      briefly as "The gateway's outbound path to Notes"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor MediumRequests as source is {
      outlet Staged is command dokn.Media.Medium.StoreMedium with {
        briefly as "Where medium requests leave the gateway"
        described as {
          |Requests reach the Media context over a domain-scoped connector.
        }
      }
      handler MediumRequestsHandler is {
        on command dokn.Media.Medium.StoreMedium {
          send command dokn.Media.Medium.StoreMedium(
            mediumId = prompt("the mediumId carried by StoreMedium"),
            path = prompt("the path carried by StoreMedium")
          ) to outlet dokn.Intake.MediumRequests.Staged
        }
        on other {
          do "ignore requests that are not about mediums"
        }
      } with {
        briefly as "Forwards medium requests into the domain"
        described as {
          |Runs when a caller asks dokn to record a medium.
        }
      }
    } with {
      briefly as "The gateway's outbound path to Media"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

    processor LocationRequests as source is {
      outlet Staged is command dokn.Locations.Location.AddDeliveryLocation with {
        briefly as "Where location requests leave the gateway"
        described as {
          |Requests reach the Locations context over a domain-scoped connector.
        }
      }
      handler LocationRequestsHandler is {
        on command dokn.Locations.Location.AddDeliveryLocation {
          send command dokn.Locations.Location.AddDeliveryLocation(
            locationId = prompt("the locationId carried by AddDeliveryLocation"),
            label = prompt("the label carried by AddDeliveryLocation"),
            address = prompt("the address carried by AddDeliveryLocation"),
            ticketCount = prompt("the ticketCount carried by AddDeliveryLocation"),
            loadingMethod = prompt("the loadingMethod carried by AddDeliveryLocation")
          ) to outlet dokn.Intake.LocationRequests.Staged
        }
        on other {
          do "ignore requests that are not about locations"
        }
      } with {
        briefly as "Forwards location requests into the domain"
        described as {
          |Runs when a caller asks dokn to record a location.
        }
      }
    } with {
      briefly as "The gateway's outbound path to Locations"
      described as {
        |A source streamlet: what a caller asked for, on its way in.
      }
    }

  } with {
    briefly as "Where requests from outside dokn arrive"
    described as {
      |dokn has no user interface of its own; drivers reach it through a
      |mobile application that is out of scope here. This gateway context
      |stands in for that boundary, giving every context's sink something
      |upstream to receive from. RIDDL 2.0 names the role explicitly with
      |the `gateway` context intention.
    }
  }

  user Dispatcher is "Someone who signs a delivery company up to dokn" with {
    briefly as "The user who onboards a company and its drivers"
    described as {
      |Drivers use dokn through a mobile application that is out of scope
      |here. Before any of them can capture a note, somebody has to register
      |the company they deliver for and attach them to it. That is this
      |user's job.
    }
  }

  epic CompanyOnboarding is {

    user Dispatcher wants to "register a delivery company and its drivers"
      so that "those drivers can start capturing notes against locations"

    case RegisterACompany is {
      user Dispatcher wants to "record a new delivery company"
        so that "drivers have an employer to be attached to"
      step send command dokn.Companies.Company.AddCompany
        from source dokn.Intake.CompanyRequests
        to context dokn.Companies
    } with {
      briefly as "A company request crossing the gateway into Companies"
      described as {
        |This is the case that exists to be exercised rather than to teach.
        |`AddCompany` is a command of an event-sourced entity, so it declares
        |`yields event CompanyAdded`, and this step hands it to a sink. That
        |pairing — an epic step carrying an event-sourced entity's command to
        |a streamlet — is the one combination the `yields`-in-streamlets
        |defect could hide in, because no model held both halves at once.
      }
    }

    case AttachADriver is {
      user Dispatcher wants to "attach a driver to a registered company"
        so that "the driver's notes are recorded against the right employer"
      step send command dokn.Drivers.Driver.AddDriverToCompany
        from source dokn.Intake.DriverRequests
        to context dokn.Drivers
    } with {
      briefly as "A driver request crossing the gateway into Drivers"
      described as {
        |The same shape a second time, through a different context, so the
        |coverage does not rest on one path.
      }
    }

  } with {
    briefly as "How a delivery company and its drivers reach dokn"
    described as {
      |dokn's only epic. It exists to keep an epic step pointed at an
      |event-sourced entity's command, which is why it is deliberately thin:
      |two steps, both of them a command travelling from the gateway source
      |to the owning context's sink.
    }
    by author Reid
  }

  persistent connector CompanyRequests is {
    from outlet dokn.Intake.CompanySubmissions
    to inlet dokn.Companies.CompanyIn
  } with {
    briefly as "Carries company requests from the gateway to Companies"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector DriverRequests is {
    from outlet dokn.Intake.DriverSubmissions
    to inlet dokn.Drivers.DriverIn
  } with {
    briefly as "Carries driver requests from the gateway to Drivers"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector NoteRequests is {
    from outlet dokn.Intake.NoteSubmissions
    to inlet dokn.Notes.NoteIn
  } with {
    briefly as "Carries note requests from the gateway to Notes"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector MediumRequests is {
    from outlet dokn.Intake.MediumSubmissions
    to inlet dokn.Media.MediumIn
  } with {
    briefly as "Carries medium requests from the gateway to Media"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

  persistent connector LocationRequests is {
    from outlet dokn.Intake.LocationSubmissions
    to inlet dokn.Locations.LocationIn
  } with {
    briefly as "Carries location requests from the gateway to Locations"
    described as {
      |Crosses a context boundary, so it is declared at domain scope and
      |made persistent as RIDDL 2.0 requires.
    }
  }

} with {
  briefly as "Delivery drivers capturing what they learn about locations"
  described as {
    |The dokn domain is the starting point for a simple application which
    |allows delivery drivers to capture notes about delivery locations to
    |create efficiency for future deliveries. The main entities are:
    |
    |* Driver - a person who delivers parcels and freight to a location.
    |* Location - a specific geographic place a driver delivers to.
    |* Note - what drivers record about delivering to a location, e.g.
    |  "Accepts deliveries at loading dock C. Ask for Mike (555-123-4567)".
    |* Company - the business a driver delivers on behalf of.
    |* Medium - a photograph or document filed against a location.
    |
    |Each context owns its identifiers and value types. RIDDL 2.0 flags a
    |type used by an entity but declared outside its context, so the shared
    |domain-level types this model began with now live in the contexts that
    |use them, and references are fully qualified because RIDDL resolves
    |names across the whole model rather than per context.
  }
  by author Reid
}
